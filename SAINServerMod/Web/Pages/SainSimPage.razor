@page "/sain/sim"
@attribute [Authorize(Policy = "Administrator")]
@implements IDisposable
@layout BaseMudBlazorLayout
@using SAINServerMod.SimLab
@inject SimLabService Sim
@inject ISnackbar Snackbar

<PageTitle>@T("SAIN 시뮬레이션", "SAIN Simulation")</PageTitle>
<HeadContent>
    <link rel="stylesheet" href="/SAIN/css/sain.css" />
</HeadContent>

<div class="spt-page">
    <MudContainer MaxWidth="MaxWidth.False" Class="sain-container pa-4">
        <SainNav Current="sim" />
        <MudPaper Elevation="0" Class="spt-panel sain-hero pa-4 mb-4">
            <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap" Spacing="3">
                <MudStack Row AlignItems="AlignItems.Center" Spacing="3">
                    <div class="sain-hero-icon">
                        <MudIcon Icon="@Icons.Material.Filled.Science" Color="Color.Warning" Size="Size.Large" />
                    </div>
                    <div>
                        <MudText Typo="Typo.h5" Class="spt-title">@T("시뮬레이션 (zzap)", "Simulation (zzap)")</MudText>
                        <MudText Typo="Typo.caption" Class="spt-muted">
                            @T("맵 순회 봇 시뮬레이션. 게임에서 \"zzap TEST [시뮬 전용]\" 프리셋을 쓸 때만 작동합니다. 다른 프리셋이면 아무것도 바뀌지 않습니다.", "Map-rotation bot simulation. Only active while the game uses the \"zzap TEST [시뮬 전용]\" preset; with any other preset nothing changes.")
                        </MudText>
                    </div>
                </MudStack>
                <MudStack Row Spacing="2" Wrap="Wrap.Wrap">
                    <MudButton Variant="@(Sim.Running ? Variant.Outlined : Variant.Filled)" Color="@(Sim.Running ? Color.Error : Color.Success)"
                               StartIcon="@(Sim.Running ? Icons.Material.Filled.Stop : Icons.Material.Filled.PlayArrow)" OnClick="ToggleRunning">
                        @(Sim.Running ? T("시뮬 정지", "Stop sim") : T("시뮬 시작", "Start sim"))
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.FiberNew" OnClick="NewRun">@T("새 실행 시작", "Start new run")</MudButton>
                    <MudButton Href="/sain/sim/analysis" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Analytics">@T("분석 보기", "Analysis")</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Warning" StartIcon="@Icons.Material.Filled.Save" OnClick="Save">@T("저장", "Save")</MudButton>
                </MudStack>
            </MudStack>
        </MudPaper>

        <MudPaper Elevation="0" Class="spt-panel pa-4 mb-4">
            <MudText Typo="Typo.subtitle1" Class="spt-title mb-2">@T("지금 상태", "Status")</MudText>
            <MudStack Row Wrap="Wrap.Wrap" Spacing="2" Class="mb-2">
                <MudChip T="string" Size="Size.Small" Color="@(Sim.Armed ? Color.Success : Color.Default)" Variant="Variant.Outlined">
                    @(Sim.Armed ? T($"작동 중 (프리셋 {Sim.ArmedPreset})", $"Active (preset {Sim.ArmedPreset})") : T("꺼짐 — 게임에서 시뮬 프리셋을 고르면 켜짐", "Off — select the sim preset in game to turn it on"))
                </MudChip>
                @if (Sim.LastHello != default)
                {
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@T("게임 마지막 연락", "Last contact from game") @(Sim.LastHello.ToString("HH:mm:ss"))</MudChip>
                }
                <MudChip T="string" Size="Size.Small" Color="@(Sim.Running ? Color.Success : Color.Warning)" Variant="Variant.Outlined">
                    @(Sim.Running ? T("순회 진행 중", "Rotation running") : T("대기 — '시뮬 시작'을 눌러야 시작", "Waiting — press 'Start sim'"))
                </MudChip>
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@T("실행", "Run") @(string.IsNullOrEmpty(Sim.State.RunId) ? "-" : Sim.State.RunId)</MudChip>
            </MudStack>
            @{
                var plan = Sim.Plan();
            }
            <MudText Typo="Typo.body2">
                @T("다음 맵", "Next map"): <b>@(plan.NextMap == null ? "-" : SimLabDefaults.DisplayName(plan.NextMap))</b> (@(plan.Step + 1)/@(plan.StepCount)) — @(plan.NextMap == null ? "" : SimLabDefaults.ScenarioName(Sim.ScenarioFor(plan.NextMap))) · @(plan.Minutes.ToString("0"))@T("분", " min") · @T("맵 사이 대기", "gap between maps") @(Sim.Config.GapSeconds)@T("초", " s")
            </MudText>
            @if (!string.IsNullOrEmpty(plan.Message))
            {
                <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2">@T(plan.Message, "No map in the rotation is switched on (turn maps on below).")</MudAlert>
            }
            @if (Sim.LastBeat != null)
            {
                var b = Sim.LastBeat;
                <MudText Typo="Typo.body2" Class="mt-1">
                    @T("마지막 보고", "Last report"): @(SimLabDefaults.DisplayName(b.Map ?? "")) t=@((b.RaidSeconds / 60f).ToString("0.0"))/@((b.PlannedSeconds / 60f).ToString("0"))@T("분", " min") ·
                    @T("생존 봇", "alive bots") @(b.AliveBots) · @T("봇 사망", "bot deaths") @(b.BotDeaths) · @(b.Fps.ToString("0")) fps · @T("오류", "errors") @(b.Errors?.Sum(e => e.Count) ?? 0) (@(b.Kind))
                </MudText>
            }
        </MudPaper>

        <div class="sain-settings-grid">
            <MudPaper Elevation="0" Class="spt-panel pa-4">
                <MudText Typo="Typo.subtitle1" Class="spt-title mb-2">@T("공통 설정", "General")</MudText>
                <div class="sain-toggle-row">
                    <MudText Typo="Typo.body2">@T("관전 모드 (플레이어 무적, 봇이 플레이어 무시)", "Spectator (player invincible, bots ignore the player)")</MudText>
                    <MudSwitch T="bool" @bind-Value="Sim.Config.Spectator" Color="Color.Primary" />
                </div>
                <div class="sain-toggle-row">
                    <MudText Typo="Typo.body2">@T("시작 때 A쪽 구역으로 순간이동 (멀면 봇 AI가 간소화됨)", "Teleport next to side A at start (far bots get reduced AI)")</MudText>
                    <MudSwitch T="bool" @bind-Value="Sim.Config.TeleportToArena" Color="Color.Primary" />
                </div>
                <div class="sain-toggle-row">
                    <MudText Typo="Typo.body2">@T("맵 원래 스폰 지우기 — 맵에 들어 있던 PMC·스캐브·보스 웨이브(ABPS가 서버에서 넣은 웨이브 포함)를 지우고 시뮬 분대만 나오게. 시뮬 분대를 누가 만드는지와는 별개", "Clear the map's own spawns - removes the map's PMC/scav/boss waves (incl. the ones ABPS put in on the server) so only sim squads appear. Separate from who spawns the sim squads")</MudText>
                    <MudSwitch T="bool" @bind-Value="Sim.Config.RemoveOtherSpawns" Color="Color.Primary" />
                </div>
                <div class="sain-toggle-row">
                    <MudText Typo="Typo.body2">
                        @T("시뮬 분대를 ABPS로 생성 (권장) — ABPS가 분대를 만들고 SAIN은 자리만 시뮬 구역 안으로 고름. 끄면 게임 기본 생성(분대가 잘 안 나옴)",
                           "Spawn sim squads with ABPS (recommended) - ABPS spawns the squads, SAIN points the spot at the sim zones. Off = the game's own spawner (squads often stall)")
                        @(Sim.AbpsFound ? "" : T(" — ABPS 서버 모드 없음", " — ABPS server mod not found"))
                    </MudText>
                    <MudSwitch T="bool" Value="@(!Sim.Config.AbpsOffInSim)" ValueChanged="@((bool on) => Sim.Config.AbpsOffInSim = !on)" Color="Color.Primary" />
                </div>
                <div class="sain-toggle-row">
                    <MudText Typo="Typo.body2">@T("맵 사이 대기 시작 때 메모리 정리 (안 쓰는 리소스 해제 + GC)", "Clean memory at the start of the gap (unload unused assets + GC)")</MudText>
                    <MudSwitch T="bool" @bind-Value="Sim.Config.CleanMemoryBetweenMaps" Color="Color.Primary" />
                </div>
                <div class="sain-toggle-row">
                    <MudText Typo="Typo.body2">@T("게임 화면 오른쪽 위에 남은 시뮬 시간 표시", "Show the remaining sim time at the top right of the game")</MudText>
                    <MudSwitch T="bool" @bind-Value="Sim.Config.ShowTimer" Color="Color.Primary" />
                </div>
                <MudText Typo="Typo.subtitle2" Class="mt-3">@T("ORBIT 조정 (시뮬 레이드에만, ORBIT 파일은 안 바뀜)", "ORBIT overrides (sim raids only, ORBIT's files are untouched)")</MudText>
                <MudText Typo="Typo.caption" Class="spt-muted d-block mb-1">
                    @(Sim.OrbitFound
                        ? T("ORBIT 설치됨. 켜 둔 항목은 시뮬이 켜져 있을 때만 ORBIT에 보내는 설정을 바꿉니다. 시뮬을 멈추면 원래 설정 그대로입니다.",
                            "ORBIT found. Checked items change only what ORBIT receives while the sim is armed; stopping the sim gives ORBIT its normal settings.")
                        : T("ORBIT이 설치되어 있지 않아 이 항목들은 아무 효과가 없습니다.", "ORBIT isn't installed; these do nothing."))
                </MudText>
                <div class="sain-toggle-row">
                    <MudText Typo="Typo.body2">@T("ORBIT 고스트 모드 끄기 (관전자에서 250m 넘게 떨어진 봇을 재우고 싸움을 주사위로 처리하는 기능)", "ORBIT ghost mode off (sleeps bots > 250 m from the spectator and rolls their fights)")</MudText>
                    <MudSwitch T="bool" @bind-Value="Sim.Config.OrbitGhostOff" Color="Color.Primary" />
                </div>
                <div class="sain-toggle-row">
                    <MudText Typo="Typo.body2">@T("ORBIT 탈출 끄기 (전리품·목표 완료·시간 탈출, 비상 탈출)", "ORBIT no extract (loot / objectives done / timed / emergency)")</MudText>
                    <MudSwitch T="bool" @bind-Value="Sim.Config.OrbitNoExtract" Color="Color.Primary" />
                </div>
                <div class="sain-toggle-row">
                    <MudText Typo="Typo.body2">@T("ORBIT PMC 주 목표 끄기 (맵 곳곳 목표를 찾아 떠나는 것)", "ORBIT PMC main objectives off (leaving to visit objectives across the map)")</MudText>
                    <MudSwitch T="bool" @bind-Value="Sim.Config.OrbitNoObjectives" Color="Color.Primary" />
                </div>
                <div class="sain-toggle-row">
                    <MudText Typo="Typo.body2">@T("ORBIT 싸움 구역 고정 (그 맵의 존 에디터 구역 대신 양쪽 스폰 사이 한 곳으로 끌어당김)", "ORBIT arena zone (replace the map's zone-editor zones with one attractor between both sides)")</MudText>
                    <MudSwitch T="bool" @bind-Value="Sim.Config.OrbitArenaZone" Color="Color.Primary" />
                </div>
                <div class="sain-toggle-row">
                    <MudText Typo="Typo.body2">@T("분대마다 다른 팀 (자기 분대 말고는 USEC·BEAR 상관없이 전부 적. 끄면 SPT 기본: 같은 진영끼리 15% 확률로 아군)", "Every squad its own team (all other squads are enemies, own faction included; off = SPT default: same faction friendly 15% of the time)")</MudText>
                    <MudSwitch T="bool" @bind-Value="Sim.Config.AllSquadsEnemies" Color="Color.Primary" />
                </div>
                <MudText Typo="Typo.subtitle2" Class="mt-3">@T("다른 모드", "Other mods")</MudText>
                <div class="sain-toggle-row">
                    <MudText Typo="Typo.body2">
                        @T("시뮬 맵은 원본(SPT 기본) 버전으로 — MapVariants가 있으면 시작 직전에 '원본'을 고름 (예: 공장은 리워크, 클래식 공장 아님). 시뮬 뒤 직접 플레이할 때도 맵 고르기 화면에서 다시 고르기 전까지 원본이 유지됨",
                           "Sim maps use the original (SPT's own) version - with MapVariants, 'original' is picked right before each start (e.g. reworked Factory, not classic). It stays picked for your own raids until you choose again on the map screen")
                    </MudText>
                    <MudSwitch T="bool" @bind-Value="Sim.Config.OriginalMaps" Color="Color.Primary" />
                </div>
                <div class="sain-toggle-row">
                    <MudText Typo="Typo.body2">@T("낮 시간대로만 시작 (메뉴의 두 시간대 중 한낮에 가까운 쪽, 공장은 고정 시간)", "Daytime starts only (of the menu's two raid times, the one closer to midday; Factory has fixed times)")</MudText>
                    <MudSwitch T="bool" @bind-Value="Sim.Config.DayOnly" Color="Color.Primary" />
                </div>
                <div class="sain-toggle-row">
                    <MudText Typo="Typo.body2">@T("싸움 구역 줄 — 싸우지 않는 봇(ORBIT 이동 등)이 싸움 구역 원 밖에 15초 넘게 있으면 자기 편 구역으로 순간이동", "Arena leash - a bot not fighting (ORBIT roaming...) outside the arena circle for 15 s is teleported back into its side's zone")</MudText>
                    <MudSwitch T="bool" @bind-Value="Sim.Config.ArenaLeash" Color="Color.Primary" />
                </div>
                <div class="sain-toggle-row">
                    <MudText Typo="Typo.body2">@T("시간이 끝나면 다음 맵으로", "Move to the next map when time is up")</MudText>
                    <MudSwitch T="bool" @bind-Value="Sim.Config.AutoRotate" Color="Color.Primary" />
                </div>
                <MudStack Row Wrap="Wrap.Wrap" Spacing="2" Class="mt-3">
                    <MudNumericField T="int" @bind-Value="Sim.Config.MaxAliveBots" Label="@T("동시에 살아 있는 최대 봇", "Max bots alive at once")" Min="2" Max="40"
                                     Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:200px;" />
                    <MudNumericField T="int" @bind-Value="Sim.Config.SquadSizeMin" Label="@T("분대 최소", "Squad min")" Min="1" Max="6"
                                     Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:120px;" />
                    <MudNumericField T="int" @bind-Value="Sim.Config.SquadSizeMax" Label="@T("분대 최대", "Squad max")" Min="1" Max="6"
                                     Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:120px;" />
                    <MudNumericField T="int" @bind-Value="Sim.Config.RespawnSeconds" Label="@T("보충 간격(초)", "Refill interval (s)")" Min="5" Max="600"
                                     Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:150px;" />
                    <MudNumericField T="int" @bind-Value="Sim.Config.GapSeconds" Label="@T("맵 사이 대기(초, 메인 메뉴)", "Gap between maps (s, main menu)")" Min="0" Max="1800"
                                     Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:220px;" />
                    <MudNumericField T="float" @bind-Value="Sim.Config.DefaultMinutes" Label="@T("목록에 없는 맵(분)", "Unlisted map (min)")" Min="1" Max="120"
                                     Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:170px;" />
                </MudStack>
                <MudText Typo="Typo.caption" Class="spt-muted d-block mt-2">
                    @T("봇은 서버가 넣어 둔 \"예비 분대\"를 게임이 살아 있는 봇 수를 보며 하나씩 부릅니다. 최대 수보다 적어지면 보충 간격마다 A/B 중 적은 쪽에 분대를 보냅니다. 프로필은 부를 때만 만들어져서 미리 대량 생성되지 않습니다.", "The server puts \"reserve squads\" in the raid and the game calls them one by one by the number of living bots: below the max, every refill interval a squad goes to the side with fewer bots. Profiles are made only when a squad is called, so nothing piles up in advance.")
                </MudText>
                <MudTextField T="string" Value="@string.Join(", ", Sim.Config.ExcludedMapKeywords)" ValueChanged="SetExcluded"
                              Label="@T("제외할 맵 (이름에 포함된 단어, 쉼표로 구분)", "Excluded maps (words in the map id, comma separated)")" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-3" />
            </MudPaper>
            <MudPaper Elevation="0" Class="spt-panel pa-4">
                <MudText Typo="Typo.subtitle1" Class="spt-title mb-2">@T("사용법", "How to use")</MudText>
                <MudText Typo="Typo.body2">
                    @if (Korean)
                    {
                        <span>1. 게임 F6에서 프리셋을 "zzap TEST [시뮬 전용]"으로 고릅니다.<br />
                        2. 게임이 메인 메뉴에 있을 때 이 페이지 위쪽의 <b>"시뮬 시작"</b>을 누르면 10초 안에 카운트다운이 시작되고 아래 순서의 다음 맵이 시작됩니다. 게임을 켜기만 해서는 시작하지 않습니다(게임을 다시 켜면 다시 눌러야 함). "다음으로 지정"도 메뉴에 있는 채로 반영됩니다.<br />
                        3. 맵마다 정한 분이 지나면 레이드가 "생존"으로 끝나고 결과 화면 없이 메뉴로 돌아옵니다. "맵 사이 대기"는 메인 메뉴가 <b>다 뜬 순간부터</b> 셉니다(레이드에서 나오는 시간은 맵마다 달라서). 나오는 도중에는 절대 다음 맵을 시작하지 않습니다.<br />
                        4. 결과는 "분석 보기"에서 확인합니다. 게임을 강제로 꺼도 1분마다 보낸 기록과 PC에 남긴 파일로 어디까지 했는지 남습니다.<br />
                        5. 실제 내 프로필로 레이드를 하므로(경험치·시간 진행), 시뮬 전용 프로필을 쓰는 것을 권장합니다.</span>
                    }
                    else
                    {
                        <span>1. In game, select the "zzap TEST [시뮬 전용]" preset in F6.<br />
                        2. With the game in the main menu, press <b>"Start sim"</b> at the top of this page: the countdown starts within 10 s and the next map below starts. Just launching the game never starts it (press again after restarting the game). "Make next" also applies while in the menu.<br />
                        3. After each map's minutes the raid ends as "Survived" and returns to the menu without the result screens. The "gap between maps" counts from the moment the main menu has <b>fully loaded</b> (leaving a raid takes a different time per map); nothing starts while the game is still leaving the raid.<br />
                        4. Results are on "Analysis". Even if the game is killed, the per-minute reports and the file on the PC show how far it got.<br />
                        5. Raids run on your real profile (XP, time pass) — a separate sim profile is recommended.</span>
                    }
                </MudText>
                <MudButton Variant="Variant.Text" Color="Color.Error" Class="mt-3" StartIcon="@Icons.Material.Filled.RestartAlt" OnClick="ResetDefaults">
                    @T("순서·시나리오 기본값 복원", "Reset order and scenarios")
                </MudButton>
            </MudPaper>
        </div>

        <MudPaper Elevation="0" Class="spt-panel pa-4 mt-4">
            <MudText Typo="Typo.subtitle1" Class="spt-title mb-1">@T("맵 순서와 시나리오", "Map order and scenarios")</MudText>
            <MudText Typo="Typo.caption" Class="spt-muted d-block mb-2">
                @T("위에서부터 차례로 진행합니다. 화살표로 순서를 바꾸고, 켜진 맵만 돕니다. 시나리오를 펼치면 양쪽 스폰 구역을 바꿀 수 있습니다(구역 이름은 맵 데이터에서 읽은 목록).", "Played from the top. Reorder with the arrows; only maps switched on are played. Open a scenario to change where each side spawns (zone names are read from the map data).")
            </MudText>
            <MudExpansionPanels Elevation="0" Class="sain-panels" MultiExpansion="true">
                @for (int i = 0; i < Sim.Config.Rotation.Count; i++)
                {
                    int index = i;
                    var entry = Sim.Config.Rotation[index];
                    var scenario = ScenarioOf(entry.Map);
                    bool excluded = Sim.IsExcluded(entry.Map);
                    <MudExpansionPanel Class="sain-subpanel">
                        <TitleContent>
                            <MudStack Row AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
                                <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward" Size="Size.Small" Disabled="@(index == 0)" OnClick="@(() => Move(index, -1))" />
                                <MudIconButton Icon="@Icons.Material.Filled.ArrowDownward" Size="Size.Small" Disabled="@(index == Sim.Config.Rotation.Count - 1)" OnClick="@(() => Move(index, 1))" />
                                <MudSwitch T="bool" Value="entry.Enabled" ValueChanged="@(v => entry.Enabled = v)" Color="Color.Primary" Disabled="excluded" />
                                <MudText Typo="Typo.body1" Style="min-width:150px;"><b>@SimLabDefaults.DisplayName(entry.Map)</b></MudText>
                                <MudNumericField T="float" Value="entry.Minutes" ValueChanged="@(v => entry.Minutes = Math.Max(1f, v))" Min="1" Max="180"
                                                 Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:110px;" Adornment="Adornment.End" AdornmentText="@T("분", "min")" />
                                <MudText Typo="Typo.body2" Class="spt-muted">@SimLabDefaults.ScenarioName(scenario)</MudText>
                                <MudText Typo="Typo.caption" Class="spt-muted">@PaceText(entry)</MudText>
                                @if (excluded)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Outlined">@T("제외됨", "Excluded")</MudChip>
                                }
                                @if (IsNext(entry.Map))
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined">@T("다음", "Next")</MudChip>
                                }
                                else if (entry.Enabled && !excluded)
                                {
                                    <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => MakeNext(entry.Map))">@T("다음으로 지정", "Make next")</MudButton>
                                }
                            </MudStack>
                        </TitleContent>
                        <ChildContent>
                            <MudStack Spacing="2">
                                @if (Korean)
                                {
                                    <MudTextField T="string" @bind-Value="scenario.Name" Label="시나리오 이름" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                    <MudTextField T="string" @bind-Value="scenario.Focus" Label="이 맵에서 보는 것" Variant="Variant.Outlined" Margin="Margin.Dense" Lines="2" />
                                }
                                else
                                {
                                    <MudTextField T="string" @bind-Value="scenario.NameEn" Label="Scenario name" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                    <MudTextField T="string" @bind-Value="scenario.FocusEn" Label="What this map tests" Variant="Variant.Outlined" Margin="Margin.Dense" Lines="2" />
                                }
                                <MudStack Row Wrap="Wrap.Wrap" Spacing="2">
                                    <MudTextField T="string" @bind-Value="scenario.ZonesA" Label="@T("A쪽 구역 (쉼표, 비우면 맵 전체)", "Side A zones (comma, empty = whole map)")" Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width:280px;" />
                                    <MudSelect T="string" @bind-Value="scenario.SideA" Label="@T("A쪽 진영", "Side A role")" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Style="max-width:160px;">
                                        @foreach (string role in Roles)
                                        {
                                            <MudSelectItem T="string" Value="@role">@role</MudSelectItem>
                                        }
                                    </MudSelect>
                                    <MudTextField T="string" @bind-Value="scenario.ZonesB" Label="@T("B쪽 구역 (쉼표, 비우면 맵 전체)", "Side B zones (comma, empty = whole map)")" Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width:280px;" />
                                    <MudSelect T="string" @bind-Value="scenario.SideB" Label="@T("B쪽 진영", "Side B role")" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Style="max-width:160px;">
                                        @foreach (string role in Roles)
                                        {
                                            <MudSelectItem T="string" Value="@role">@role</MudSelectItem>
                                        }
                                    </MudSelect>
                                </MudStack>
                                <MudText Typo="Typo.caption" Class="spt-muted">@T("이 맵의 스폰 속도 (0 = 공통 설정 사용). 작은 실내 맵은 빠르게·작은 분대로, 넓은 맵은 천천히.", "Spawn pace on this map (0 = common value). Small indoor maps refill fast with small squads, open maps slower.")</MudText>
                                <MudStack Row Wrap="Wrap.Wrap" Spacing="2">
                                    <MudNumericField T="int" @bind-Value="entry.MaxAliveBots" Label="@T("동시 최대 봇", "Max alive")" Min="0" Max="40" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:140px;" />
                                    <MudNumericField T="int" @bind-Value="entry.RespawnSeconds" Label="@T("보충 간격(초)", "Refill (s)")" Min="0" Max="600" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:140px;" />
                                    <MudNumericField T="int" @bind-Value="entry.SquadSizeMin" Label="@T("분대 최소", "Squad min")" Min="0" Max="6" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:120px;" />
                                    <MudNumericField T="int" @bind-Value="entry.SquadSizeMax" Label="@T("분대 최대", "Squad max")" Min="0" Max="6" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:120px;" />
                                    <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => SimLabDefaults.ApplyPace(entry))">@T("이 맵 기본 속도", "Map default pace")</MudButton>
                                </MudStack>
                                <MudTextField T="string" @bind-Value="scenario.Watch" Label="@T("분석에서 강조할 카운터 접두어 (예: door.,nade.)", "Counter prefixes to highlight in the analysis (e.g. door.,nade.)")" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                <div>
                                    <MudText Typo="Typo.caption" Class="spt-muted">@T("이 맵의 구역 (괄호 = 보스·봇 스폰 지점 수, 0이면 분대가 안 나올 수 있음). 누르면 A/B에 추가:", "Zones of this map (in brackets: boss/bot spawn points; 0 may spawn nothing). Click to add to A/B:")</MudText>
                                    <MudStack Row Wrap="Wrap.Wrap" Spacing="1" Class="mt-1">
                                        @foreach (var zone in ZonesOf(entry.Map))
                                        {
                                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@(zone.Points > 0 ? Color.Default : Color.Error)">
                                                @zone.Zone (@zone.Points)
                                                <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => AddZone(scenario, zone.Zone, true))">A</MudButton>
                                                <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => AddZone(scenario, zone.Zone, false))">B</MudButton>
                                            </MudChip>
                                        }
                                    </MudStack>
                                </div>
                            </MudStack>
                        </ChildContent>
                    </MudExpansionPanel>
                }
            </MudExpansionPanels>
        </MudPaper>
    </MudContainer>
</div>

@code {
    private static readonly string[] Roles = ["pmcUSEC", "pmcBEAR", "assault", "pmcBot", "exUsec"];
    private readonly Dictionary<string, List<(string Zone, int Points)>> _zones = new(StringComparer.OrdinalIgnoreCase);
    private System.Threading.Timer? _timer;

    protected override void OnInitialized()
    {
        // Live status (last report, armed) every 5 s.
        _timer = new System.Threading.Timer(_ => InvokeAsync(StateHasChanged), null, 5000, 5000);
    }

    public void Dispose()
    {
        _timer?.Dispose();
    }

    private string PaceText(SimMapEntry e)
    {
        int cap = e.MaxAliveBots > 0 ? e.MaxAliveBots : Sim.Config.MaxAliveBots;
        int respawn = e.RespawnSeconds > 0 ? e.RespawnSeconds : Sim.Config.RespawnSeconds;
        int min = e.SquadSizeMin > 0 ? e.SquadSizeMin : Sim.Config.SquadSizeMin;
        int max = e.SquadSizeMax > 0 ? e.SquadSizeMax : Sim.Config.SquadSizeMax;
        return T($"최대 {cap}명 · {respawn}초마다 · 분대 {min}~{max}", $"max {cap} · every {respawn}s · squad {min}-{max}");
    }

    private SimScenario ScenarioOf(string map)
    {
        if (!Sim.Config.Scenarios.TryGetValue(map, out SimScenario? scenario) || scenario == null)
        {
            scenario = Sim.ScenarioFor(map);
            Sim.Config.Scenarios[map] = scenario;
        }
        return scenario;
    }

    private List<(string Zone, int Points)> ZonesOf(string map)
    {
        if (!_zones.TryGetValue(map, out var list))
        {
            list = Sim.ZonesOf(map);
            _zones[map] = list;
        }
        return list;
    }

    private static void AddZone(SimScenario scenario, string zone, bool sideA)
    {
        string current = sideA ? scenario.ZonesA : scenario.ZonesB;
        var parts = (current ?? string.Empty).Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();
        if (!parts.Contains(zone))
        {
            parts.Add(zone);
        }
        if (sideA)
        {
            scenario.ZonesA = string.Join(",", parts);
        }
        else
        {
            scenario.ZonesB = string.Join(",", parts);
        }
    }

    private bool IsNext(string map)
    {
        return string.Equals(Sim.Plan().NextMap, map, StringComparison.OrdinalIgnoreCase);
    }

    private void MakeNext(string map)
    {
        Sim.SaveConfig();
        int index = Sim.EnabledRotation().FindIndex(x => string.Equals(x.Map, map, StringComparison.OrdinalIgnoreCase));
        if (index >= 0)
        {
            Sim.SetStep(index);
            Snackbar.Add(T($"다음 맵: {SimLabDefaults.DisplayName(map)}", $"Next map: {SimLabDefaults.DisplayName(map)}"), Severity.Info);
        }
    }

    private void Move(int index, int delta)
    {
        int target = index + delta;
        var list = Sim.Config.Rotation;
        if (target < 0 || target >= list.Count)
        {
            return;
        }
        (list[index], list[target]) = (list[target], list[index]);
    }

    private void SetExcluded(string value)
    {
        Sim.Config.ExcludedMapKeywords = (value ?? string.Empty)
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .ToList();
    }

    private void ToggleRunning()
    {
        Sim.SaveConfig();
        Sim.SetRunning(!Sim.Running);
        Snackbar.Add(Sim.Running
            ? T("시뮬을 시작합니다. 게임이 메인 메뉴에 있으면 10초 안에 카운트다운이 시작됩니다.", "Sim started. If the game is in the main menu, the countdown starts within 10 s.")
            : T("시뮬을 멈췄습니다. 지금 레이드는 끝까지 진행되고, 메뉴에서 다음 맵을 시작하지 않습니다.", "Sim stopped. The current raid plays to its end; the menu will not start the next map."), Severity.Info);
    }

    private void NewRun()
    {
        Sim.SaveConfig();
        string id = Sim.NewRun();
        Snackbar.Add(T($"새 실행 {id} — 순서 처음부터 시작합니다.", $"New run {id} — starting from the top of the list."), Severity.Success);
    }

    private void Save()
    {
        Sim.SaveConfig();
        Snackbar.Add(T("시뮬 설정을 저장했습니다. 다음 레이드부터 적용됩니다.", "Sim settings saved. They apply from the next raid."), Severity.Success);
    }

    private void ResetDefaults()
    {
        Sim.ResetDefaults();
        _zones.Clear();
        Snackbar.Add(T("순서·시나리오를 기본값으로 되돌렸습니다.", "Order and scenarios reset to defaults."), Severity.Warning);
    }
}
