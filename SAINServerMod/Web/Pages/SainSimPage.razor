            new("orbit", "ORBIT 조정", "ORBIT overrides", "ORBIT_FOUND", "ORBIT_FOUND"),
            new("mods", "다른 모드 (APBS · Blackout · MapVariants)", "Other mods (APBS · Blackout · MapVariants)"),
            new("personality", "성격 분포 (시뮬 PMC만)", "Personality mix (sim PMCs only)"),
            new("maps", "제외 맵", "Excluded maps"),
        ];
        Toggles =
        [
            new("basic", "관전 모드", "Spectator", "관전 모드", "spectator", "플레이어 무적, 봇이 플레이어 무시", "Player invincible, bots ignore the player", () => c.Spectator, v => c.Spectator = v),
            new("basic", "시작 때 A쪽 구역으로 순간이동", "Teleport next to side A at start", "A쪽으로 이동", "teleport", "멀리 있으면 봇 AI가 간소화되기 때문", "Far bots get reduced AI", () => c.TeleportToArena, v => c.TeleportToArena = v),
            new("basic", "게임 화면에 남은 시뮬 시간 표시", "Show remaining sim time in game", "남은 시간 표시", "timer", "오른쪽 위", "Top right", () => c.ShowTimer, v => c.ShowTimer = v),
            new("basic", "시간이 끝나면 다음 맵으로", "Next map when time is up", "자동 다음 맵", "auto rotate", null, null, () => c.AutoRotate, v => c.AutoRotate = v),
            new("basic", "한 바퀴 돌면 끝내기", "Stop after one cycle", "한 바퀴만", "one cycle", "켜진 맵을 한 번씩 다 하면 멈추고 '수고했습니다' 표시. 끄면 무한 반복", "Every enabled map once, then stop; off = loop forever", () => c.StopAfterOneCycle, v => c.StopAfterOneCycle = v),
            new("basic", "낮 시간대로만 시작", "Daytime starts only", "낮만", "day only", "메뉴의 두 시간대 중 한낮에 가까운 쪽, 공장은 고정 시간", "Of the menu's two raid times, the one closer to midday; Factory has fixed times", () => c.DayOnly, v => c.DayOnly = v),
            new("basic", "맵 사이 대기 때 메모리 정리", "Clean memory between maps", "메모리 정리", "memory clean", "안 쓰는 리소스 해제 + GC", "Unload unused assets + GC", () => c.CleanMemoryBetweenMaps, v => c.CleanMemoryBetweenMaps = v),

            new("spawn", "맵 원래 스폰 지우기", "Clear the map's own spawns", "원래 스폰 지움", "map spawns cleared", "맵의 PMC·스캐브·보스 웨이브(ABPS가 넣은 것 포함)를 지우고 시뮬 분대만", "Removes the map's PMC / scav / boss waves (incl. ABPS's) so only sim squads appear", () => c.RemoveOtherSpawns, v => c.RemoveOtherSpawns = v),
            new("spawn", "시뮬 분대를 ABPS로 생성", "Spawn sim squads with ABPS", "ABPS로 분대 생성", "ABPS squads", "ABPS가 분대를 만들고 SAIN은 자리만 시뮬 구역으로. 끄면 게임 기본 생성(분대가 잘 안 나옴)", "ABPS spawns the squads, SAIN points them at the sim zones. Off = the game's spawner (squads often stall)",
                () => !c.AbpsOffInSim, v => c.AbpsOffInSim = !v, () => Sim.AbpsFound ? null : T("ABPS 없음", "ABPS not found"), Recommended: true),
            new("spawn", "분대마다 다른 팀", "Every squad its own team", "분대마다 다른 팀", "squads all enemies", "자기 분대 말고 전부 적 (끄면 SPT 기본: 같은 진영 15% 확률로 아군)", "All other squads are enemies (off = SPT default: same faction friendly 15% of the time)", () => c.AllSquadsEnemies, v => c.AllSquadsEnemies = v),
