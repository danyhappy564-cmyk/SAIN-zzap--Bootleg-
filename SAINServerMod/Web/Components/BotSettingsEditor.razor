@namespace SAINServerMod.Web.Components
@using System.Globalization
@using System.Reflection
@using System.Text.Json
@using Microsoft.Extensions.Logging
@using SAIN.Preset.Shared.BotSettings.SAINSettings
@using SAIN.Preset.Shared.Models.Preset.Personalities
@using SAINServerMod.Generation
@using SAINServerMod.Generators
@using SAINServerMod.Utils
@inject ISnackbar Snackbar
@inject PresetGenerationService PresetGeneration
@inject ClientDataStorageService ClientData
@inject ILogger<BotSettingsEditor> Logger

<div class="sain-bot-editor">
    <aside class="spt-panel sain-bot-nav">
        <div class="sain-nav-top">
        <div class="sain-nav-heading"><strong>@T("봇 고르기", "Choose bot types")</strong><small>@T($"{_allBots.Count}종", $"{_allBots.Count} types")</small></div>
        <MudTextField T="string" Value="_query" ValueChanged="Search" Immediate="true" DebounceInterval="200"
                      Placeholder="@T("봇 이름 검색", "Search bot types")" Variant="Variant.Outlined" Margin="Margin.Dense"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Search" Clearable="true" />
        <p>@T("이름 클릭: 한 봇 열기", "Click a name: open one bot")<br />@T("○ 또는 Ctrl+클릭: 함께 편집할 묶음", "○ or Ctrl+click: add to selection")</p>
        </div><div class="sain-bot-list">
        @foreach (var section in _visibleSections)
        {
            <div class="sain-bot-faction-head">
                <button type="button" class="sain-select-dot @(FactionMark(section)=="◐"?"partial":null)" aria-pressed="@(FactionMark(section)=="●")" aria-label="@T("팩션 묶음 선택","Select whole faction")" disabled="@(section.Bots.All(b=>!CanChooseAI(b.Type)))" @onclick="() => SelectFaction(section.Name)">@FactionMark(section)</button>
                <button type="button" class="sain-fold" aria-expanded="@((!string.IsNullOrWhiteSpace(_query) || !_collapsedSections.Contains(section.Name)))"
                        aria-label="@T($"{SectionName(section.Name)} 접기/펼치기", $"Collapse/expand {SectionName(section.Name)}")"
                        @onclick="() => ToggleSection(section.Name)">@(_collapsedSections.Contains(section.Name) ? "▸" : "▾")</button>
                <button type="button" class="sain-bot-faction-name"
                        @onclick="() => ToggleSection(section.Name)">@SectionName(section.Name) @if(Korean && SectionName(section.Name)!=section.Name) { <small>@section.Name</small> }</button>
                <span class="sain-faction-count">@FactionCount(section)</span>
            </div>
            @if ((!string.IsNullOrWhiteSpace(_query) || !_collapsedSections.Contains(section.Name)))
            {
                @foreach (var bot in section.Bots)
                {
                    var view = _levelViews[bot.Type];
                    <div class="sain-bot-choice @(!IsBatch && _botType == bot.Type ? "on" : null) @(_selection.Contains(bot.Type) ? "in-faction" : null)">
                    <button type="button" class="sain-select-dot" aria-pressed="@_selection.Contains(bot.Type)" aria-label="@T("묶음에 넣기/빼기","Add to / remove from selection")" disabled="@(!CanChooseAI(bot.Type))" @onclick="() => ToggleSelection(bot.Type)">@(_selection.Contains(bot.Type)?"●":"○")</button>
                    <button type="button" class="sain-bot-item @(!IsBatch && _botType == bot.Type ? "on" : null) @(_selection.Contains(bot.Type) ? "in-faction" : null)"
                            aria-pressed="@(!IsBatch && _botType == bot.Type)" @onclick="e => ClickBot(bot.Type,e)">
                        <span>@bot.Name</span>
                        <span class="sain-bot-badge @BadgeClass(view)">@BadgeText(view)</span>
                    </button>
                    </div>
                }
            }
        }

        @if (_visibleSections.Count == 0)
        {
            <MudText Typo="Typo.caption" Class="spt-muted">@T("맞는 봇 종류가 없습니다.", "No matching bot types.")</MudText>
        }
        </div><div class="sain-nav-foot">@T("이름 옆은 현재 난이도입니다.", "Next to the name is the current Level.")<br /><span class="sain-diff">@T("(조정됨)", "(adjusted)")</span>@T("은 난이도를 고른 뒤 값을 더 바꿨다는 뜻입니다.", " means changed after choosing a Level.")</div>
    </aside>

    <div class="spt-panel sain-bot-main pa-3">
        @if (_selection.Count>0)
        {
            <div class="sain-selection-bar">
                <div class="sain-bundle-title"><strong>@T($"선택한 {_selection.Count}종 함께 편집",$"Editing {(_selection.Count == 1 ? "1 bot type" : $"{_selection.Count} bot types")} together") <small>(@string.Join(" · ",_allBots.Where(b=>_selection.Contains(b.Type)).Select(b=>b.Name)))</small></strong>
                <span>@(IsBatch ? T("아래 변경이 선택한 봇 모두에 적용됩니다.", "Changes below apply to all selected bots.") : T($"지금은 {BotName} 한 봇만 편집합니다. 묶음은 유지됩니다.", $"Currently editing only {BotName}. Your selection is kept."))</span></div>
                @if(!IsBatch) { <button type="button" @onclick="EditSelection">@T("묶음 편집","Edit selection")</button> }
                <button type="button" @onclick="ClearSelection">@T("선택 해제","Clear selection")</button>
            </div>
        }
        @if (_group == null || _selectedView == null)
        {
            <MudText Typo="Typo.body2" Class="spt-muted">@T("편집할 봇 설정이 없습니다.", "No bot settings to edit.")</MudText>
        }
        else if (_copying)
        {
            <MudText Typo="Typo.h6">@T("복사할 봇 고르기", "Pick bots to copy to")</MudText>
            <MudText Typo="Typo.caption" Class="spt-muted">@T($"{BotName}의 난이도 4칸 값을 복사합니다.", $"Copies all 4 difficulty slots from {BotName}.")</MudText>
            <div class="sain-bot-copy-list">
                @foreach (var section in _copySections)
                {
                    <div class="sain-bot-copy-head">
                        <h3 class="sain-bot-section">@SectionName(section.Name)</h3>
                        <MudButton Size="Size.Small" OnClick="() => SelectCopySection(section)">@T("전부 선택", "Select all")</MudButton>
                    </div>
                    @foreach (var bot in section.Bots)
                    {
                        <MudCheckBox T="bool" Value="_copyTargets.Contains(bot.Type)" ValueChanged="v => SelectCopyBot(bot.Type, v)"
                                     Label="@bot.Name" Disabled="@(!CanEdit(bot.Type))" Color="Color.Primary" Dense="true" />
                    }
                }
            </div>
            <MudStack Row Spacing="2" Class="mt-3">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(_copyTargets.Count == 0)" OnClick="CopyToSelectedBots">@T("복사", "Copy")</MudButton>
                <MudButton Variant="Variant.Outlined" OnClick="CancelCopy">@T("취소", "Cancel")</MudButton>
            </MudStack>
        }
        else
        {
            <div class="sain-bot-heading">
                <div class="sain-bot-actions">
                    <MudText Typo="Typo.h6">@(IsBatch?T($"선택한 {_selection.Count}종",$"{_selection.Count} selected bot {(_selection.Count == 1 ? "type" : "types")}"):BotName)</MudText>
                    <span class="sain-target-tag">@(IsBatch?T("함께 편집","Together"):T("한 봇 편집","One bot"))</span>
                </div>
                <div class="sain-bot-actions">
                    @if (SavedGroup(_botType) != null)
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Disabled="@(!EditableViews().Any())" OnClick="RevertBot">@T("되돌리기", "Revert")</MudButton>
                    }
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning" Disabled="@(!EditableViews().Any())" OnClick="ResetBot">@T("원본 사용", "Use original")</MudButton>
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.ContentCopy" Disabled="@(IsBatch || !EditableViews().Any())" OnClick="StartCopy">
                        @T("다른 봇에 복사", "Copy to other bots")
                    </MudButton>
                </div>
            </div>
            <p class="sain-bot-help">@(IsBatch ? string.Join(" · ",_allBots.Where(b=>_selection.Contains(b.Type)).Select(b=>b.Name)) : SectionName(_allBots.First(b=>b.Type==_botType).Section)+" · "+BotName)　<span>@(TargetViews().Count()==1?T("이 봇의 값만 바뀝니다.","Changes apply to this bot only."):T("같은 설정을 여러 봇에 한 번에 바꿉니다.","Change the same settings for all selected bots at once."))</span></p>
            <div class="sain-bot-ai">
                <b>@T("사용할 AI", "AI to use")</b>
                <button type="button" class="sain-refchip @((IsBatch?_factionVanilla==false:!_selectedView.Ai.UsesVanilla) ? "on" : null)" aria-pressed="@(IsBatch?_factionVanilla==false:!_selectedView.Ai.UsesVanilla)" disabled="@(!TargetViews().Any(v=>v.Ai.CanChooseAI))" @onclick="() => SetBotAI(false)">SAIN</button>
                @if(IsBatch && !_factionVanilla.HasValue) { <span class="sain-mixed">@T("섞임","mixed")</span> }
                <button type="button" class="sain-refchip @((IsBatch?_factionVanilla==true:_selectedView.Ai.UsesVanilla) ? "on" : null)" aria-pressed="@(IsBatch?_factionVanilla==true:_selectedView.Ai.UsesVanilla)" disabled="@(!TargetViews().Any(v=>v.Ai.CanChooseAI))" @onclick="() => SetBotAI(true)">@T("게임 기본 (바닐라)", "EFT's own (vanilla)")</button>
                <span class="sain-ai-help">@T("AI 변경은 게임 재시작 후 적용", "Applies after a game restart")</span>
            </div>
            @if (_selectedView.Ai.UsesVanilla) {
            <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">@T("현재 적용: ", "Effective: ") @AiText(_selectedView.Ai)
                @T(" · 보관 중인 봇별 선택: ", " · Stored per-bot choice: ") @(_group.UseVanillaAI ? T("바닐라", "Vanilla") : "SAIN")
                @if (_selectedView.Ai.UsesVanilla) { <span> · @T("SAIN 값은 보관됩니다. 바닐라를 끄면 다시 적용됩니다.", "Stored SAIN values resume when vanilla is disabled.")</span> }
            </MudAlert>
            }
            <fieldset disabled="@(!EditableViews().Any())" style="border:0;padding:0;min-width:0" class="@(_selectedView.Ai.UsesVanilla ? "sain-bot-dim" : null)">
            <div class="sain-step-heading"><span class="sain-step">01</span><strong>@T("난이도 고르기", "Choose Level")</strong><small>@T("고르면 아래 값이 해당 단계로 바뀝니다", "Sets the values below to this Level")</small></div>
            <div class="sain-bot-levels">
                @foreach (var level in Levels)
                {
                    <button type="button" class="sain-bot-level @LevelClass(level) @((IsBatch?_factionBots.Count>0 && _factionCounts[level]==_factionBots.Count:_selectedView.Badge.Level==level) ? "on" : null)"
                            aria-pressed="@(IsBatch?_factionBots.Count>0 && _factionCounts[level]==_factionBots.Count:_selectedView.Badge.Level==level)" disabled="@(!EditableViews().Any(v=>v.Available.Contains(level)))"
                            title="@(!_selectedView.Available.Contains(level) ? MissingLevel(level) : null)" @onclick="() => ApplyBotLevel(level)">
                        <b>@LevelName(level)</b><small>@LevelDescription(level)</small>
                        @if(IsBatch) { <small>@T($"{_factionCounts[level]}종",(_factionCounts[level] == 1 ? "1 type" : $"{_factionCounts[level]} types"))</small> }
                    </button>
                }
            </div>
            @if (_selectedView.AdjustedCount > 0)
            {
                <div class="sain-bot-warning">@T($"⚠ 손으로 조정한 값이 {_selectedView.AdjustedCount}개 있습니다 — 다른 난이도를 누르면 그 단계 값으로 바뀝니다", $"⚠ {_selectedView.AdjustedCount} hand-adjusted value(s) - another level replaces them with that level's values")</div>
            }
            </fieldset>
            <BotSettingsSlotsEditor Source="_group" Sources="_selectedView.Sources" OnApply="ApplySlot" MixedSource="@(IsBatch ? BotName : null)" />
            <fieldset disabled="@(!EditableViews().Any())" style="border:0;padding:0;min-width:0" class="@(_selectedView.Ai.UsesVanilla ? "sain-bot-dim" : null)">
            @* zzap (user 2026-11-04 "too crowded - tabs; a ZZAP part per bot; personality right there; per-map numbers"): same tabs as F6. *@
            <div class="sain-refbar sain-bot-tabs">
                @foreach (var tab in BotTabs)
                {
                    var t = tab;
                    string badge = TabBadge(t);
                    <button type="button" class="sain-refchip @(_tab == t ? "on" : null)" aria-pressed="@(_tab == t)" @onclick="() => _tab = t">@TabName(t)@if (badge.Length > 0) { <span class="sain-tab-count">@badge</span> }</button>
                }
            </div>
            @if (_tab == "zzap")
            {
                <BotZzapPanel Groups="EditGroups()" Global="Bundle.GlobalSettings" OnChanged="NotifyChange" />
            }
            else if (_tab == "maps")
            {
                <BotMapsPanel Groups="EditGroups()" Global="Bundle.GlobalSettings" OnChanged="NotifyChange" />
            }
            else if (_tab != "advanced")
            {
            @if (_tab == "personality")
            {
                <div class="sain-step-heading"><span class="sain-step">P</span><strong>@T("성격 — 이 봇 종류에 정해 주기", "Personality — fix it for these bot types")</strong><small>@T("지정 안 함 = 성격 확률대로 섞음", "Unassigned = mixed by the personality chances")</small></div>
                <p class="sain-bot-help">@T("성격마다 하는 행동(누가 다이아몬드 스텝·돌격을 하는지 등)은 '성격' 탭에서 바꿉니다. 난이도 4칸 모두에 적용됩니다.", "What each personality does (who diamond-steps, pushes...) is on the Personalities tab. Applies to all four difficulty slots.")</p>
            }
            else
            {
                <div class="sain-step-heading"><span class="sain-step">02</span><strong>@T("손잡이로 세부 조절", "Fine-tune with knobs")</strong><small><i class="sain-ref-line"></i> @T("zzap 원본", "zzap original")　<span class="sain-blue">@T("오른쪽일수록 강하게 →", "Stronger to the right →")</span></small></div>
            }

            @if (_settings == null)
            {
                <MudText Typo="Typo.body2" Class="spt-muted mb-3">@T("이 봇에는 편집할 난이도 칸이 없습니다.", "This bot has no difficulty slots to edit.")</MudText>
            }
            else
            {

                @foreach (var section in KnobSections)
                {
                    var tabKnobs = section.Knobs.Where(k => (_tab == "personality") == (k.Id == "personality")).ToArray();
                    if (tabKnobs.Length == 0) continue;
                    <div class="sain-quick-head mt-3">
                        <MudText Typo="Typo.subtitle2" Class="spt-title">@KnobSectionName(section.Name)</MudText>
                    </div>
                    @foreach (var knob in tabKnobs)
                    {
                        float current = knob.Get(_settings);
                        var baseSlot = _fieldBaselines.TryGetValue(_botType,out var baseGroup) ? BotLevels.NormalSlot(baseGroup!) : _referenceSettings;
                        float baseline = baseSlot == null ? current : knob.Get(baseSlot);
                        bool mixed = IsBatch && BotSelectionSettings.KnobMixed(EditableViews().Select(v=>v.Group),knob);
                        int direction = knob.Direction(current, baseline);
                        double currentPos = Percent(knob, current);
                        double referencePos = Percent(knob, baseline);
                        <div class="sain-qrow sain-bot-knob" @key="knob.Id">
                            <div class="sain-bot-knob-label">
                                <span class="sain-qrow-name">@knob.Name(Korean)</span>
                                @if (_changedKnobs.Contains(knob.Id)) { <span class="sain-diff" title="@T("원본과 다름", "Differs from zzap original")">●</span> }
                                @if (knob.Kind is BotKnobKind.Personality or BotKnobKind.Toggle)
                                {
                                    <span class="sain-bot-byslot">@T("난이도와 무관", "Not affected by the level")</span>
                                }
                                <div class="sain-quick-desc">@knob.Help(Korean)</div>
                            </div>
                            <div class="sain-bot-knob-control">
                                @if (knob.Kind is BotKnobKind.Toggle or BotKnobKind.ToggleNumber)
                                {
                                    <MudSwitch T="bool" Value="knob.GetOn(_settings)" ValueChanged="v => SetToggle(knob, v)" Color="Color.Primary"
                                               Label="@(knob.GetOn(_settings) ? T("켬", "On") : T("끔", "Off"))" />
                                }
                                @if (knob.Kind == BotKnobKind.Personality)
                                {
                                    <MudSelect T="EPersonality" MultiSelection="true" SelectedValues="Pool" SelectedValuesChanged="SetPool"
                                               Label="@T("성격 후보 (빈칸=자동)", "Candidates (empty=automatic)")" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                                        @foreach (var personality in Personalities.Where(p => p != EPersonality.None))
                                        {
                                            <MudSelectItem T="EPersonality" Value="personality">@PersonalityName(personality)</MudSelectItem>
                                        }
                                    </MudSelect>
                                    <small>@T("여러 개: 생성할 때 균등 무작위 · 한 개: 고정", "Multiple: uniform at spawn · one: fixed")</small>
                                }
                                @if (knob.Kind is BotKnobKind.Number or BotKnobKind.ToggleNumber)
                                {
                                    <div class="sain-quick-slider sain-diffslider sain-bot-slider">
                                        <div class="sain-dl">
                                            <span class="t"></span>
                                            <span class="b" style="width:@(Css(currentPos))%"></span>
                                            @if (_referenceSettings != null)
                                            {
                                                <span class="r" style="left:@(Css(referencePos))%" title="@knob.Format(baseline, Korean)"></span>
                                            }
                                        </div>
                                        <MudSlider T="double" Min="knob.Min" Max="knob.Max" Step="knob.Step" Value="Math.Round(knob.ToSlider(current), 3)"
                                                   ValueChanged="v => SetNumber(knob, knob.Round(knob.FromSlider((float)v)))" Color="Color.Default" Immediate="true" aria-label="@knob.Name(Korean)" />
                                    </div>
                                }
                            </div>
                            <div class="sain-bot-delta">
                                @if(mixed) { <span class="sain-mixed">@T("섞임", "mixed")</span><small>@T("원본은 봇마다 다름", "original differs per bot")</small> }
                                else {
                                    <span>@KnobText(knob,_settings)</span>
                                    <small>@T("원본 ", "original ")@KnobText(knob,baseSlot)</small>
                                }
                            </div>
                            <div class="sain-bot-reset"><button type="button" disabled="@(!_changedKnobs.Contains(knob.Id))" @onclick="() => ResetKnob(knob)">@T("원래대로", "Reset")</button></div>
                        </div>
                    }
                }
            }
            }
            else
            {
                <div class="sain-step-heading"><span class="sain-step">03</span><strong>@T($"고급 · 숫자로 직접 설정 {_advancedRows.Count}개", $"Advanced · exact numbers {_advancedRows.Count}")</strong> <span class="sain-new">NEW @_advancedRows.Count(r=>r.Editor.Meta.New)</span></div>
                <div class="sain-advanced-body">
                <div class="sain-refbar sain-bot-scope">
                    <span class="sain-refbar-label">@T("묶음", "Group")</span>
                    <button type="button" class="sain-refchip @(_advCategory == null ? "on" : null)" @onclick="() => _advCategory = null">@T("전부", "All")</button>
                    @foreach (var section in _advancedSections)
                    {
                        var name = section.Name;
                        <button type="button" class="sain-refchip @(_advCategory == name ? "on" : null)" @onclick="() => _advCategory = name">@section.Label</button>
                    }
                </div>
                <p class="sain-bot-help">@T("같은 숫자를 편집 대상 전체에 적용합니다. 각 항목의 원래대로는 봇마다 원래 값을 되살립니다.", "Numbers apply to all bots being edited. Reset restores each bot’s original value for that setting.")</p>
                <div class="sain-setting-filters">
                    <MudSwitch T="bool" @bind-Value="_newOnly" Label="@T("새 항목만 보기","New only")" />
                    <MudSwitch T="bool" @bind-Value="_changedOnly" Label="@T("바뀐 항목만 보기","Changed only")" />
                    <small>@T("기준: zzap 원본 · 두 필터는 함께 적용됩니다", "Compared with zzap original · both filters apply together")</small>
                </div>

                <MudText Typo="Typo.subtitle2" Class="spt-title mt-3">@T("난이도별로 따로 바꾸기", "Per-difficulty editing")</MudText>
                <div class="sain-refbar sain-bot-scope">
                    <button type="button" class="sain-refchip @(!_scope.HasValue ? "on" : null)" aria-pressed="@(!_scope.HasValue)" @onclick="() => SelectScope(null)">@T("난이도 4칸 전부", "All 4 difficulties")</button>
                    @foreach (var difficulty in Difficulties)
                    {
                        bool seen = _records[_botType].Totals.ContainsKey(difficulty);
                        <button type="button" class="sain-refchip @(_scope == difficulty ? "on" : null) @(!seen ? "sain-bot-unseen" : null)"
                                aria-pressed="@(_scope == difficulty)" @onclick="() => SelectScope(difficulty)">
                            @Value(difficulty)@(!seen ? T(" (안 나옴)", " (not seen)") : "")
                        </button>
                    }
                </div>
                <div class="sain-bot-shown spt-muted">@_records[_botType].Detail</div>
                <div class="sain-bot-shown spt-muted">@ScopeLine</div>
                <div class="sain-bot-shown spt-muted">@(_allSlotsSame ? T("4칸 같음", "All 4 slots match") : T("칸마다 다름", "Differs by slot"))</div>
                @foreach (var knob in BotQuickSettings.All.Where(k => _bySlotKnobs.Contains(k.Id)))
                {
                    <div class="sain-bot-shown spt-muted">
                        @knob.Name(Korean):
                        <span class="sain-bot-slots">
                            @foreach (var slot in _knobSlotValues[knob.Id])
                            {
                                <span class="@(slot.Difficulty == _advancedShown ? "on" : null)">@Value(slot.Difficulty) @slot.Text</span>
                            }
                        </span>
                    </div>
                }
                @if (_advancedSettings == null)
                {
                    <MudText Typo="Typo.body2" Class="spt-muted mt-2">@T("이 난이도 칸에는 설정이 없습니다. 다른 칸을 골라 주세요.", "No settings in this difficulty slot. Pick another slot.")</MudText>
                }
                @foreach (var section in _advancedSections.Where(s=>(_advCategory == null || s.Name == _advCategory) && s.Rows.Any(VisibleRow)))
                {
                    <MudText Typo="Typo.subtitle2" Class="spt-title mt-3 mb-1">@(section.Label)</MudText>
                    @foreach (var row in section.Rows.Where(VisibleRow))
                    {
                        <div class="sain-bot-advanced-row" @key="row">
                            @if (row.Nested != null)
                            {
                                <div class="sain-bot-field-help spt-muted">@row.Context</div>
                            }
                            <SainFieldEditor Value="row.Editor" OnChanged="NotifyChange" Changed="row.Changed" />
                            @if (!string.IsNullOrWhiteSpace(row.Editor.Meta.Description))
                            {
                                <div class="sain-bot-field-help spt-muted">@Setting(row.Editor.Meta.Description)</div>
                            }
                            <div class="sain-bot-field-reference">
                                @if(IsBatch && MixedField(row)) { <span class="sain-mixed">@T("섞임","mixed")</span> }
                                <span class="sain-qref">@FieldReference(row)</span>
                                @if (row.Category == null)
                                {
                                    <span class="spt-muted">@T("봇 종류 전체에 적용", "Applies to this whole bot type")</span>
                                }
                                <button type="button" disabled="@(!row.Changed)" @onclick="() => ResetField(row)">@T("원래대로", "Reset")</button>
                            </div>
                        </div>
                    }
                }
                </div>
            }
            </fieldset>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public SAINPresetBundle Bundle { get; set; } = default!;
    [Parameter] public SAINPresetBundle? Zzap { get; set; }
    [Parameter] public SAINPresetBundle? Original { get; set; }
    [Parameter] public IReadOnlyList<(string Name, SAINPresetBundle Bundle)> References { get; set; } = Array.Empty<(string, SAINPresetBundle)>();
    [Parameter] public EventCallback OnChanged { get; set; }

    private sealed record BotOption(ESainWildSpawnType Type, string Name, string Section);
    private sealed record BotSection(string Name, List<BotOption> Bots);
    private sealed record SpawnSummary(Dictionary<ESainBotDifficulty, int> Totals, string Detail);
    // zzap (2026-10-23): cache sources, badges and computed knob references outside the render path.
    private sealed class BotLevelView
    {
        public required ESainWildSpawnType Type { get; init; }
        public required SAINSettingsGroupClass Group { get; init; }
        public required LevelSources Sources { get; init; }
        public (EBotLevel Level, bool Adjusted, bool Custom) Badge { get; set; }
        public int AdjustedCount { get; set; }
        public SAINSettingsClass? Baseline { get; set; }
        public SAINSettingsGroupClass? KnobReference { get; set; }
        public BotAiState Ai { get; set; }
        public HashSet<EBotLevel> Available { get; } = new();
    }
    private sealed record AdvancedSection(string Name, string Label, List<AdvancedRow> Rows);
    private sealed record AdvancedRow(string Group, FieldInfo? Category, FieldInfo Field, SainValue Editor, FieldInfo? Nested = null, string Context = "")
    {
        public bool Changed { get; set; }
    }

    private static readonly ESainBotDifficulty[] Difficulties =
        { ESainBotDifficulty.easy, ESainBotDifficulty.normal, ESainBotDifficulty.hard, ESainBotDifficulty.impossible };
    private static readonly EBotLevel[] Levels = { EBotLevel.Easy, EBotLevel.Normal, EBotLevel.Hard, EBotLevel.Impossible };
    private static readonly EPersonality[] Personalities = Enum.GetValues<EPersonality>();
    private static readonly (string Name, BotKnob[] Knobs)[] KnobSections =
        { ("aim", BotQuickSettings.All.Where(k => k.Group == "aim").ToArray()),
          ("sense", BotQuickSettings.All.Where(k => k.Group == "sense").ToArray()),
          ("mind", BotQuickSettings.All.Where(k => k.Group == "mind").ToArray()) };
    private static readonly FieldInfo ModifierField = typeof(SAINSettingsGroupClass).GetField(nameof(SAINSettingsGroupClass.DifficultyModifier))!;
    // The shared list also contains the nested aim-part weights; expose their numeric leaves through the same editor.
    private static readonly (FieldInfo Category, FieldInfo Nested, FieldInfo Field)[] NestedFields = BotAdvancedFields.List()
        .Where(item => SainValue.Classify(item.Field.FieldType) == SainFieldKind.Nested)
        .SelectMany(item => item.Field.FieldType.GetFields(BindingFlags.Public | BindingFlags.Instance)
            .Where(field => !SainMeta.Read(field).Hidden
                && (SainValue.Classify(field.FieldType) is SainFieldKind.Float or SainFieldKind.Int or SainFieldKind.Bool or SainFieldKind.Enum))
            .Select(field => (Category: item.Category, Nested: item.Field, Field: field))).ToArray();

    private SAINPresetBundle? _lastBundle;
    private SAINPresetBundle? _easyBundle;
    private SAINPresetBundle? _normalBundle;
    private SAINPresetBundle? _hardBundle;
    private object? _lastDefaults;
    private LevelGlobals? _currentGlobals;
    private LevelGlobals? _easyGlobals;
    private LevelGlobals? _normalGlobals;
    private LevelGlobals? _hardGlobals;
    private (float Sight, float Spotting, float Scatter, float Hearing, float Accuracy, float Recoil, bool Cqb)? _globalKey;
    private SAINPresetBundle? _defaultBundle;
    private bool _lastKorean;
    private ESainWildSpawnType _botType;
    private ESainBotDifficulty? _scope;
    private ESainBotDifficulty _shown;
    private ESainBotDifficulty _advancedShown;
    private SAINSettingsGroupClass? _group;
    private SAINSettingsClass? _settings;
    private SAINSettingsClass? _referenceSettings;
    private SAINSettingsClass? _advancedSettings;
    private BotLevelView? _selectedView;
    private readonly Dictionary<ESainWildSpawnType, BotLevelView> _levelViews = new();
    private readonly Dictionary<ESainWildSpawnType,SAINSettingsGroupClass?> _fieldBaselines = new();
    private readonly HashSet<string> _collapsedSections = new();
    private bool _editingSelection;
    private readonly HashSet<ESainWildSpawnType> _selection=new();
    private bool _newOnly, _changedOnly;
    private bool IsBatch => _editingSelection;
    private IEnumerable<BotLevelView> TargetViews() => _levelViews.Values.Where(v=>IsBatch?_selection.Contains(v.Type):v.Type==_botType);
    private IEnumerable<BotLevelView> EditableViews() => TargetViews().Where(v=>v.Ai.CanEditSain);
    private void ClickBot(ESainWildSpawnType type,MouseEventArgs e) { if(e.CtrlKey) ToggleSelection(type); else SelectBot(type); }
    private void ToggleSelection(ESainWildSpawnType type)
    {
        if(!CanChooseAI(type)) return;
        if(!_selection.Remove(type)) _selection.Add(type);
        EditSelection();
    }
    private void ClearSelection() { _selection.Clear(); _editingSelection=false; Select(true); }
    private void EditSelection()
    {
        _editingSelection=_selection.Count>0;
        if(IsBatch) _botType=_selection.Where(CanEdit).Cast<ESainWildSpawnType?>().FirstOrDefault() ?? _selection.First();
        CancelCopy(); RefreshFaction(); Select(true);
    }
    private string FactionMark(BotSection section)
    {
        var eligible=section.Bots.Where(b=>CanChooseAI(b.Type)).ToArray();
        int count=eligible.Count(b=>_selection.Contains(b.Type));
        return count==0?"○":count==eligible.Length?"●":"◐";
    }
    private async Task ApplySlot(BotSettingsSlot slot)
    {
        int skipped=0;
        var targets=TargetViews().Where(v=>v.Ai.CanChooseAI).ToArray();
        if(targets.Length==0) { Snackbar.Add(T("편집 가능한 봇이 없습니다. 전역·고정 바닐라는 건너뜁니다.","No editable bots here. Bots locked to EFT's own AI (vanilla) are skipped."),Severity.Info); return; }
        foreach(var view in targets) skipped+=BotSettingsSlots.Apply(slot,view.Group,view.Sources);
        if(skipped>0) Snackbar.Add(T($"없는 필드·난이도 칸 {skipped}개를 건너뛰었습니다.",$"Skipped {skipped} setting(s) this bot doesn't have."),Severity.Info);
        await NotifyBotsChanged(targets.Select(v=>v.Type));
    }
    private bool MixedField(AdvancedRow row)
    {
        if(row.Category==null) return TargetViews().Select(v=>v.Group.DifficultyModifier).Distinct().Skip(1).Any();
        var path=new BotFieldRow(row.Group,row.Category,row.Nested,row.Field);
        return BotSelectionSettings.FieldMixed(EditableViews().Select(v=>v.Group),path,_advancedShown);
    }
    private bool VisibleRow(AdvancedRow row) => (!_newOnly || SettingsFieldStatus.IsNew(row.Field)) && (!_changedOnly || row.Changed);
    private List<BotOption> _factionBots = new();
    private bool? _factionVanilla;
    private readonly Dictionary<EBotLevel, int> _factionCounts = Levels.ToDictionary(level => level, _ => 0);
    private List<SpawnRaidCounts> _raids = new();
    private List<BotOption> _allBots = new();
    private List<BotSection> _visibleSections = new();
    private List<BotSection> _copySections = new();
    private readonly Dictionary<ESainWildSpawnType, SpawnSummary> _records = new();
    private readonly HashSet<ESainWildSpawnType> _copyTargets = new();
    private readonly HashSet<string> _changedKnobs = new();
    private readonly HashSet<string> _bySlotKnobs = new();
    private readonly Dictionary<string, List<(ESainBotDifficulty Difficulty, string Text)>> _knobSlotValues = new();
    private bool _allSlotsSame;
    private List<AdvancedRow> _advancedRows = new();
    private List<AdvancedSection> _advancedSections = new();
    private string _query = string.Empty;
    private string? _advCategory;
    private string _tab = "quick";
    private static readonly string[] BotTabs = { "quick", "personality", "zzap", "maps", "advanced" };

    private static string TabName(string tab) => tab switch
    {
        "quick" => T("빠른 설정", "Quick"),
        "personality" => T("성격", "Personality"),
        "zzap" => T("ZZAP (전술 등..)", "ZZAP (tactics etc.)"),
        "maps" => T("맵별 보정", "Per map"),
        _ => T("고급 · 숫자로 직접", "Advanced · exact numbers"),
    };

    private IReadOnlyList<SAINSettingsGroupClass> EditGroups() => EditableViews().Select(v => v.Group).Where(g => g != null).ToList();

    private string TabBadge(string tab)
    {
        int n = tab switch
        {
            "zzap" => BotZzapSwitches.Changed(EditGroups()),
            "maps" => EditGroups().SelectMany(BotMapModifiers.ChangedMaps).Distinct().Count(),
            _ => 0,
        };
        return n > 0 ? n.ToString() : string.Empty;
    }
    private bool _copying;
    private int _advancedChanged;
    private string BotName => _group?.Name ?? _botType.ToString();

    // zzap (2026-10-23): slot scope belongs only to the advanced editor; knobs always affect all slots.
    private string ScopeLine
    {
        get
        {
            bool recorded = _records.TryGetValue(_botType, out var record) && record.Totals.Count > 0;
            return _scope.HasValue
                ? T($"지금 보는 칸: {Value(_advancedShown)} · 바꾸면 {Value(_advancedShown)} 칸만 바뀝니다", $"Showing: {Value(_advancedShown)} · changes hit the {Value(_advancedShown)} slot only")
                : T($"지금 보는 칸: {Value(_advancedShown)}{(recorded ? " (최근 레이드 기록 기준)" : " (기록 없음)")} · 바꾸면 4칸 모두 같은 비율로 바뀝니다",
                    $"Showing: {Value(_advancedShown)}{(recorded ? " (recent raid records)" : " (no record)")} · changes move all four slots by the same ratio");
        }
    }

    // zzap (2026-10-23): load once per opened component; missing or damaged records never block editing.
    protected override async Task OnInitializedAsync()
    {
        try
        {
            string? json = await ClientData.GetAsync(SpawnDifficultyRecord.DataKey);
            if (!string.IsNullOrWhiteSpace(json))
            {
                _raids = JsonSerializer.Deserialize<List<SpawnRaidCounts>>(json,
                    new JsonSerializerOptions { IncludeFields = true, PropertyNameCaseInsensitive = true }) ?? new();
                _raids = _raids.Where(r => r?.Counts != null).TakeLast(SpawnDifficultyRecord.KeepRaids).ToList();
            }
        }
        catch (Exception ex)
        {
            _raids = new();
            Logger.LogWarning(ex, "SAIN bot settings: could not read spawn difficulty records.");
        }
    }

    protected override void OnParametersSet()
    {
        bool bundleChanged = !ReferenceEquals(Bundle, _lastBundle);
        var easy = FindReference("zzap 쉬움");
        var normal = FindReference("zzap 보통");
        var hard = Zzap ?? FindReference("zzap");
        var defaults = PresetGeneration.Presets.FirstOrDefault(p => p.Info?.BaseSAINDifficulty == SAINDifficulty.hard);
        var globals = Bundle.GlobalSettings;
        var globalKey = (globals?.Difficulty.VisibleDistCoef ?? 0f, globals?.Difficulty.GainSightCoef ?? 0f,
            globals?.Difficulty.ScatteringCoef ?? 0f, globals?.Difficulty.HearingDistanceCoef ?? 0f,
            globals?.Difficulty.ACCURACY_SPEED_COEF ?? 0f, globals?.Shoot.BOT_RECOIL_COEF ?? 0f,
            globals?.Aiming.FasterCQBReactionsGlobal ?? false);
        bool sourcesChanged = bundleChanged || !ReferenceEquals(easy, _easyBundle) || !ReferenceEquals(normal, _normalBundle)
            || !ReferenceEquals(hard, _hardBundle) || !ReferenceEquals(defaults, _lastDefaults) || _globalKey != globalKey;
        bool languageChanged = Korean != _lastKorean;
        _lastBundle = Bundle;
        _lastKorean = Korean;
        if (bundleChanged)
        {
            var definitions = PresetGeneration.AllBotTypes().ToList();
            var sectionByType = definitions.GroupBy(b => b.WildSpawnType)
                .ToDictionary(g => g.Key, g => g.First().Section ?? "Other");
            // Same order as F6: factions and bots as the bot type list defines them (Scavs, PMCs, Goons, ...), not alphabetical.
            var sectionOrder = definitions.Select(b => b.Section ?? "Other").Distinct().Select((name, i) => (name, i)).ToDictionary(x => x.name, x => x.i);
            var botOrder = definitions.Select((b, i) => (b.WildSpawnType, i)).GroupBy(x => x.WildSpawnType).ToDictionary(g => g.Key, g => g.First().i);
            _allBots = (Bundle.BotSettings ?? new()).Where(kv => kv.Value != null)
                .Select(kv => new BotOption(kv.Key, kv.Value.Name ?? kv.Key.ToString(),
                    sectionByType.TryGetValue(kv.Key, out var section) ? section : "Other"))
                .OrderBy(b => sectionOrder.TryGetValue(b.Section, out int i) ? i : int.MaxValue)
                .ThenBy(b => botOrder.TryGetValue(b.Type, out int i) ? i : int.MaxValue).ThenBy(b => b.Name).ToList();
            if (_allBots.All(b => b.Type != _botType))
            {
                _botType = _allBots.FirstOrDefault()?.Type ?? default;
            }
            _scope = null;
            _selection.IntersectWith(_allBots.Select(b=>b.Type));
            if(_selection.Count==0) _editingSelection=false;
            CancelCopy();
            _collapsedSections.UnionWith(_allBots.Select(b=>b.Section));
        }
        if (bundleChanged || languageChanged)
        {
            BuildRecords(bundleChanged);
            Search(_query);
        }
        if (sourcesChanged)
        {
            _easyBundle = easy;
            _normalBundle = normal;
            _hardBundle = hard;
            _lastDefaults = defaults;
            _defaultBundle = defaults?.ToBundle();
            _globalKey = globalKey;
            _currentGlobals = LevelGlobals.From(Bundle.GlobalSettings);
            _easyGlobals = LevelGlobals.From(easy!);
            _normalGlobals = LevelGlobals.From(normal!);
            _hardGlobals = LevelGlobals.From(hard!);
            _levelViews.Clear();
            foreach (var bot in _allBots)
            {
                if (Bundle?.BotSettings == null || !Bundle.BotSettings.TryGetValue(bot.Type, out var group) || group == null) continue;
                var view = new BotLevelView
                {
                    Type = bot.Type, Group = group,
                    Sources = new LevelSources
                    {
                        Reference = ReferenceGroup(bot.Type)!, Current = _currentGlobals!,
                        BaselineLevel = BotLevels.PresetLevel(Bundle.Info.Name),
                        BaselineBot = FamilyBaseline(bot.Type)!,
                        Easy = _easyGlobals!, Normal = _normalGlobals!, Hard = _hardGlobals!,
                        EasyBot = GroupOf(easy, bot.Type)!, NormalBot = GroupOf(normal, bot.Type)!, HardBot = GroupOf(hard, bot.Type)!,
                    },
                };
                foreach (var level in Levels.Where(level => BotLevels.Available(level, view.Sources))) view.Available.Add(level);
                _levelViews[bot.Type] = view;
                RefreshLevelView(bot.Type);
            }
        }
        foreach (var view in _levelViews.Values) view.Ai = BotAiPolicy.Resolve(view.Type, Bundle.GlobalSettings?.General?.VanillaBots, view.Group);
        Select(sourcesChanged || languageChanged);
        RefreshFaction();
    }

    private SAINSettingsGroupClass? FamilyBaseline(ESainWildSpawnType type)
    {
        var level = BotLevels.PresetLevel(Bundle.Info.Name);
        string? name = level switch { EBotLevel.Easy => "zzap 쉬움", EBotLevel.Normal => "zzap 보통", EBotLevel.Hard => "zzap", _ => null };
        return name == null ? null : GroupOf(FindReference(name), type);
    }
    private bool CanEdit(ESainWildSpawnType type) => _levelViews.TryGetValue(type, out var view) && view.Ai.CanEditSain;
    private bool CanChooseAI(ESainWildSpawnType type) => _levelViews.TryGetValue(type, out var view) && view.Ai.CanChooseAI;
    private static string AiText(BotAiState ai) => ai.Mode switch
    {
        BotAiMode.GlobalVanilla => T("바닐라 · 전역 우선", "Vanilla · global override"),
        BotAiMode.AlwaysVanilla => T("바닐라 · 고정", "Vanilla · fixed"),
        BotAiMode.ExternalVanilla => T("바닐라 · 외부", "Vanilla · external"),
        BotAiMode.PerBotVanilla => T("바닐라 · 봇별", "Vanilla · per bot"), _ => "SAIN",
    };
    private IReadOnlyCollection<EPersonality> Pool => BotPersonalityPool.Candidates(_botType, _settings?.Mind).ToArray();
    private Task SetPool(IEnumerable<EPersonality> values)
    {
        if (_group == null || !CanEdit(_botType)) return Task.CompletedTask;
        foreach(var view in EditableViews()) BotPersonalityPool.Set(view.Group, values);
        return NotifyChange();
    }

    private SAINPresetBundle? FindReference(string name)
        => References?.FirstOrDefault(r => string.Equals(r.Name, name, StringComparison.OrdinalIgnoreCase)).Bundle;

    private static SAINSettingsGroupClass? GroupOf(SAINPresetBundle? bundle, ESainWildSpawnType type)
        => bundle?.BotSettings != null && bundle.BotSettings.TryGetValue(type, out var group) ? group : null;

    private SAINSettingsGroupClass? SavedGroup(ESainWildSpawnType type) => GroupOf(Original, type);

    // zzap (2026-10-23): each knob resets only its own fields to the selected level's computed values.
    private void RefreshLevelView(ESainWildSpawnType type)
    {
        if (!_levelViews.TryGetValue(type, out var view)) return;
        view.Ai = BotAiPolicy.Resolve(type, Bundle.GlobalSettings?.General?.VanillaBots, view.Group);
        bool hasSlots = BotLevels.NormalSlot(view.Group) != null;
        view.Badge = BotLevels.Badge(view.Group, view.Sources);
        view.AdjustedCount = hasSlots ? BotLevels.AdjustedCount(view.Group, view.Sources) : 0;
        var level = view.Group.DifficultyLevel == EBotLevel.None ? EBotLevel.Hard : view.Group.DifficultyLevel;
        view.Baseline = view.Group.DifficultyLevel == EBotLevel.None && (view.Sources.BaselineBot ?? view.Sources.Reference) != null
            ? BotLevels.NormalSlot(BotLevels.Snapshot(view.Sources.BaselineBot ?? view.Sources.Reference))
            : hasSlots && view.Available.Contains(level) ? BotLevels.Compute(level, view.Group, view.Sources) : null;
        view.KnobReference = null;
        if (view.Baseline != null && view.Group.Settings != null)
        {
            // zzap (2026-10-23): Compute defines only level-written fields; keep the other knob choices on their v1 reference.
            var choices = BotLevels.NormalSlot(view.Sources.Reference) ?? BotLevels.NormalSlot(view.Group);
            if (choices != null)
            {
                view.Baseline.Mind.PersonalityOverride = choices.Mind.PersonalityOverride;
                view.Baseline.Core.CanGrenade = choices.Core.CanGrenade;
                view.Baseline.Aiming.AimForHead = choices.Aiming.AimForHead;
            }
            var reference = new SAINSettingsGroupClass(Array.Empty<ESainBotDifficulty>());
            foreach (var difficulty in view.Group.Settings.Keys) reference.Settings[difficulty] = view.Baseline;
            view.KnobReference = reference;
        }
    }

    private void BuildRecords(bool refreshTotals)
    {
        if (refreshTotals) _records.Clear();
        foreach (var bot in _allBots)
        {
            var totals = _records.TryGetValue(bot.Type, out var previous) ? previous.Totals : SpawnDifficultyRecord.Totals(_raids, bot.Type);
            string detail = totals.Count == 0 ? T("실제로 나온 난이도: 아직 기록 없음", "Spawned difficulties: no record yet")
                : T("실제로 나온 난이도: ", "Spawned difficulties: ")
                    + string.Join(" · ", Difficulties.Where(totals.ContainsKey).Select(d => T($"{Value(d)} {totals[d]}명", $"{Value(d)} {totals[d]}")))
                    + T($" (최근 {_raids.Count}판)", $" (last {_raids.Count} raids)");
            _records[bot.Type] = new SpawnSummary(totals, detail);
        }
    }

    private void Search(string? query)
    {
        _query = query ?? string.Empty;
        string term = _query.Trim();
        _visibleSections = _allBots.Where(b => b.Name.Contains(term, StringComparison.OrdinalIgnoreCase)
                || b.Type.ToString().Contains(term, StringComparison.OrdinalIgnoreCase))
            .GroupBy(b => b.Section).Select(g => new BotSection(g.Key, g.ToList())).ToList();
    }

    private void SelectBot(ESainWildSpawnType type)
    {
        _botType = type;
        _editingSelection = false;
        _scope = null;
        CancelCopy();
        Select();
    }

    private void SelectScope(ESainBotDifficulty? difficulty)
    {
        _scope = difficulty;
        Select();
    }

    private void ToggleSection(string section)
    {
        if (!_collapsedSections.Add(section)) _collapsedSections.Remove(section);
    }

    private void SelectFaction(string section)
    {
        var eligible=_allBots.Where(b=>b.Section==section && CanChooseAI(b.Type)).Select(b=>b.Type).ToArray();
        if(eligible.All(_selection.Contains)) _selection.ExceptWith(eligible); else _selection.UnionWith(eligible);
        EditSelection();
    }

    private void RefreshFaction()
    {
        _factionBots = _allBots.Where(b => _selection.Contains(b.Type)).ToList();
        _factionVanilla = null;
        if (_factionBots.Count > 0)
        {
            bool first = _levelViews[_factionBots[0].Type].Ai.UsesVanilla;
            if (_factionBots.All(b => _levelViews[b.Type].Ai.UsesVanilla == first)) _factionVanilla = first;
        }
        foreach (var level in Levels)
        {
            _factionCounts[level] = _factionBots.Count(b => _levelViews[b.Type].Badge.Level == level);
        }
    }

    private Task SetBotAI(bool vanilla)
    {
        var views=TargetViews().Where(v=>v.Ai.CanChooseAI && v.Group.UseVanillaAI!=vanilla).ToArray();
        foreach(var view in views) view.Group.UseVanillaAI=vanilla;
        return views.Length==0?Task.CompletedTask:NotifyBotsChanged(views.Select(v=>v.Type));
    }
    private Task ApplyBotLevel(EBotLevel level)
    {
        var views=EditableViews().Where(v=>v.Available.Contains(level)).ToArray();
        BotSelectionSettings.ApplyLevel(views.Select(v=>v.Group),level,g=>views.First(v=>ReferenceEquals(v.Group,g)).Sources);
        return NotifyBotsChanged(views.Select(v=>v.Type));
    }
    private Task RevertBot() => ChangeTargets(v=>BotLevels.RestoreSaved(v.Group,SavedGroup(v.Type)!));
    private Task ResetBot() => ChangeTargets(v=>BotLevels.ResetToOriginal(v.Group,v.Sources));
    private Task ChangeTargets(Action<BotLevelView> change,bool aiOnly=false)
    {
        var views=TargetViews().Where(v=>aiOnly?v.Ai.CanChooseAI:v.Ai.CanEditSain).ToArray();
        if(views.Length==0) return Task.CompletedTask;
        foreach(var view in views) change(view);
        return NotifyBotsChanged(views.Select(v=>v.Type));
    }

    private void Select(bool rebuild = false)
    {
        var previousGroup = _group;
        var previousSettings = _advancedSettings;
        if(IsBatch && _selection.Count>0) _botType=TargetViews().FirstOrDefault(v=>v.Ai.CanEditSain)?.Type ?? _selection.First();
        _group = GroupOf(Bundle, _botType);
        _selectedView = _levelViews.GetValueOrDefault(_botType);
        _settings = BotLevels.NormalSlot(_group!);
        _shown = _group?.Settings?.FirstOrDefault(pair => ReferenceEquals(pair.Value, _settings)).Key ?? ESainBotDifficulty.normal;
        _referenceSettings = _selectedView?.Baseline;
        _advancedShown = _scope ?? (_records.TryGetValue(_botType, out var record) ? SpawnDifficultyRecord.ShownDifficulty(record.Totals) : ESainBotDifficulty.normal);
        _advancedSettings = Slot(_group, _advancedShown);
        if (!_scope.HasValue && _advancedSettings == null)
        {
            _advancedShown = _shown;
            _advancedSettings = _settings;
        }
        if (rebuild || !ReferenceEquals(previousGroup, _group) || !ReferenceEquals(previousSettings, _advancedSettings))
        {
            BuildAdvancedRows();
        }
        RefreshSelectionMarks();
    }

    private SAINSettingsGroupClass? ReferenceGroup(ESainWildSpawnType type)
        => FamilyBaseline(type) ?? GroupOf(_hardBundle, type) ?? GroupOf(_defaultBundle, type);

    private static SAINSettingsClass? Slot(SAINSettingsGroupClass? group, ESainBotDifficulty difficulty)
        => group?.Settings != null && group.Settings.TryGetValue(difficulty, out var slot) ? slot : null;

    private Task SetNumber(BotKnob knob, float value)
    {
        BotSelectionSettings.Apply(EditableViews().Select(v=>v.Group),knob,value);
        return NotifyChange();
    }
    private Task SetToggle(BotKnob knob, bool value)
    {
        BotSelectionSettings.ApplyToggle(EditableViews().Select(v=>v.Group),knob,value);
        return NotifyChange();
    }
    private Task SetPersonality(BotKnob knob, EPersonality value)
    {
        BotSelectionSettings.ApplyPersonality(EditableViews().Select(v=>v.Group),knob,value);
        return NotifyChange();
    }
    private Task ResetKnob(BotKnob knob)
    {
        var views=EditableViews().ToArray();
        BotSelectionSettings.Reset(views.Select(v=>v.Group),knob,g=>views.First(v=>ReferenceEquals(v.Group,g)).Sources);
        return NotifyBotsChanged(views.Select(v=>v.Type));
    }

    private string ChoiceReference(BotKnob knob)
    {
        if (_settings == null || _referenceSettings == null) return T("기준 없음", "No reference");
        bool personality = knob.Kind == BotKnobKind.Personality;
        bool same = personality ? knob.GetPersonality(_settings) == knob.GetPersonality(_referenceSettings)
            : knob.GetOn(_settings) == knob.GetOn(_referenceSettings);
        string baseline = personality ? PersonalityName(knob.GetPersonality(_referenceSettings))
            : knob.GetOn(_referenceSettings) ? T("켬", "On") : T("끔", "Off");
        return same ? T("기준과 같음", "Same as reference") : T($"기준 {baseline} →", $"Reference {baseline} →");
    }

    private void BuildAdvancedRows()
    {
        _advancedRows = new();
        if (_group != null)
        {
            _advancedRows.Add(AdvancedField("modifier", null, ModifierField, _group));
        }
        if (_advancedSettings != null)
        {
            foreach (var item in BotAdvancedFields.List())
            {
                object? owner = item.Category.GetValue(_advancedSettings);
                if (owner == null) continue;
                if (SainValue.Classify(item.Field.FieldType) == SainFieldKind.Nested)
                {
                    object? nestedOwner = item.Field.GetValue(owner);
                    if (nestedOwner == null) continue;
                    foreach (var path in NestedFields)
                    {
                        if (path.Category == item.Category && path.Nested == item.Field)
                        {
                            _advancedRows.Add(AdvancedField(item.Group, item.Category, path.Field, nestedOwner, item.Field));
                        }
                    }
                }
                else
                {
                    _advancedRows.Add(AdvancedField(item.Group, item.Category, item.Field, owner));
                }
            }
        }
        _advancedSections = _advancedRows.GroupBy(r => r.Group)
            .Select(g => new AdvancedSection(g.Key, AdvancedSectionName(g.Key), g.ToList())).ToList();
    }

    // zzap (2026-10-23): intercept the field editor's setter before it changes the shown value, preserving all-slot ratios.
    // The editor's built-in default reset is omitted here; the explicit reset uses the zzap reference instead.
    private AdvancedRow AdvancedField(string group, FieldInfo? category, FieldInfo field, object owner, FieldInfo? nested = null)
    {
        var source = new SainMember(owner, field).ToValue();
        var editor = new SainValue
        {
            Meta = source.Meta, ValueType = source.ValueType, Getter = source.Getter, CanWrite = source.CanWrite,
            Setter = value => ApplyField(category, nested, field, source.Meta, value),
        };
        return new AdvancedRow(group, category, field, editor, nested, nested == null ? "" : Setting(SainMeta.Read(nested).Name));
    }

    private static object? FieldOwner(SAINSettingsClass? slot, FieldInfo category, FieldInfo? nested)
    {
        object? owner = slot == null ? null : category.GetValue(slot);
        return owner == null || nested == null ? owner : nested.GetValue(owner);
    }

    private IEnumerable<(ESainBotDifficulty Difficulty, SAINSettingsClass Settings)> TargetSlots()
    {
        foreach (var difficulty in Difficulties)
        {
            if (_scope.HasValue && _scope.Value != difficulty) continue;
            var slot = Slot(_group, difficulty);
            if (slot != null) yield return (difficulty, slot);
        }
    }

    private void ApplyField(FieldInfo? category, FieldInfo? nested, FieldInfo field, SainMeta meta, object? value)
    {
        if (!EditableViews().Any() || _group == null) return;
        if(IsBatch)
        {
            foreach(var view in EditableViews())
            {
                if(category==null) field.SetValue(view.Group,value);
                else BotSelectionSettings.ApplyField(new[]{view.Group},new BotFieldRow("",category,nested,field),_scope,value!);
            }
            return;
        }
        if (category == null)
        {
            field.SetValue(_group, value);
            return;
        }
        if (_advancedSettings == null) return;
        object? shownOwner = FieldOwner(_advancedSettings, category, nested);
        if (shownOwner == null) return;
        bool numeric = SainValue.Classify(field.FieldType) is SainFieldKind.Float or SainFieldKind.Int;
        double before = numeric ? Convert.ToDouble(field.GetValue(shownOwner), CultureInfo.InvariantCulture) : 0d;
        double after = numeric ? Convert.ToDouble(value, CultureInfo.InvariantCulture) : 0d;
        foreach (var target in TargetSlots())
        {
            object? owner = FieldOwner(target.Settings, category, nested);
            if (owner == null) continue;
            if (numeric && !_scope.HasValue && Math.Abs(before) >= 1e-6d)
            {
                double scaled = Convert.ToDouble(field.GetValue(owner), CultureInfo.InvariantCulture) * (after / before);
                float clamped = meta.Clamp((float)scaled);
                field.SetValue(owner, Convert.ChangeType(clamped, field.FieldType, CultureInfo.InvariantCulture));
            }
            else
            {
                field.SetValue(owner, value);
            }
        }
        field.SetValue(shownOwner, value);
    }

    private Task ResetField(AdvancedRow row) => ChangeTargets(view=>
    {
        var baseline=BotSelectionSettings.Baseline(view.Group,view.Sources);
        if(baseline==null) return;
        if(row.Category==null) row.Field.SetValue(view.Group,row.Field.GetValue(baseline));
        else BotAdvancedEdit.Reset(view.Group,baseline,_scope,new BotFieldRow(row.Group,row.Category,row.Nested,row.Field));
    });

    private string FieldReference(AdvancedRow row)
    {
        if(IsBatch) return T("원래 값은 봇마다 다릅니다", "original differs per bot");
        var baseline=_fieldBaselines.GetValueOrDefault(_botType);
        object? owner = row.Category == null ? baseline : FieldOwner(Slot(baseline,_advancedShown), row.Category, row.Nested);
        return owner == null ? T("기준 없음", "No reference")
            : T("기준값: ", "Reference: ") + FieldText(row.Field.GetValue(owner));
    }

    private static bool Different(object? a, object? b)
        => a is float fa && b is float fb ? Math.Abs(fa - fb) > 1e-4f
            : a is double da && b is double db ? Math.Abs(da - db) > 1e-4d : !Equals(a, b);

    private bool FieldChanged(AdvancedRow row)
    {
        foreach(var view in EditableViews())
        {
            var baseline=_fieldBaselines.GetValueOrDefault(view.Type);
            if(baseline==null) continue;
            if(row.Category==null) { if(Different(row.Field.GetValue(view.Group),row.Field.GetValue(baseline))) return true; }
            else if(BotAdvancedEdit.Changed(view.Group,baseline,_scope,new BotFieldRow(row.Group,row.Category,row.Nested,row.Field))) return true;
        }
        return false;
    }

    private void RefreshSelectionMarks()
    {
        _fieldBaselines.Clear();
        foreach(var view in EditableViews()) _fieldBaselines[view.Type]=BotSelectionSettings.Baseline(view.Group,view.Sources);
        // zzap (2026-10-23, user): say when all four slots hold the same values, mark knobs whose slots differ.
        _allSlotsSame = _group != null && BotQuickSettings.AllSlotsSame(_group);
        _bySlotKnobs.Clear();
        _knobSlotValues.Clear();
        if (_group != null)
        {
            foreach (var knob in BotQuickSettings.All)
            {
                if (BotQuickSettings.DiffersBySlot(knob, _group))
                {
                    _bySlotKnobs.Add(knob.Id);
                    _knobSlotValues[knob.Id] = BotQuickSettings.SlotValues(knob, _group, Korean);
                }
            }
        }
        _changedKnobs.Clear();
        if (_group != null && _selectedView != null)
        {
            foreach (var knob in BotQuickSettings.All)
            {
                // Same rule as F6: only the knob fields a level writes count; personality / grenades are "not affected by the level".
                if (EditableViews().Any(v=>BotQuickSettings.IsChanged(knob,v.Group,_fieldBaselines.GetValueOrDefault(v.Type)!))) _changedKnobs.Add(knob.Id);
            }
        }
        _advancedChanged = 0;
        foreach (var row in _advancedRows)
        {
            row.Changed = FieldChanged(row);
            if (row.Changed) _advancedChanged++;
        }
    }

    private Task NotifyChange() => NotifyBotsChanged(TargetViews().Select(v=>v.Type).ToArray());

    private async Task NotifyBotsChanged(IEnumerable<ESainWildSpawnType> types)
    {
        foreach (var type in types.Distinct()) RefreshLevelView(type);
        Select();
        RefreshFaction();
        await OnChanged.InvokeAsync();
    }

    private void StartCopy()
    {
        _copyTargets.Clear();
        _copySections = _allBots.Where(b => b.Type != _botType).GroupBy(b => b.Section)
            .Select(g => new BotSection(g.Key, g.ToList())).ToList();
        _copying = true;
    }

    private void CancelCopy()
    {
        _copying = false;
        _copyTargets.Clear();
    }

    private void SelectCopyBot(ESainWildSpawnType type, bool selected)
    {
        if (selected && CanEdit(type)) _copyTargets.Add(type);
        else _copyTargets.Remove(type);
    }

    private void SelectCopySection(BotSection section)
    {
        foreach (var bot in section.Bots.Where(b => CanEdit(b.Type))) _copyTargets.Add(bot.Type);
    }

    private async Task CopyToSelectedBots()
    {
        if (_group?.Settings == null) return;
        int count = 0;
        var changed = new List<ESainWildSpawnType>();
        foreach (var type in _copyTargets)
        {
            if (!CanEdit(type) || type == _botType || !Bundle.BotSettings.TryGetValue(type, out var target) || target?.Settings == null) continue;
            bool copied = false;
            foreach (var difficulty in Difficulties)
            {
                var source = Slot(_group, difficulty);
                if (source == null) continue;
                target.Settings[difficulty] = Clone(source);
                copied = true;
            }
            if (copied)
            {
                count++;
                changed.Add(type);
            }
        }
        CancelCopy();
        Snackbar.Add(T($"{count}개 봇에 복사함", (count == 1 ? "Copied to 1 bot type" : $"Copied to {count} bot types")), Severity.Success);
        if (count > 0) await NotifyBotsChanged(changed);
    }

    private static SAINSettingsClass Clone(SAINSettingsClass source)
        => SAINJsonUtil.Deserialize<SAINSettingsClass>(SAINJsonUtil.Serialize(source))!;

    private static double Percent(BotKnob knob, float value)
        => knob.Max <= knob.Min ? 0d : Math.Clamp((knob.ToSlider(value) - knob.Min) / (knob.Max - knob.Min) * 100d, 0d, 100d);
    private static string Css(double value) => value.ToString("0.###", CultureInfo.InvariantCulture);
    private static string LevelName(EBotLevel level) => level switch
    {
        EBotLevel.Easy => T("쉬움", "Easy"), EBotLevel.Normal => T("보통", "Normal"),
        EBotLevel.Hard => T("어려움", "Hard"), EBotLevel.Impossible => T("불가능", "Impossible"), _ => T("직접 설정", "custom"),
    };
    private static string LevelClass(EBotLevel level) => level switch
    {
        EBotLevel.Easy => "easy", EBotLevel.Normal => "normal", EBotLevel.Hard => "hard", EBotLevel.Impossible => "impossible", _ => "custom",
    };
    private static string LevelDescription(EBotLevel level) => level switch
    {
        EBotLevel.Easy => T("여유롭게", "Relaxed"),
        EBotLevel.Normal => T("균형 있게", "Balanced"),
        EBotLevel.Hard => T("긴장감 있게", "Challenging"), _ => T("아주 강하게", "Very tough"),
    };
    private static string MissingLevel(EBotLevel level)
    {
        string preset = level switch { EBotLevel.Easy => "zzap 쉬움", EBotLevel.Normal => "zzap 보통", _ => "zzap" };
        return T($"'{preset}' 프리셋을 찾을 수 없음", $"Cannot find the '{preset}' preset");
    }
    private static string BadgeClass(BotLevelView view)
        => view.Ai.UsesVanilla ? "vanilla" : view.Badge.Custom ? "custom" : LevelClass(view.Badge.Level);
    private static string BadgeText(BotLevelView view)
        => view.Ai.UsesVanilla ? AiText(view.Ai) : view.Badge.Custom ? T("직접 설정", "custom")
            : LevelName(view.Badge.Level) + (view.Badge.Adjusted ? T(" (조정됨)", " (adjusted)") : "");
    private static string PersonalityName(EPersonality personality) => personality == EPersonality.None ? T("지정 안 함", "Unassigned") : Value(personality);
    private static string SectionName(string section) => section switch {
        "Scavs"=>T("스캐브","Scavs"), "PMCs"=>T("PMC","PMCs"), "Goons"=>T("군즈","Goons"),
        "Bosses"=>T("보스","Bosses"), "Followers"=>T("추종자","Followers"), "Other"=>T("기타","Other"),
        "Black Division"=>T("블랙 디비전","Black Division"), "RUAF"=>T("러시아군","RUAF"), "Remnant"=>T("잔당","Remnant"), _=>Setting(section) };
    private string FactionCount(BotSection section) {
        int selected=section.Bots.Count(b=>_selection.Contains(b.Type));
        return selected>0?$"{selected}/{section.Bots.Count}":section.Bots.Count.ToString();
    }
    private static string KnobText(BotKnob knob,SAINSettingsClass? slot) => slot==null ? T("기준 없음","No reference")
        : knob.Kind==BotKnobKind.Toggle ? (knob.GetOn(slot)?T("켬","On"):T("끔","Off"))
        : knob.Kind==BotKnobKind.Personality ? PersonalityName(knob.GetPersonality(slot)) : knob.Format(knob.Get(slot),Korean);
    private static string KnobSectionName(string section) => section switch { "aim" => T("조준", "Aim"), "sense" => T("감각", "Senses"), _ => T("성향", "Mind") };
    private static string AdvancedSectionName(string section) => section switch { "vanilla" => T("게임 기본값", "EFT's own values"), "modifier" => Setting("Difficulty Modifier"), _ => Setting(SainMeta.Read(typeof(SAINSettingsClass).GetField(section)!).Name) };
    private static string FieldText(object? value) => value switch
    {
        bool on => on ? T("켬", "On") : T("끔", "Off"),
        EPersonality personality => PersonalityName(personality),
        float number => number.ToString("0.###", CultureInfo.InvariantCulture),
        double number => number.ToString("0.###", CultureInfo.InvariantCulture),
        _ => Value(value),
    };
}
