@namespace SAINServerMod.Web.Components
@using Microsoft.JSInterop
@inject IJSRuntime JS
@implements IAsyncDisposable

@if (ShowButton) { <button type="button" class="sain-guide-button" title="@T("3단계 안내","3-step guide")" @onclick="Open">?</button> }
@if (!_dismissed && ShowIntro)
{
    <div class="sain-intro">
        <p><strong>@T("처음이라면 여기부터","New here? Start here")</strong>　@T("이름을 누르면 한 봇, ○를 누르면 여러 봇을 함께 조절해요. 손잡이를 움직인 뒤 [저장]을 눌러요.","Click a name to edit one bot, or use ○ to select several. Adjust the knobs, then [Save].")</p>
        <button type="button" @onclick="Open">@T("3단계 안내","3-step guide")</button>
        <button type="button" @onclick="Dismiss">@T("알겠어요","Got it")</button>
    </div>
}
@if (_open)
{
    <div class="sain-modal-overlay">
    <section class="sain-modal" role="dialog" aria-modal="true" aria-labelledby="sain-guide-title" tabindex="-1" @onkeydown="KeyDown">
        <header><h2 id="sain-guide-title">@T("처음 쓰는 사람용 안내","Guide for new users")</h2><button type="button" aria-label="@T("닫기","Close")" @onclick="Close">×</button></header>
        <nav class="sain-guide-steps">@for(int i=1;i<=3;i++) { int step=i; <button type="button" class="@(_step==step?"on":null)" aria-pressed="@(_step==step)" @onclick="() => _step=step">@StepNumber(step) @Titles[step-1]</button> }</nav>
        <div class="sain-help-step"><strong><span>@StepNumber(_step)</span> @Titles[_step-1]</strong><p>@Texts[_step-1]</p></div>
        <p class="sain-guide-progress">@T($"{_step} / 3 단계 · 언제든 오른쪽 위 [?]로 다시 열 수 있어요.",$"Step {_step} / 3 · Reopen this guide anytime with [?] at the top right.")</p>
        <footer>@if(_step>1) { <button type="button" @onclick="() => _step--">@T("이전","Back")</button> }
        @if(_step<3) { <button type="button" class="primary" @onclick="() => _step++">@T("다음","Next")</button> }
        else { <button type="button" class="primary" @onclick="Close">@T("시작할게요","Get started")</button> }</footer>
    </section></div>
}
@code {
    [Parameter] public bool ShowButton { get; set; }=true;
    [Parameter] public bool ShowIntro { get; set; }=true;
    private bool _dismissed, _open;
    private int _step=1;
    private IJSObjectReference? _module;
    private static string StepNumber(int step)=>step==1?"①":step==2?"②":"③";
    private string[] Titles=>new[]{T("봇 고르기","Choose bot types"),T("난이도와 손잡이","Level and knobs"),T("저장 · 슬롯 · 공유","Save · Slots · Sharing")};
    private string[] Texts=>new[]{
        T("이름을 클릭하면 한 봇만 열립니다. 왼쪽 ○ 또는 이름 Ctrl+클릭으로 묶음에 넣으면 ●가 됩니다. 팩션 ○는 그 팩션 전체를 고릅니다. 일부만 선택하면 ◐입니다.","Click a name to open one bot. Use ○ or Ctrl+click a name to add it to the selection. ○ = not selected, ● = selected, ◐ = some. A faction’s ○ selects all its bot types."),
        T("난이도 4개 중 하나를 고른 뒤 9개 손잡이로 조절해요. 묶음의 값이 서로 다르면 ‘섞임’으로 보입니다. 손잡이를 움직이면 같은 값이 모두에게 적용돼요. 노란 세로 금은 zzap 원본 자리, [원래대로]는 그 자리로 돌려요.","Choose one of four Levels, then adjust the nine knobs. Different values in a selection appear as ‘mixed’. Moving a knob applies the same value to all selected bots. The yellow line marks zzap original; [Reset] restores it."),
        T("마음에 드는 값은 [＋ 지금 값 저장]으로 슬롯에 보관해요. ⋯에서 이름 바꾸기·덮어쓰기·삭제·공유를 할 수 있어요. F6와 웹이 같은 슬롯을 씁니다. 바꾼 값은 위의 [저장]을 눌러야 게임에 반영돼요. 기본 zzap 프리셋은 그대로 두고 ‘[Modified]’ 사본으로 저장됩니다.","Keep values you like in a slot with [＋ Save current]. Use ⋯ to Rename, Overwrite, Delete, or share. Custom slots are shared by F6 and the web page. Click [Save] at the top to apply changes in game. Changes are saved as a '[Modified]' copy (the bundled zzap presets stay untouched).")};
    public void Open() { _step=1; _open=true; StateHasChanged(); }
    private void Close()=>_open=false;
    private void KeyDown(KeyboardEventArgs e) { if(e.Key=="Escape") Close(); }
    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if(!firstRender) return;
        try { _module=await JS.InvokeAsync<IJSObjectReference>("import","/SAIN/js/bot-settings.js"); _dismissed=await _module.InvokeAsync<bool>("introDismissed"); StateHasChanged(); } catch(JSException) { }
    }
    private async Task Dismiss() { _dismissed=true; try { if(_module!=null) await _module.InvokeVoidAsync("dismissIntro"); } catch(JSException) { } }
    public async ValueTask DisposeAsync() { if(_module!=null) { try { await _module.DisposeAsync(); } catch(JSDisconnectedException) { } } }
}
