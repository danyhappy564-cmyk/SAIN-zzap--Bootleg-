@namespace SAINServerMod.Web.Components
@using System.Globalization
@using System.Reflection
@using System.Text.Json
@using Microsoft.Extensions.Logging
@using SAIN.Preset.Shared.BotSettings.SAINSettings
@using SAIN.Preset.Shared.Models.Preset.Personalities
@using SAINServerMod.Generation
@using SAINServerMod.Generators
@using SAINServerMod.Utils
@inject ISnackbar Snackbar
@inject PresetGenerationService PresetGeneration
@inject ClientDataStorageService ClientData
@inject ILogger<BotSettingsEditor> Logger

<div class="sain-bot-editor">
    <aside class="spt-panel sain-bot-nav pa-3">
        <MudTextField T="string" Value="_query" ValueChanged="Search" Immediate="true" DebounceInterval="200"
                      Placeholder="@T("봇 이름 검색", "Search bot types")" Variant="Variant.Outlined" Margin="Margin.Dense"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Search" Clearable="true" />
        @foreach (var section in _visibleSections)
        {
            <div class="sain-bot-faction-head @(_selectedFaction == section.Name ? "on" : null)">
                <button type="button" aria-expanded="@(!_collapsedSections.Contains(section.Name))"
                        aria-label="@T($"{SectionName(section.Name)} 접기/펼치기", $"Collapse/expand {SectionName(section.Name)}")"
                        @onclick="() => ToggleSection(section.Name)">@(_collapsedSections.Contains(section.Name) ? "▸" : "▾")</button>
                <button type="button" class="sain-bot-faction-name" aria-pressed="@(_selectedFaction == section.Name)"
                        @onclick="() => SelectFaction(section.Name)">@SectionName(section.Name)</button>
                <span class="spt-muted">@T($"{section.Bots.Count}종", $"{section.Bots.Count} types")</span>
            </div>
            @if (!_collapsedSections.Contains(section.Name))
            {
                @foreach (var bot in section.Bots)
                {
                    var view = _levelViews[bot.Type];
                    <button type="button" class="sain-bot-item @(_selectedFaction == null && _botType == bot.Type ? "on" : null) @(_selectedFaction == section.Name ? "in-faction" : null)"
                            aria-pressed="@(_selectedFaction == null && _botType == bot.Type)" @onclick="() => SelectBot(bot.Type)">
                        <span>@bot.Name</span>
                        <span class="sain-bot-badge @BadgeClass(view)">@BadgeText(view)</span>
                    </button>
                }
            }
        }
        @if (_visibleSections.Count == 0)
        {
            <MudText Typo="Typo.caption" Class="spt-muted">@T("맞는 봇 종류가 없습니다.", "No matching bot types.")</MudText>
        }
    </aside>

    <div class="spt-panel sain-bot-main pa-3">
        @if (_selectedFaction != null)
        {
            <div class="sain-bot-heading">
                <MudText Typo="Typo.h6">@T($"{SectionName(_selectedFaction)} 전체 ({_factionBots.Count}종)", $"All of {SectionName(_selectedFaction)} ({_factionBots.Count})")</MudText>
                <div class="sain-bot-actions">
                    @if (_factionBots.Any(b => SavedGroup(b.Type) != null))
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="RevertFaction">@T("되돌리기", "Revert")</MudButton>
                    }
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning" OnClick="ResetFaction">@T("원본 사용", "Use original")</MudButton>
                </div>
            </div>
            <div class="sain-bot-ai">
                <b>AI</b>
                <button type="button" class="sain-refchip @(_factionVanilla == false ? "on" : null)" aria-pressed="@(_factionVanilla == false)" @onclick="() => SetFactionAI(false)">SAIN</button>
                <button type="button" class="sain-refchip @(_factionVanilla == true ? "on" : null)" aria-pressed="@(_factionVanilla == true)" @onclick="() => SetFactionAI(true)">@T("게임 기본 (바닐라)", "EFT's own (vanilla)")</button>
                @if (!_factionVanilla.HasValue && _factionBots.Count > 0)
                {
                    <span class="spt-muted">@T("섞임", "mixed")</span>
                }
            </div>
            <div class="sain-bot-help spt-muted">@T("게임 재시작 후 적용 · 전역 설정의 '바닐라 …' 묶음이 켜져 있으면 그쪽이 우선합니다", "Applies after a game restart · a global 'Vanilla …' group toggle wins")</div>
            <div class="sain-bot-levels @(_factionVanilla == true ? "sain-bot-dim" : null)">
                @foreach (var level in Levels)
                {
                    <button type="button" class="sain-bot-level @LevelClass(level) @(_factionBots.Count > 0 && _factionCounts[level] == _factionBots.Count ? "on" : null)"
                            disabled="@(!_factionAvailable.Contains(level))" title="@(!_factionAvailable.Contains(level) ? MissingLevel(level) : null)"
                            @onclick="() => ApplyFactionLevel(level)">
                        <b>@LevelName(level)</b><small>@LevelDescription(level)</small>
                        <small>@T($"{_factionCounts[level]}종", $"{_factionCounts[level]} types")</small>
                    </button>
                }
            </div>
            <div class="sain-bot-help spt-muted">@T("행동(문 전술 등)은 성격과 전역 설정을 따릅니다", "Behaviour (door tactics etc.) follows the personality and global settings")</div>
            <table class="sain-bot-table">
                <thead><tr><th>@T("봇 이름", "Bot name")</th><th>@T("난이도", "Level")</th><th>AI</th></tr></thead>
                <tbody>
                    @foreach (var bot in _factionBots)
                    {
                        var view = _levelViews[bot.Type];
                        <tr>
                            <td><button type="button" @onclick="() => SelectBot(bot.Type)">@bot.Name</button></td>
                            <td><span class="sain-bot-badge @BadgeClass(view)">@BadgeText(view)</span></td>
                            <td>@(view.Group.UseVanillaAI ? T("게임 기본 (바닐라)", "EFT's own (vanilla)") : "SAIN")</td>
                        </tr>
                    }
                </tbody>
            </table>
            <div class="sain-bot-help spt-muted mt-3">@T("손잡이는 봇을 하나 골라서", "Knobs: pick one bot")</div>
        }
        else if (_group == null || _selectedView == null)
        {
            <MudText Typo="Typo.body2" Class="spt-muted">@T("편집할 봇 설정이 없습니다.", "No bot settings to edit.")</MudText>
        }
        else if (_copying)
        {
            <MudText Typo="Typo.h6">@T("복사할 봇 고르기", "Pick bots to copy to")</MudText>
            <MudText Typo="Typo.caption" Class="spt-muted">@T($"{BotName}의 난이도 4칸 값을 복사합니다.", $"Copies all 4 difficulty slots from {BotName}.")</MudText>
            <div class="sain-bot-copy-list">
                @foreach (var section in _copySections)
                {
                    <div class="sain-bot-copy-head">
                        <h3 class="sain-bot-section">@SectionName(section.Name)</h3>
                        <MudButton Size="Size.Small" OnClick="() => SelectCopySection(section)">@T("전부 선택", "Select all")</MudButton>
                    </div>
                    @foreach (var bot in section.Bots)
                    {
                        <MudCheckBox T="bool" Value="_copyTargets.Contains(bot.Type)" ValueChanged="v => SelectCopyBot(bot.Type, v)"
                                     Label="@bot.Name" Color="Color.Primary" Dense="true" />
                    }
                }
            </div>
            <MudStack Row Spacing="2" Class="mt-3">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(_copyTargets.Count == 0)" OnClick="CopyToSelectedBots">@T("복사", "Copy")</MudButton>
                <MudButton Variant="Variant.Outlined" OnClick="CancelCopy">@T("취소", "Cancel")</MudButton>
            </MudStack>
        }
        else
        {
            <div class="sain-bot-heading">
                <div class="sain-bot-actions">
                    <MudText Typo="Typo.h6">@BotName</MudText>
                    <span class="sain-bot-badge @BadgeClass(_selectedView)">@BadgeText(_selectedView)</span>
                </div>
                <div class="sain-bot-actions">
                    @if (SavedGroup(_botType) != null)
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="RevertBot">@T("되돌리기", "Revert")</MudButton>
                    }
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning" OnClick="ResetBot">@T("원본 사용", "Use original")</MudButton>
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.ContentCopy" OnClick="StartCopy">
                        @T("이 봇 설정을 다른 봇에 복사", "Copy this bot to other bots")
                    </MudButton>
                </div>
            </div>
            <div class="sain-bot-ai">
                <b>@T("이 봇의 AI", "This bot's AI")</b>
                <button type="button" class="sain-refchip @(!_group.UseVanillaAI ? "on" : null)" aria-pressed="@(!_group.UseVanillaAI)" @onclick="() => SetBotAI(false)">SAIN</button>
                <button type="button" class="sain-refchip @(_group.UseVanillaAI ? "on" : null)" aria-pressed="@_group.UseVanillaAI" @onclick="() => SetBotAI(true)">@T("게임 기본 (바닐라)", "EFT's own (vanilla)")</button>
            </div>
            <div class="sain-bot-help spt-muted">@T("게임 재시작 후 적용 · 전역 설정의 '바닐라 …' 묶음이 켜져 있으면 그쪽이 우선합니다", "Applies after a game restart · a global 'Vanilla …' group toggle wins")</div>
            <div class="@(_group.UseVanillaAI ? "sain-bot-dim" : null)">
            <div class="sain-bot-levels">
                @foreach (var level in Levels)
                {
                    <button type="button" class="sain-bot-level @LevelClass(level) @(_selectedView.Badge.Level == level ? "on" : null)"
                            aria-pressed="@(_selectedView.Badge.Level == level)" disabled="@(!_selectedView.Available.Contains(level))"
                            title="@(!_selectedView.Available.Contains(level) ? MissingLevel(level) : null)" @onclick="() => ApplyBotLevel(level)">
                        <b>@LevelName(level)</b><small>@LevelDescription(level)@(_selectedView.Badge.Level == level ? T(" · 지금", " · now") : "")</small>
                    </button>
                }
            </div>
            @if (_selectedView.AdjustedCount > 0)
            {
                <div class="sain-bot-warning">@T($"⚠ 손으로 조정한 값이 {_selectedView.AdjustedCount}개 있습니다 — 다른 난이도를 누르면 그 단계 값으로 바뀝니다", $"⚠ {_selectedView.AdjustedCount} hand-adjusted value(s) - another level replaces them with that level's values")</div>
            }
            <div class="sain-bot-help spt-muted">@T("행동(문 전술 등)은 성격과 전역 설정을 따릅니다", "Behaviour (door tactics etc.) follows the personality and global settings")</div>

            @if (_settings == null)
            {
                <MudText Typo="Typo.body2" Class="spt-muted mb-3">@T("이 봇에는 편집할 난이도 칸이 없습니다.", "This bot has no difficulty slots to edit.")</MudText>
            }
            else
            {
                <div class="sain-bot-shown spt-muted">@T("오른쪽으로 갈수록 강하게", "Stronger to the right")</div>
                @foreach (var section in KnobSections)
                {
                    <div class="sain-quick-head mt-3">
                        <MudText Typo="Typo.subtitle2" Class="spt-title">@KnobSectionName(section.Name)</MudText>
                    </div>
                    @foreach (var knob in section.Knobs)
                    {
                        float current = knob.Get(_settings);
                        float baseline = _referenceSettings == null ? current : knob.Get(_referenceSettings);
                        int direction = knob.Direction(current, baseline);
                        double currentPos = Percent(knob, current);
                        double referencePos = Percent(knob, baseline);
                        <div class="sain-qrow sain-bot-knob" @key="knob.Id">
                            <div class="sain-bot-knob-label">
                                <span class="sain-qrow-name">@knob.Name(Korean)</span>
                                @if (knob.Kind is BotKnobKind.Personality or BotKnobKind.Toggle)
                                {
                                    <span class="sain-bot-byslot">@T("난이도와 무관", "Not affected by the level")</span>
                                }
                                <div class="sain-quick-desc">@knob.Help(Korean)</div>
                            </div>
                            <div class="sain-bot-knob-control">
                                @if (knob.Kind is BotKnobKind.Toggle or BotKnobKind.ToggleNumber)
                                {
                                    <MudSwitch T="bool" Value="knob.GetOn(_settings)" ValueChanged="v => SetToggle(knob, v)" Color="Color.Primary"
                                               Label="@(knob.GetOn(_settings) ? T("켬", "On") : T("끔", "Off"))" />
                                }
                                @if (knob.Kind == BotKnobKind.Personality)
                                {
                                    <MudSelect T="EPersonality" Value="knob.GetPersonality(_settings)" ValueChanged="p => SetPersonality(knob, p)"
                                               Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" aria-label="@knob.Name(Korean)">
                                        @foreach (var personality in Personalities)
                                        {
                                            <MudSelectItem T="EPersonality" Value="personality">@PersonalityName(personality)</MudSelectItem>
                                        }
                                    </MudSelect>
                                }
                                @if (knob.Kind is BotKnobKind.Number or BotKnobKind.ToggleNumber)
                                {
                                    <div class="sain-quick-slider sain-diffslider sain-bot-slider">
                                        <div class="sain-dl">
                                            <span class="t"></span>
                                            <span class="b" style="width:@(Css(Math.Min(currentPos, referencePos)))%"></span>
                                            @if (_referenceSettings != null)
                                            {
                                                @if (direction != 0)
                                                {
                                                    <span class="d @(direction > 0 ? "up" : "down")" style="left:@(Css(Math.Min(currentPos, referencePos)))%;width:@(Css(Math.Abs(currentPos - referencePos)))%"></span>
                                                }
                                                <span class="r" style="left:@(Css(referencePos))%" title="@knob.Format(baseline, Korean)"></span>
                                            }
                                        </div>
                                        <MudSlider T="double" Min="knob.Min" Max="knob.Max" Step="knob.Step" Value="Math.Round(knob.ToSlider(current), 3)"
                                                   ValueChanged="v => SetNumber(knob, knob.Round(knob.FromSlider((float)v)))" Color="Color.Default" Immediate="true" aria-label="@knob.Name(Korean)" />
                                    </div>
                                }
                            </div>
                            <div class="sain-qrow-delta sain-bot-delta">
                                @if (_referenceSettings == null)
                                {
                                    <span class="sain-qref">@T("기준 없음", "No reference")</span>
                                }
                                @if (knob.Kind is BotKnobKind.Number or BotKnobKind.ToggleNumber)
                                {
                                    @if (_referenceSettings != null)
                                    {
                                        <span class="dir @(direction > 0 ? "up" : direction < 0 ? "down" : "same")">@knob.DeltaText(current, baseline, Korean)</span>
                                    }
                                    <div><span class="ref">@knob.Format(baseline, Korean)</span> → <b>@knob.Format(current, Korean)</b></div>
                                }
                                @if (knob.Kind is BotKnobKind.Toggle or BotKnobKind.ToggleNumber or BotKnobKind.Personality)
                                {
                                    @if (_referenceSettings != null)
                                    {
                                        <span class="sain-qref">@ChoiceReference(knob)</span>
                                    }
                                    @if (knob.Kind == BotKnobKind.Personality)
                                    {
                                        <div>@PersonalityName(knob.GetPersonality(_settings))</div>
                                    }
                                }
                            </div>
                            <div class="sain-bot-reset">
                                @if (_changedKnobs.Contains(knob.Id))
                                {
                                    <MudButton Size="Size.Small" Color="Color.Warning" OnClick="() => ResetKnob(knob)">@T("되돌리기", "Reset")</MudButton>
                                }
                            </div>
                        </div>
                    }
                }
            }

            <button type="button" class="sain-bot-advanced" aria-expanded="@_advancedOpen" @onclick="() => _advancedOpen = !_advancedOpen">
                @(_advancedOpen ? "▾" : "▸") @T($"고급 — 숫자 전부 보기 ({_advancedRows.Count}개 · 바꾼 값 {_advancedChanged}개)", $"Advanced - every number ({_advancedRows.Count} · {_advancedChanged} changed)")
            </button>
            @if (_advancedOpen)
            {
                <MudText Typo="Typo.subtitle2" Class="spt-title mt-3">@T("난이도별로 따로 바꾸기", "Per-difficulty editing")</MudText>
                <div class="sain-refbar sain-bot-scope">
                    <button type="button" class="sain-refchip @(!_scope.HasValue ? "on" : null)" aria-pressed="@(!_scope.HasValue)" @onclick="() => SelectScope(null)">@T("난이도 4칸 전부", "All 4 difficulties")</button>
                    @foreach (var difficulty in Difficulties)
                    {
                        bool seen = _records[_botType].Totals.ContainsKey(difficulty);
                        <button type="button" class="sain-refchip @(_scope == difficulty ? "on" : null) @(!seen ? "sain-bot-unseen" : null)"
                                aria-pressed="@(_scope == difficulty)" @onclick="() => SelectScope(difficulty)">
                            @Value(difficulty)@(!seen ? T(" (안 나옴)", " (not seen)") : "")
                        </button>
                    }
                </div>
                <div class="sain-bot-shown spt-muted">@_records[_botType].Detail</div>
                <div class="sain-bot-shown spt-muted">@ScopeLine</div>
                <div class="sain-bot-shown spt-muted">@(_allSlotsSame ? T("4칸 같음", "All 4 slots match") : T("칸마다 다름", "Differs by slot"))</div>
                @foreach (var knob in BotQuickSettings.All.Where(k => _bySlotKnobs.Contains(k.Id)))
                {
                    <div class="sain-bot-shown spt-muted">
                        @knob.Name(Korean):
                        <span class="sain-bot-slots">
                            @foreach (var slot in _knobSlotValues[knob.Id])
                            {
                                <span class="@(slot.Difficulty == _advancedShown ? "on" : null)">@Value(slot.Difficulty) @slot.Text</span>
                            }
                        </span>
                    </div>
                }
                @if (_advancedSettings == null)
                {
                    <MudText Typo="Typo.body2" Class="spt-muted mt-2">@T("이 난이도 칸에는 설정이 없습니다. 다른 칸을 골라 주세요.", "No settings in this difficulty slot. Pick another slot.")</MudText>
                }
                @foreach (var section in _advancedSections)
                {
                    <MudText Typo="Typo.subtitle2" Class="spt-title mt-3 mb-1">@section.Label</MudText>
                    @foreach (var row in section.Rows)
                    {
                        <div class="sain-bot-advanced-row" @key="row">
                            @if (row.Nested != null)
                            {
                                <div class="sain-bot-field-help spt-muted">@row.Context</div>
                            }
                            <SainFieldEditor Value="row.Editor" OnChanged="NotifyChange" />
                            @if (!string.IsNullOrWhiteSpace(row.Editor.Meta.Description))
                            {
                                <div class="sain-bot-field-help spt-muted">@Setting(row.Editor.Meta.Description)</div>
                            }
                            <div class="sain-bot-field-reference">
                                <span class="sain-qref">@FieldReference(row)</span>
                                @if (row.Category == null)
                                {
                                    <span class="spt-muted">@T("봇 종류 전체에 적용", "Applies to this whole bot type")</span>
                                }
                                @if (row.Changed)
                                {
                                    <span class="sain-diff">●</span>
                                    <MudButton Size="Size.Small" Color="Color.Warning" OnClick="() => ResetField(row)">@T("되돌리기", "Reset")</MudButton>
                                }
                            </div>
                        </div>
                    }
                }
            }
            </div>
        }
    </div>
</div>

<style>
    /* zzap (2026-10-23): local bot page layout; the existing sain-q* rules draw the reference bars. */
    .sain-bot-editor { display: grid; grid-template-columns: 260px minmax(0, 1fr); gap: 16px; align-items: start; }
    .sain-bot-nav { max-height: 78vh; overflow-y: auto; }
    .sain-bot-main { min-width: 0; }
    .sain-bot-section { font-size: .75rem; color: #a1a1aa; margin: 14px 0 6px; }
    .sain-bot-item { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 5px; width: 100%; padding: 8px; border: 1px solid transparent; border-radius: 5px; background: transparent; color: inherit; text-align: left; font-size: .85rem; cursor: pointer; }
    .sain-bot-item:hover { background: #27272a; }
    .sain-bot-item.on { background: #203d57; border-color: #39749d; }
    .sain-bot-badge { border-radius: 10px; padding: 1px 6px; background: #303038; color: #a1a1aa; font-size: .65rem; }
    .sain-bot-badge.easy { background: #1f3b4d; color: #9fd3f5; }
    .sain-bot-badge.normal, .sain-bot-badge.vanilla { background: #303038; color: #cfd6e2; }
    .sain-bot-badge.hard { background: #4d3a1f; color: #f5c98f; }
    .sain-bot-badge.impossible { background: #4d1f24; color: #f59aa3; }
    .sain-bot-badge.custom { background: #352742; color: #d4b1ed; }
    .sain-bot-faction-head { display: flex; align-items: center; gap: 5px; margin-top: 10px; border-radius: 5px; font-size: .75rem; }
    .sain-bot-faction-head button, .sain-bot-table button { border: 0; background: transparent; color: inherit; cursor: pointer; padding: 6px; text-align: left; }
    .sain-bot-faction-head .sain-bot-faction-name { flex: 1; font-weight: 700; }
    .sain-bot-faction-head.on { background: #203d57; }
    .sain-bot-item.in-faction { background: #22303f; }
    .sain-bot-actions, .sain-bot-ai { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; }
    .sain-bot-ai { margin: 12px 0 4px; padding: 8px; border: 1px solid #3f3f46; border-radius: 6px; }
    .sain-bot-levels { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 8px; margin: 12px 0 6px; }
    .sain-bot-level { padding: 10px 6px; border: 1px solid #52525b; border-radius: 6px; color: inherit; background: transparent; cursor: pointer; }
    .sain-bot-level small { display: block; color: #a1a1aa; margin-top: 3px; }
    .sain-bot-level.easy.on { background: #1f3b4d; border-color: #6caad1; }
    .sain-bot-level.normal.on { background: #303038; border-color: #a1a1aa; }
    .sain-bot-level.hard.on { background: #4d3a1f; border-color: #e8b04a; }
    .sain-bot-level.impossible.on { background: #4d1f24; border-color: #d96c78; }
    .sain-bot-level:disabled { opacity: .45; cursor: not-allowed; }
    .sain-bot-dim { opacity: .55; }
    .sain-bot-help { font-size: .75rem; }
    .sain-bot-warning { color: #f5c98f; font-size: .8rem; margin: 8px 0; }
    .sain-bot-table { width: 100%; border-collapse: collapse; margin-top: 12px; font-size: .85rem; }
    .sain-bot-table th, .sain-bot-table td { padding: 8px 6px; text-align: left; border-bottom: 1px solid #3f3f46; }
