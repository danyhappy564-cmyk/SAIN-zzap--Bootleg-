@namespace SAINServerMod.Web.Components
<div class="sain-refbar">
    <span class="sain-refbar-label">@T("비교 기준", "Compare with")</span>
    @foreach (string name in Ordered())
    {
        <button type="button" class="sain-refchip @(Value == name ? "on" : null)" aria-pressed="@(Value == name)" @onclick="() => ValueChanged.InvokeAsync(name)">@QuickSettings.ReferenceLabel(name, Korean)</button>
    }
    <span class="sain-refbar-legend"><span class="sw tick"></span>@T("기준 위치", "reference") <span class="sw up"></span>@T("수치 증가", "higher value") <span class="sw down"></span>@T("수치 감소", "lower value")</span>
</div>
@code {
    [Parameter] public IEnumerable<string> Names { get; set; } = Array.Empty<string>();
    [Parameter] public string Value { get; set; } = "zzap";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }

    // Easy / Normal / zzap (Hard) / Saved, same as F6 (user 2026-11-04); the sim-only TEST preset is not offered.
    private IEnumerable<string> Ordered()
    {
        var names = Names.ToHashSet();
        return QuickSettings.ReferenceOrder.Where(n => n.Length == 0 || names.Contains(n));
    }
}
