@namespace SAINServerMod.Web.Components
@using SAIN.Preset.Shared.BotSettings.SAINSettings
@using SAINServerMod.Generation
@using Microsoft.JSInterop
@inject ClientDataStorageService ClientData
@inject IJSRuntime JS
@implements IAsyncDisposable

<section class="sain-custom-slots">
    <div class="sain-slot-buttons"><strong>@T("내 설정","Custom")</strong>
    @if(_slots!=null) {
        @for(int i=0;i<_slots.Slots.Count;i++) {
            int index=i; var slot=_slots.Slots[i];
            <div class="sain-slot">
                @* 11/07: empty slots read "＋ 빈 칸 N" (they looked like a saved "내 설정 N") and clicking one saves the current values there *@
                <button type="button" class="@(slot==null?"sain-slot-empty":null)" disabled="@(slot==null && Source==null)"
                        title="@(slot==null?T("비어 있음 — 누르면 지금 값을 이 칸에 저장","Empty — click to save the current values here"):T($"누르면 적용(값 {slot.Fields.Count}개)",$"Click to apply ({slot.Fields.Count} values)"))"
                        @onclick="() => slot==null ? SaveAt(index) : Apply(slot)">@(slot?.Name??T($"＋ 빈 칸 {i+1}",$"＋ Empty {i+1}"))</button>
                @if(slot!=null) {
                <button type="button" class="sain-slot-more" aria-label="@T("내 설정 관리","Manage custom slot")" aria-expanded="@(_menu==index)" @onclick="() => Open(index)">⋯</button>
                @if(_menu==index && !_rename && !_import && _code.Length==0) {
                    <div class="sain-slot-menu" role="menu">
                        <button type="button" role="menuitem" disabled="@(slot==null)" @onclick="() => _rename=true">@T("이름 바꾸기","Rename")</button>
                        <button type="button" role="menuitem" disabled="@(slot==null || Source==null)" @onclick="() => Save(s=>s.Slots[index]=BotSettingsSlots.Capture(s.Slots[index].Name,Source!,Sources!))">@T("덮어쓰기","Overwrite")</button>
                        <button type="button" role="menuitem" disabled="@(slot==null)" @onclick="() => Save(s=>s.Delete(index))">@T("삭제","Delete")</button>
                        <button type="button" role="menuitem" disabled="@(slot==null)" @onclick="Copy">@T("공유 코드 복사","Copy share code")</button>
                    </div>
                }
                }
            </div>
        }
        <button type="button" disabled="@(Source==null || _slots.Slots.Count==9 && _slots.Slots.All(s=>s!=null))" @onclick="SaveCurrent">@T("＋ 지금 값 저장","＋ Save current")</button>
        <button type="button" @onclick="StartImport">@T("공유 코드 붙여넣기","Paste share code")</button>
    }
    </div>
    <p class="sain-slot-note">@T("F6와 웹은 같은 내 설정 슬롯을 함께 씁니다.","Custom slots are shared by F6 and the web page.") @(MixedSource==null?T("슬롯을 누르면 지금 편집 중인 봇에 적용됩니다.","Click a slot to apply it to the bots being edited."):T($"섞인 값 저장 시 {MixedSource} 값을 저장합니다.",$"When values are mixed, {MixedSource} values are saved."))</p>
    @if(!string.IsNullOrEmpty(_message)) { <p role="status">@_message</p> }
</section>
@if(_rename || _import || _code.Length>0) {
    <div class="sain-modal-overlay"><section class="sain-modal" role="dialog" aria-modal="true" aria-labelledby="sain-slot-dialog-title" tabindex="-1" @onkeydown="KeyDown">
        <header><h2 id="sain-slot-dialog-title">@(_rename?T("내 설정 이름 바꾸기","Rename custom slot"):_import?T("공유 코드 붙여넣기","Paste share code"):T("공유 코드 복사","Copy share code"))</h2><button type="button" aria-label="@T("닫기","Close")" @onclick="Close">×</button></header>
        @if(_rename) {
            <label for="sain-slot-name">@T("새 이름", "New name") <small>@T("최대 24자", "Up to 24 characters")</small></label>
            <input id="sain-slot-name" maxlength="24" @bind="_name" />
        } else {
            <p>@(_import?T("공유 코드를 붙여 넣으면 새 내 설정 슬롯이 생깁니다.","Paste a share code to create a new custom slot."):T("다른 화면에서 붙여넣으면 같은 슬롯이 생깁니다.","Paste it into another view to create the same slot."))</p>
            <textarea @ref="_codeBox" aria-label="@T("공유 코드","Share code")" @bind="_code" @bind:event="oninput" readonly="@(!_import)" rows="5" spellcheck="false"></textarea>
            @if(!_import) { <p class="sain-slot-note">@T("복사가 허용되지 않는 브라우저에서는 코드를 선택하고 Ctrl+C를 눌러 주세요.","If your browser blocks copying, select the code and press Ctrl+C.")</p> }
        }
        <p role="status">@_message</p>
        <footer><button type="button" @onclick="Close">@T("닫기","Close")</button>
            @if(_rename) { <button type="button" class="primary" @onclick="() => Save(s=>s.Rename(_menu,_name))">@T("이름 바꾸기","Rename")</button> }
            else if(_import) { <button type="button" class="primary" @onclick="Import">@T("새 슬롯 만들기","Create new slot")</button> }
            else { <button type="button" class="primary" @onclick="Copy">@T("코드 복사","Copy code")</button> }
        </footer>
    </section></div>
}
@code {
    [Parameter] public SAINSettingsGroupClass? Source { get; set; }
    [Parameter] public LevelSources? Sources { get; set; }
    [Parameter] public EventCallback<BotSettingsSlot> OnApply { get; set; }
    [Parameter] public string? MixedSource { get; set; }
    private bool _rename;
    private BotSettingsSlots? _slots;
    private int _menu=-1;
    private string _name="", _code="", _message="";
    private bool _import, _selectCode;
    private ElementReference _codeBox;
    private IJSObjectReference? _module;
    protected override async Task OnInitializedAsync()
    {
        try { _slots=BotSettingsSlots.Deserialize(await ClientData.GetAsync(BotSettingsSlots.DataKey)); }
        catch { _message=T("내 설정을 불러오지 못했습니다. 다시 열어 주세요.","Could not load custom slots. Reopen this page."); }
    }
    private Task Apply(BotSettingsSlot? slot)
    {
        if(slot!=null) return OnApply.InvokeAsync(slot);
        _message=T("비어 있음 — ＋로 저장","Empty — use ＋ to save"); return Task.CompletedTask;
    }
    private void StartImport() { _rename=false; _import=true; _code=""; _menu=-1; }
    private void Close() { _rename=false; _import=false; _code=""; _menu=-1; }
    private void KeyDown(KeyboardEventArgs e) { if(e.Key=="Escape") Close(); }
    private void Open(int index) { _menu=_menu==index?-1:index; _name=_slots!.Slots[index]?.Name??""; _rename=false; _import=false; _code=""; }
    private async Task Save(Action<BotSettingsSlots> change)
    {
        try
        {
            var next=BotSettingsSlots.Deserialize(_slots!.Serialize()); change(next);
            await ClientData.SaveAsync(BotSettingsSlots.DataKey,next.Serialize());
            int before=_slots.Slots.Count(s=>s!=null), after=next.Slots.Count(s=>s!=null);
            string? changed=next.Slots.FirstOrDefault(s=>s!=null && !_slots.Slots.Any(o=>o!=null && o.CreatedUtc==s.CreatedUtc))?.Name;
            _slots=next; Close();
            _message=after<before?T("내 설정 칸을 비웠습니다.","Custom slot cleared.")
                :changed!=null?T($"'{changed}' 칸에 저장했습니다. {DateTime.Now:HH:mm:ss}",$"Saved to '{changed}' at {DateTime.Now:HH:mm:ss}")
                :T($"내 설정을 저장했습니다. {DateTime.Now:HH:mm:ss}",$"Custom slots saved at {DateTime.Now:HH:mm:ss}");
        }
        catch { _message=T("저장하지 못했습니다. 이름과 슬롯 수(최대 9칸)를 확인하세요.","Could not save. Check the name, or the 9-slot limit."); }
    }
    private Task SaveAt(int index) => Save(s=>s.Slots[index]=BotSettingsSlots.Capture(T($"내 설정 {index+1}",$"Custom {index+1}"),Source!,Sources!));
    private Task SaveCurrent() => Save(s=>
    {
        int index=s.Slots.FindIndex(slot=>slot==null); if(index<0) index=s.Slots.Count;
        if(s.Add(BotSettingsSlots.Capture(T($"내 설정 {index+1}",$"Custom {index+1}"),Source!,Sources!))<0) throw new InvalidOperationException();
    });
    private async Task Import()
    {
        if(!BotSettingsSlots.TryReadShare(_code,out var slot,out int skipped,out var reason)) { _message=BotSettingsSlots.Error(reason,Korean); return; }
        await Save(s=> { if(s.Add(slot)<0) throw new InvalidOperationException(); });
        if(skipped>0) _message+=T($" 모르는 필드 {skipped}개를 건너뛰었습니다.",$" Skipped {skipped} unknown field(s).");
    }
    private async Task Copy()
    {
        try
        {
            _code=BotSettingsSlots.Share(_slots!.Slots[_menu]); _import=false;
            _module??=await JS.InvokeAsync<IJSObjectReference>("import","/SAIN/js/bot-settings.js");
            await _module.InvokeVoidAsync("copy",_code); _message=T("공유 코드를 복사했습니다.","Share code copied.");
        }
        catch(JSException) { _selectCode=true; _message=T("복사하지 못했습니다. 아래 글상자를 선택해 복사하세요.","Couldn't copy. Select the code below and press Ctrl+C."); }
        catch { _message=T("공유 코드를 만들지 못했습니다.","Could not create share code."); }
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if(!_selectCode || _module==null) return;
        _selectCode=false;
        try { await _module.InvokeVoidAsync("selectCode",_codeBox); } catch(JSException) { }
    }
    public async ValueTask DisposeAsync() { if(_module!=null) { try { await _module.DisposeAsync(); } catch(JSDisconnectedException) { } } }
}
