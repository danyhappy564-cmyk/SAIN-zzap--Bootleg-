@namespace SAINServerMod.Web.Components
@using SAIN.Preset.Shared.Models.Preset.Personalities
@using SAIN.Preset.Shared.Personalities.BasePersonality

<div class="sain-editor-body">
<aside class="spt-panel pa-3" style="min-width:190px">
    <MudText Typo="Typo.overline">@T("성격", "Personalities")</MudText>
    @foreach (var key in _keys)
    {
        <MudButton FullWidth="true" Variant="@(key == _selected ? Variant.Filled : Variant.Text)" Color="Color.Primary" OnClick="() => OnSelected(key)">@Value(key)</MudButton>
    }
</aside>
<div class="flex-grow-1">
@if (_settings != null)
{
    @* zzap (2026-10-23): the description comes from code, not from the text an old preset stored (it could be in either language). *@
    @if (!string.IsNullOrWhiteSpace(PersonalitySettingsClass.DescriptionOf(_selected)))
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mb-3">@Setting(PersonalitySettingsClass.DescriptionOf(_selected))</MudAlert>
    }
    <QuickObjectEditor Target="_settings" Original="Saved" OnChanged="OnChanged" />
    <MudExpansionPanels Elevation="0" Class="mt-3"><MudExpansionPanel Text="@T("고급 · 성격의 모든 설정", "Advanced · all personality settings")">
        <SainSectionEditor Target="_settings" Original="Saved" OnChanged="OnChanged" />
    </MudExpansionPanel></MudExpansionPanels>
}
else
{
    <MudText Typo="Typo.caption" Class="spt-muted">@T("이 프리셋에는 성격 데이터가 없습니다.", "This preset has no personality data.")</MudText>
}

</div></div>

@code {
    [Parameter, EditorRequired] public SAINPresetBundle Bundle { get; set; } = default!;
    [Parameter] public SAINPresetBundle? Original { get; set; }
    private PersonalitySettingsClass? Saved => Original?.Personalities.GetValueOrDefault(_selected);
    [Parameter] public EventCallback OnChanged { get; set; }

    private List<EPersonality> _keys = new();
    private EPersonality _selected;
    private PersonalitySettingsClass? _settings;

    protected override void OnParametersSet()
    {
        _keys = Bundle.Personalities.Keys.ToList();
        if (!_keys.Contains(_selected)) _selected = _keys.FirstOrDefault();
        Bundle.Personalities.TryGetValue(_selected, out _settings);
    }

    private void OnSelected(EPersonality key)
    {
        _selected = key;
        Bundle.Personalities.TryGetValue(_selected, out _settings);
    }
}
