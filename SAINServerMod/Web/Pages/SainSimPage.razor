@page "/sain/sim"
@attribute [Authorize(Policy = "Administrator")]
@implements IDisposable
@layout BaseMudBlazorLayout
@using SAINServerMod.SimLab
@inject SimLabService Sim
@inject ISnackbar Snackbar

<PageTitle>@T("SAIN 시뮬레이션", "SAIN Simulation")</PageTitle>
<HeadContent>
    <link rel="stylesheet" href="/SAIN/css/sain.css" />
</HeadContent>

@* zzap fork (2026-10-18, user: "the sim settings are too cluttered"): status tiles, preset cards, switches in groups, rotation table. *@
<div class="spt-page">
    <MudContainer MaxWidth="MaxWidth.False" Class="sain-container pa-4">
        <SainNav Current="sim" />
        <MudPaper Elevation="0" Class="spt-panel sain-hero pa-4 mb-4">
            <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap" Spacing="3">
                <MudStack Row AlignItems="AlignItems.Center" Spacing="3">
                    <div class="sain-hero-icon">
                        <MudIcon Icon="@Icons.Material.Filled.Science" Color="Color.Warning" Size="Size.Large" />
                    </div>
                    <div>
                        <MudText Typo="Typo.h5" Class="spt-title">@T("시뮬레이션 (zzap)", "Simulation (zzap)")</MudText>
                        <MudText Typo="Typo.caption" Class="spt-muted">
                            @T("게임에서 \"zzap TEST [시뮬 전용]\" 프리셋을 쓸 때만 작동합니다.", "Only active while the game uses the \"zzap TEST [시뮬 전용]\" preset.")
                            <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Info" OnClick="@(() => _showHelp = !_showHelp)">@T("사용법", "How to use") @(_showHelp ? "▾" : "▸")</MudButton>
                        </MudText>
                    </div>
                </MudStack>
                <MudStack Row Spacing="2" Wrap="Wrap.Wrap">
                    <MudButton Variant="@(Sim.Running ? Variant.Outlined : Variant.Filled)" Color="@(Sim.Running ? Color.Error : Color.Success)"
                               StartIcon="@(Sim.Running ? Icons.Material.Filled.Stop : Icons.Material.Filled.PlayArrow)" OnClick="ToggleRunning">
                        @(Sim.Running ? T("시뮬 정지", "Stop sim") : T("시뮬 시작", "Start sim"))
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.FiberNew" OnClick="NewRun">@T("새 실행", "New run")</MudButton>
                    <MudButton Href="/sain/sim/analysis" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Analytics">@T("분석 보기", "Analysis")</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Warning" StartIcon="@Icons.Material.Filled.Save" OnClick="Save">@T("저장", "Save")</MudButton>
                </MudStack>
            </MudStack>
        </MudPaper>

        @if (_showHelp)
        {
            <MudPaper Elevation="0" Class="spt-panel pa-4 mb-4">
                <MudText Typo="Typo.body2">
                    @if (Korean)
                    {
                        <span>1. 게임 F6에서 프리셋을 "zzap TEST [시뮬 전용]"으로 고릅니다.<br />
                        2. 게임이 메인 메뉴에 있을 때 이 페이지 위쪽의 <b>"시뮬 시작"</b>을 누르면 10초 안에 카운트다운이 시작되고 아래 순서의 다음 맵이 시작됩니다. 게임을 켜기만 해서는 시작하지 않습니다(게임을 다시 켜면 다시 눌러야 함). "다음으로"도 메뉴에 있는 채로 반영됩니다.<br />
                        3. 맵마다 정한 분이 지나면 레이드가 "생존"으로 끝나고 결과 화면 없이 메뉴로 돌아옵니다. "맵 사이 대기"는 메인 메뉴가 <b>다 뜬 순간부터</b> 셉니다(레이드에서 나오는 시간은 맵마다 달라서). 나오는 도중에는 절대 다음 맵을 시작하지 않습니다.<br />
                        4. 결과는 "분석 보기"에서 확인합니다. 게임을 강제로 꺼도 1분마다 보낸 기록과 PC에 남긴 파일로 어디까지 했는지 남습니다.<br />
                        5. 실제 내 프로필로 레이드를 하므로(경험치·시간 진행), 시뮬 전용 프로필을 쓰는 것을 권장합니다.<br />
                        6. 봇은 서버가 넣어 둔 "예비 분대"를 게임이 살아 있는 봇 수를 보며 하나씩 부릅니다. 최대 수보다 적어지면 보충 간격마다 A/B 중 적은 쪽에 분대를 보냅니다.</span>
                    }
                    else
                    {
                        <span>1. In game, select the "zzap TEST [시뮬 전용]" preset in F6.<br />
                        2. With the game in the main menu, press <b>"Start sim"</b> at the top of this page: the countdown starts within 10 s and the next map below starts. Just launching the game never starts it (press again after restarting the game). "Make next" also applies while in the menu.<br />
                        3. After each map's minutes the raid ends as "Survived" and returns to the menu without the result screens. The "gap between maps" counts from the moment the main menu has <b>fully loaded</b>; nothing starts while the game is still leaving the raid.<br />
                        4. Results are on "Analysis". Even if the game is killed, the per-minute reports and the file on the PC show how far it got.<br />
                        5. Raids run on your real profile (XP, time pass) — a separate sim profile is recommended.<br />
                        6. The server puts "reserve squads" in the raid and the game calls them one by one by the number of living bots: below the max, every refill interval a squad goes to the side with fewer bots.</span>
                    }
                </MudText>
            </MudPaper>
        }

        @* ---------------------------------------------------------------- status *@
        @{
            var plan = Sim.Plan();
            var rotation = Sim.EnabledRotation();
            var beat = Sim.LastBeat;
            bool live = beat != null && beat.Kind is "start" or "beat" && (DateTime.Now - Sim.LastBeatAt).TotalMinutes < 3;
            int errors = beat?.Errors?.Sum(e => e.Count) ?? 0;
        }
        <MudPaper Elevation="0" Class="spt-panel pa-4 mb-4">
            <div class="sain-kpis">
                <div class="sain-kpi @(Sim.Running ? "sain-kpi-g" : Sim.Armed ? "sain-kpi-y" : null)" style="grid-column: span 2;">
                    <div class="sain-kpi-l">@T("상태", "Status")</div>
                    <div class="sain-kpi-v" style="font-size:1.15rem;">@StatusLine()</div>
                    <div class="sain-kpi-s">
                        @(Sim.Armed ? T($"프리셋 {Sim.ArmedPreset} 작동", $"preset {Sim.ArmedPreset} active") : T("꺼짐 — 게임에서 시뮬 프리셋을 고르면 켜짐", "off — pick the sim preset in game"))
                        @if (Sim.LastHello != default)
                        {
                            <span> · @T("게임 마지막 연락", "last contact") @Sim.LastHello.ToString("HH:mm:ss")</span>
                        }
                    </div>
                </div>
                <div class="sain-kpi">
                    <div class="sain-kpi-l">@(live ? T("지금 맵", "Map now") : T("다음 맵", "Next map"))</div>
                    @if (live)
                    {
                        <div class="sain-kpi-v" style="font-size:1.15rem;">@SimLabDefaults.DisplayName(beat!.Map ?? "")</div>
                        <div class="sain-kpi-s">@((beat.RaidSeconds / 60f).ToString("0.0")) / @((beat.PlannedSeconds / 60f).ToString("0"))@T("분", " min")</div>
                        <div class="sain-bar"><i style="width:@(Math.Clamp(beat.RaidSeconds / Math.Max(1f, beat.PlannedSeconds) * 100f, 0f, 100f).ToString("0"))%"></i></div>
                    }
                    else
                    {
                        <div class="sain-kpi-v" style="font-size:1.15rem;">@(plan.NextMap == null ? "-" : SimLabDefaults.DisplayName(plan.NextMap))</div>
                        <div class="sain-kpi-s">@(plan.Minutes.ToString("0"))@T("분", " min") · @T("맵 사이 대기", "gap") @(Sim.Config.GapSeconds)@T("초", " s")</div>
                    }
                </div>
                <div class="sain-kpi">
                    <div class="sain-kpi-l">@T("생존 봇 / 사망", "Alive / deaths")</div>
                    <div class="sain-kpi-v">@(beat?.AliveBots ?? 0) <small>/ @(beat?.BotDeaths ?? 0)</small></div>
                    <div class="sain-kpi-s">@T("마지막 보고", "last report") @(beat == null ? "-" : Sim.LastBeatAt.ToString("HH:mm:ss"))</div>
                </div>
                <div class="sain-kpi @(beat == null ? null : beat.FpsMin < 30 ? "sain-kpi-r" : "sain-kpi-g")">
                    <div class="sain-kpi-l">FPS</div>
                    <div class="sain-kpi-v">@(beat == null ? "-" : beat.Fps.ToString("0"))</div>
                    <div class="sain-kpi-s">@T("최저", "min") @(beat == null ? "-" : beat.FpsMin.ToString("0"))</div>
                </div>
                <div class="sain-kpi @(errors > 0 ? "sain-kpi-y" : null)">
                    <div class="sain-kpi-l">@T("오류", "Errors")</div>
                    <div class="sain-kpi-v">@errors</div>
                    <div class="sain-kpi-s">@T("실행", "run") @(string.IsNullOrEmpty(Sim.State.RunId) ? "-" : Sim.State.RunId)</div>
                </div>
            </div>
            <MudText Typo="Typo.overline" Class="sain-sec">@T("순회 순서", "ROTATION")</MudText>
            @if (!string.IsNullOrEmpty(plan.Message))
            {
                <MudAlert Severity="Severity.Warning" Dense="true">@T(plan.Message, "No map in the rotation is switched on (turn maps on below).")</MudAlert>
            }
            else
            {
                <div class="sain-mapstep">
                    @for (int i = 0; i < rotation.Count; i++)
                    {
                        var e = rotation[i];
                        bool isNow = live && string.Equals(beat!.Map, e.Map, StringComparison.OrdinalIgnoreCase);
                        string cls = isNow ? "now" : i < plan.Step ? "done" : i == plan.Step ? "next" : string.Empty;
                        <span class="m @cls">@(i + 1) @SimLabDefaults.DisplayName(e.Map) @(e.Minutes.ToString("0"))@T("분", "m")@(isNow ? " ▶" : "")</span>
                    }
                    <span class="sain-kpi-s">· @T($"맵 사이 대기 {Sim.Config.GapSeconds}초", $"{Sim.Config.GapSeconds} s between maps") · @(Sim.Config.StopAfterOneCycle ? T("한 바퀴 돌면 끝", "stops after one cycle") : T("무한 반복", "loops forever"))</span>
                </div>
            }
        </MudPaper>

        @* ---------------------------------------------------------------- sim presets *@
        @{
            var (activePreset, activeModified) = Sim.ActivePreset();
        }
        <MudPaper Elevation="0" Class="spt-panel pa-4 mb-4">
            <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap" Class="mb-2">
                <div>
                    <MudText Typo="Typo.subtitle1" Class="spt-title">@T("시뮬 프리셋", "Sim presets")</MudText>
                    <MudText Typo="Typo.caption" Class="spt-muted">@T("맵 순서 · 스폰 · 성격 분포 · 점검 스위치를 한 번에. 적용하면 아래 설정에 그대로 들어가고 다음 시작부터 첫 맵부터 돕니다.", "Map order, spawns, personality mix and check switches in one go. Applying fills the settings below; the next start begins at its first map.")</MudText>
                </div>
                <span class="sain-tagchip @(activePreset == null ? null : "sain-tag-b")">
                    @(activePreset == null ? T("적용된 프리셋 없음 (직접 설정)", "No preset applied (manual settings)") : T("지금: ", "Now: ") + PresetName(activePreset) + (activeModified ? T(" (수정됨)", " (modified)") : ""))
                </span>
            </MudStack>
            @if (Sim.Running)
            {
                <MudText Typo="Typo.caption" Class="spt-muted d-block mb-2">@T("순회 중에는 적용할 수 없습니다 — 시뮬 정지 후 적용", "Can't apply while running - stop the sim first")</MudText>
            }
            <div class="sain-spgrid">
                @foreach (var p in Sim.Config.Presets)
                {
                    bool isActive = activePreset != null && activePreset.Name == p.Name;
                    var maps = p.Rotation.Where(x => x.Enabled).ToList();
                    <div class="sain-spcard @(isActive ? "sain-spcard-sel" : null)">
                        <div class="sain-spcard-t">
                            @PresetName(p)
                            @if (p.DoorTest)
                            {
                                <span class="sain-tagchip sain-tag-y">@T("문 점검 스위치", "door check")</span>
                            }
                            @if (!p.BuiltIn)
                            {
                                <span class="sain-tagchip">@T("내가 저장", "mine")</span>
                            }
                        </div>
                        <div class="sain-spcard-d">@PresetPurpose(p)</div>
                        <div class="sain-spcard-m">
                            @T($"{maps.Count}맵 · {maps.Sum(x => x.Minutes):0}분", $"{maps.Count} maps · {maps.Sum(x => x.Minutes):0} min") · @PersonalityText(p.Personalities)
                        </div>
                        <MudStack Row Spacing="1" Class="mt-1">
                            @if (isActive && !activeModified)
                            {
                                <span class="sain-tagchip sain-tag-g">@T("적용됨", "Applied")</span>
                            }
                            else
                            {
                                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Info" Disabled="Sim.Running" OnClick="@(() => ApplyPreset(p.Name))">@T("적용", "Apply")</MudButton>
                            }
                            @if (!p.BuiltIn)
                            {
                                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" OnClick="@(() => DeletePreset(p.Name))">@T("삭제", "Delete")</MudButton>
                            }
                        </MudStack>
                    </div>
                }
                <div class="sain-spcard sain-spcard-new">
                    <div class="sain-spcard-t">+ @T("지금 설정을 새 프리셋으로", "Save current settings as a preset")</div>
                    <MudTextField T="string" @bind-Value="_saveName" Label="@T("이름", "Name")" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    <MudTextField T="string" @bind-Value="_savePurpose" Label="@T("무엇을 확인하는 용도인지", "What it is for")" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.SaveAs" OnClick="SavePreset" Class="mt-1">@T("저장", "Save")</MudButton>
                </div>
            </div>
        </MudPaper>

        @* ---------------------------------------------------------------- settings in groups *@
        <MudPaper Elevation="0" Class="spt-panel pa-4 mb-4">
            <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap" Class="mb-3">
                <MudText Typo="Typo.subtitle1" Class="spt-title">@T("설정", "Settings")</MudText>
                <div class="sain-chiprow">
                    <MudText Typo="Typo.caption" Class="spt-muted">@T("켜진 것:", "On:")</MudText>
                    @foreach (var t in Toggles.Where(t => t.Get()))
                    {
                        <span class="sain-tagchip @(t.Group == "check" ? "sain-tag-y" : null)" @onclick="@(() => _group = t.Group)" style="cursor:pointer;">@T(t.ShortKo, t.ShortEn)</span>
                    }
                </div>
            </MudStack>
            <div class="sain-setgrid">
                <div>
                    @foreach (var g in Groups)
                    {
                        var inGroup = Toggles.Where(t => t.Group == g.Id).ToList();
                        <div class="sain-setnav-it @(_group == g.Id ? "on" : null)" @onclick="@(() => _group = g.Id)">
                            <span>@T(g.Ko, g.En)</span>
                            <span class="c">
                                @if (inGroup.Count > 0)
                                {
                                    @T($"{inGroup.Count}개 중 {inGroup.Count(t => t.Get())} 켬", $"{inGroup.Count(t => t.Get())} of {inGroup.Count} on")
                                }
                                else if (g.Id == "personality")
                                {
                                    @Short(PersonalityText(Sim.Config.Personalities), 18)
                                }
                                else if (g.Id == "maps")
                                {
                                    @T($"{Sim.Config.ExcludedMapKeywords.Count}개 제외", $"{Sim.Config.ExcludedMapKeywords.Count} excluded")
                                }
                            </span>
                        </div>
                    }
                </div>
                <div class="sain-setcard">
                    @{ var group = Groups.First(x => x.Id == _group); }
                    <MudText Typo="Typo.subtitle2" Class="spt-title mb-1">@T(group.Ko, group.En)</MudText>
                    @if (!string.IsNullOrEmpty(group.NoteKo))
                    {
                        <MudText Typo="Typo.caption" Class="spt-muted d-block mb-2">@GroupNote(group)</MudText>
                    }
                    @foreach (var t in Toggles.Where(t => t.Group == _group))
                    {
                        string? missing = t.Missing?.Invoke();
                        <div class="sain-trow">
                            <div>
                                <MudText Typo="Typo.body2">
                                    @T(t.Ko, t.En)
                                    @if (t.Recommended)
                                    {
                                        <span class="sain-tagchip sain-tag-g ml-1">@T("권장", "recommended")</span>
                                    }
                                    @if (missing != null)
                                    {
                                        <span class="sain-tagchip sain-tag-r ml-1">@missing</span>
                                    }
                                </MudText>
                                @if (!string.IsNullOrEmpty(t.HelpKo))
                                {
                                    <div class="sain-trow-help">@T(t.HelpKo, t.HelpEn ?? t.HelpKo)</div>
                                }
                            </div>
                            <MudSwitch T="bool" Value="t.Get()" ValueChanged="@(v => t.Set(v))" Color="Color.Primary" />
                        </div>
                    }
                    @if (_group == "spawn")
                    {
                        <MudText Typo="Typo.overline" Class="sain-sec">@T("숫자 (맵별 값이 0이면 이 값)", "NUMBERS (used when a map's own value is 0)")</MudText>
                        <MudStack Row Wrap="Wrap.Wrap" Spacing="2">
                            <MudNumericField T="int" @bind-Value="Sim.Config.MaxAliveBots" Label="@T("동시 최대 봇", "Max bots alive")" Min="2" Max="40" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:150px;" />
                            <MudNumericField T="int" @bind-Value="Sim.Config.SquadSizeMin" Label="@T("분대 최소", "Squad min")" Min="1" Max="6" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:110px;" />
                            <MudNumericField T="int" @bind-Value="Sim.Config.SquadSizeMax" Label="@T("분대 최대", "Squad max")" Min="1" Max="6" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:110px;" />
                            <MudNumericField T="int" @bind-Value="Sim.Config.RespawnSeconds" Label="@T("보충 간격(초)", "Refill (s)")" Min="5" Max="600" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:130px;" />
                            <MudNumericField T="int" @bind-Value="Sim.Config.GapSeconds" Label="@T("맵 사이 대기(초)", "Gap between maps (s)")" Min="0" Max="1800" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:160px;" />
                            <MudNumericField T="float" @bind-Value="Sim.Config.DefaultMinutes" Label="@T("목록에 없는 맵(분)", "Unlisted map (min)")" Min="1" Max="120" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:160px;" />
                        </MudStack>
                    }
                    else if (_group == "personality")
                    {
                        <MudStack Row Wrap="Wrap.Wrap" Spacing="2" AlignItems="AlignItems.Center">
                            <MudTextField T="string" @bind-Value="Sim.Config.Personalities" Label="@T("예: Chad:2,Rat:1 / even / 비우면 SAIN 기본", "e.g. Chad:2,Rat:1 / even / empty = SAIN default")"
                                          Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width:320px;" />
                            <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="@(() => Sim.Config.Personalities = string.Empty)">@T("SAIN 기본", "SAIN default")</MudButton>
                            <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="@(() => Sim.Config.Personalities = "even")">@T("고르게", "Even")</MudButton>
                        </MudStack>
                        <MudText Typo="Typo.caption" Class="spt-muted d-block mt-2">
                            @T($"지금: {PersonalityText(Sim.Config.Personalities)}. 이름: {string.Join(", ", SimLabDefaults.MainPersonalities)}. SAIN 프리셋의 성격 강제(Force Personality)가 켜져 있으면 그게 먼저.",
                               $"Now: {PersonalityText(Sim.Config.Personalities)}. Names: {string.Join(", ", SimLabDefaults.MainPersonalities)}. A SAIN preset's Force Personality wins.")
                        </MudText>
                    }
                    else if (_group == "maps")
                    {
                        <MudTextField T="string" Value="@string.Join(", ", Sim.Config.ExcludedMapKeywords)" ValueChanged="SetExcluded"
                                      Label="@T("제외할 맵 (이름에 포함된 단어, 쉼표로 구분)", "Excluded maps (words in the map id, comma separated)")" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    }
                </div>
            </div>
        </MudPaper>

        @* ---------------------------------------------------------------- rotation table *@
        <MudPaper Elevation="0" Class="spt-panel pa-4 mb-4">
            <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap" Class="mb-1">
                <div>
                    <MudText Typo="Typo.subtitle1" Class="spt-title">@T("맵 순서와 시나리오", "Map order and scenarios")</MudText>
                    <MudText Typo="Typo.caption" Class="spt-muted">@T("위에서부터 차례로 진행합니다. 켜진 맵만 돕니다. '편집'을 누르면 그 줄 아래에 시나리오 이름·구역·스폰 속도가 펼쳐집니다.", "Played from the top; only maps switched on are played. 'Edit' opens the scenario name, zones and spawn pace under the row.")</MudText>
                </div>
                <MudStack Row Spacing="2" AlignItems="AlignItems.Center">
                    <MudSwitch T="bool" @bind-Value="_showOff" Color="Color.Primary" Label="@T($"꺼진 맵 보기 ({Sim.Config.Rotation.Count(x => !x.Enabled)})", $"Show maps that are off ({Sim.Config.Rotation.Count(x => !x.Enabled)})")" />
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.RestartAlt" OnClick="ResetDefaults">@T("순서·시나리오 기본값 복원", "Reset order and scenarios")</MudButton>
                </MudStack>
            </MudStack>
            <div class="sain-table-wrap">
                <table class="sain-compare sain-changes sain-rows">
                    <thead>
                        <tr><th style="width:78px;">@T("순서", "Order")</th><th style="width:60px;">@T("켬", "On")</th><th>@T("맵", "Map")</th><th style="width:110px;">@T("분", "Min")</th><th>@T("시나리오", "Scenario")</th><th>@T("스폰 속도", "Spawn pace")</th><th>A vs B</th><th style="width:200px;"></th></tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Sim.Config.Rotation.Count; i++)
                        {
                            int index = i;
                            var entry = Sim.Config.Rotation[index];
                            if (!entry.Enabled && !_showOff && !_editing.Contains(entry.Map))
                            {
                                continue;
                            }
                            var scenario = ScenarioOf(entry.Map);
                            bool excluded = Sim.IsExcluded(entry.Map);
                            bool editing = _editing.Contains(entry.Map);
                            bool isNow = live && string.Equals(beat!.Map, entry.Map, StringComparison.OrdinalIgnoreCase);
                            <tr class="@(IsNext(entry.Map) || isNow ? "sain-row-sel" : null) @(entry.Enabled && !excluded ? null : "sain-row-off")">
                                <td style="white-space:nowrap;">
                                    <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward" Size="Size.Small" Disabled="@(index == 0)" OnClick="@(() => Move(index, -1))" />
                                    <MudIconButton Icon="@Icons.Material.Filled.ArrowDownward" Size="Size.Small" Disabled="@(index == Sim.Config.Rotation.Count - 1)" OnClick="@(() => Move(index, 1))" />
                                </td>
                                <td><MudSwitch T="bool" Value="entry.Enabled" ValueChanged="@(v => entry.Enabled = v)" Color="Color.Primary" Disabled="excluded" /></td>
                                <td><b>@SimLabDefaults.DisplayName(entry.Map)</b></td>
                                <td>
                                    <MudNumericField T="float" Value="entry.Minutes" ValueChanged="@(v => entry.Minutes = Math.Max(1f, v))" Min="1" Max="180"
                                                     Variant="Variant.Outlined" Margin="Margin.Dense" HideSpinButtons="true" Adornment="Adornment.End" AdornmentText="@T("분", "min")" />
                                </td>
                                <td>@SimLabDefaults.ScenarioName(scenario)</td>
                                <td class="spt-muted">@PaceText(entry)</td>
                                <td class="spt-muted">@scenario.SideA vs @scenario.SideB</td>
                                <td style="white-space:nowrap;">
                                    @if (excluded)
                                    {
                                        <span class="sain-tagchip sain-tag-r">@T("제외됨", "Excluded")</span>
                                    }
                                    else if (isNow)
                                    {
                                        <span class="sain-tagchip sain-tag-g">@T("진행 중", "Running")</span>
                                    }
                                    else if (IsNext(entry.Map))
                                    {
                                        <span class="sain-tagchip sain-tag-b">@T("다음", "Next")</span>
                                    }
                                    else if (entry.Enabled)
                                    {
                                        <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => MakeNext(entry.Map))">@T("다음으로", "Make next")</MudButton>
                                    }
                                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Info" OnClick="@(() => ToggleEdit(entry.Map))">@T("편집", "Edit") @(editing ? "▴" : "▾")</MudButton>
                                </td>
                            </tr>
                            @if (editing)
                            {
                                <tr>
                                    <td colspan="8" style="background:rgba(24,24,27,0.6);">
                                        <MudStack Spacing="2" Class="pa-2">
                                            @if (Korean)
                                            {
                                                <MudTextField T="string" @bind-Value="scenario.Name" Label="시나리오 이름" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                                <MudTextField T="string" @bind-Value="scenario.Focus" Label="이 맵에서 보는 것" Variant="Variant.Outlined" Margin="Margin.Dense" Lines="2" />
                                            }
                                            else
                                            {
                                                <MudTextField T="string" @bind-Value="scenario.NameEn" Label="Scenario name" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                                <MudTextField T="string" @bind-Value="scenario.FocusEn" Label="What this map tests" Variant="Variant.Outlined" Margin="Margin.Dense" Lines="2" />
                                            }
                                            <MudStack Row Wrap="Wrap.Wrap" Spacing="2">
                                                <MudTextField T="string" @bind-Value="scenario.ZonesA" Label="@T("A쪽 구역 (쉼표, 비우면 맵 전체)", "Side A zones (comma, empty = whole map)")" Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width:280px;" />
                                                <MudSelect T="string" @bind-Value="scenario.SideA" Label="@T("A쪽 진영", "Side A role")" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Style="max-width:160px;">
                                                    @foreach (string role in Roles)
                                                    {
                                                        <MudSelectItem T="string" Value="@role">@role</MudSelectItem>
                                                    }
                                                </MudSelect>
                                                <MudTextField T="string" @bind-Value="scenario.ZonesB" Label="@T("B쪽 구역 (쉼표, 비우면 맵 전체)", "Side B zones (comma, empty = whole map)")" Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width:280px;" />
                                                <MudSelect T="string" @bind-Value="scenario.SideB" Label="@T("B쪽 진영", "Side B role")" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Style="max-width:160px;">
                                                    @foreach (string role in Roles)
                                                    {
                                                        <MudSelectItem T="string" Value="@role">@role</MudSelectItem>
                                                    }
                                                </MudSelect>
                                            </MudStack>
                                            <MudText Typo="Typo.caption" Class="spt-muted">@T("이 맵의 스폰 속도 (0 = 공통 설정 사용). 작은 실내 맵은 빠르게·작은 분대로, 넓은 맵은 천천히.", "Spawn pace on this map (0 = common value). Small indoor maps refill fast with small squads, open maps slower.")</MudText>
                                            <MudStack Row Wrap="Wrap.Wrap" Spacing="2">
                                                <MudNumericField T="int" @bind-Value="entry.MaxAliveBots" Label="@T("동시 최대 봇", "Max alive")" Min="0" Max="40" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:140px;" />
                                                <MudNumericField T="int" @bind-Value="entry.RespawnSeconds" Label="@T("보충 간격(초)", "Refill (s)")" Min="0" Max="600" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:140px;" />
                                                <MudNumericField T="int" @bind-Value="entry.SquadSizeMin" Label="@T("분대 최소", "Squad min")" Min="0" Max="6" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:120px;" />
                                                <MudNumericField T="int" @bind-Value="entry.SquadSizeMax" Label="@T("분대 최대", "Squad max")" Min="0" Max="6" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:120px;" />
                                                <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => SimLabDefaults.ApplyPace(entry))">@T("이 맵 기본 속도", "Map default pace")</MudButton>
                                            </MudStack>
                                            <MudTextField T="string" @bind-Value="scenario.Watch" Label="@T("분석에서 강조할 카운터 접두어 (예: door.,nade.)", "Counter prefixes to highlight in the analysis (e.g. door.,nade.)")" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                            <div>
                                                <MudText Typo="Typo.caption" Class="spt-muted">@T("이 맵의 구역 (괄호 = 보스·봇 스폰 지점 수, 0이면 분대가 안 나올 수 있음). 누르면 A/B에 추가:", "Zones of this map (in brackets: boss/bot spawn points; 0 may spawn nothing). Click to add to A/B:")</MudText>
                                                <MudStack Row Wrap="Wrap.Wrap" Spacing="1" Class="mt-1">
                                                    @foreach (var zone in ZonesOf(entry.Map))
                                                    {
                                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@(zone.Points > 0 ? Color.Default : Color.Error)">
                                                            @zone.Zone (@zone.Points)
                                                            <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => AddZone(scenario, zone.Zone, true))">A</MudButton>
                                                            <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => AddZone(scenario, zone.Zone, false))">B</MudButton>
                                                        </MudChip>
                                                    }
                                                </MudStack>
                                            </div>
                                        </MudStack>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </MudPaper>
    </MudContainer>
</div>

@code {
    private static readonly string[] Roles = ["pmcUSEC", "pmcBEAR", "assault", "pmcBot", "exUsec"];
    private readonly Dictionary<string, List<(string Zone, int Points)>> _zones = new(StringComparer.OrdinalIgnoreCase);
    private readonly HashSet<string> _editing = new(StringComparer.OrdinalIgnoreCase);
    private System.Threading.Timer? _timer;
    private bool _showHelp;
    private bool _showOff;
    private string _group = "basic";

    private sealed record SimGroup(string Id, string Ko, string En, string? NoteKo = null, string? NoteEn = null);

    private sealed record SimToggle(string Group, string Ko, string En, string ShortKo, string ShortEn, string? HelpKo, string? HelpEn,
        Func<bool> Get, Action<bool> Set, Func<string?>? Missing = null, bool Recommended = false);

