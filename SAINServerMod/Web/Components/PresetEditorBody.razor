@namespace SAINServerMod.Web.Components

<MudTabs Elevation="0" PanelClass="pa-4" Color="Color.Transparent" SliderColor="Color.Primary" Border="false" MinimumTabWidth="0">
    @* zzap fork (2026-10-18): quick settings first, then the side-by-side and "changed only" views, the full editors after. *@
    <MudTabPanel Text="@T("빠른 설정", "Quick settings")" Icon="@Icons.Material.Filled.Star">
        <PresetQuickSettings Bundle="Bundle" Original="Original" Zzap="Zzap" References="Columns" OnChanged="OnChanged" />
    </MudTabPanel>
    <MudTabPanel Text="@T("프리셋 비교", "Compare presets")" Icon="@Icons.Material.Outlined.CompareArrows">
        <PresetCompare Bundle="Bundle" CurrentName="@Bundle.Info.Name" Columns="Columns" />
    </MudTabPanel>
    <MudTabPanel Text="@T("바꾼 값", "Changed values")" Icon="@Icons.Material.Outlined.Difference" BadgeData="@(ChangedCount > 0 ? ChangedCount : null)" BadgeColor="Color.Warning">
        <PresetChanges Bundle="Bundle" Original="Original" Zzap="Zzap" OnChanged="OnChanged" />
    </MudTabPanel>
    <MudTabPanel Text="@T("전역 설정 (전체)", "Global settings (all)")" Icon="@Icons.Material.Outlined.Public">
        <SainSectionEditor Target="Bundle.GlobalSettings" Original="Original?.GlobalSettings" OnChanged="OnChanged" />
    </MudTabPanel>
    <MudTabPanel Text="@T("봇 종류별", "Bot types")" Icon="@Icons.Material.Outlined.SmartToy">
        <BotSettingsEditor Bundle="Bundle" Original="Original" Zzap="Zzap" References="Columns" OnChanged="OnChanged" />
    </MudTabPanel>
    <MudTabPanel Text="@T("성격", "Personalities")" Icon="@Icons.Material.Outlined.Psychology">
        <PersonalityEditor Bundle="Bundle" Original="Original" OnChanged="OnChanged" />
    </MudTabPanel>
    <MudTabPanel Text="@T("장비 은밀성", "Gear Stealth")" Icon="@Icons.Material.Outlined.Shield">
        <GearStealthEditor Bundle="Bundle" Original="Original" OnChanged="OnChanged" />
    </MudTabPanel>
    <MudTabPanel Text="@T("정보", "Info")" Icon="@Icons.Material.Outlined.Description">
        <MudStack Spacing="3" Style="max-width:520px;">
            <MudTextField T="string" Value="Bundle.Info.Name" ValueChanged="@(v => SetInfo(v, s => Bundle.Info.Name = s, Bundle.Info.Name))"
                          Label="@T("이름", "Name")" ReadOnly="@(!Bundle.Info.CanEditName)" Variant="Variant.Outlined"
                          Margin="Margin.Dense" Immediate="true" />
            <MudTextField T="string" Value="Bundle.Info.Description" ValueChanged="@(v => SetInfo(v, s => Bundle.Info.Description = s, Bundle.Info.Description))"
                          Label="@T("설명", "Description")" Variant="Variant.Outlined" Margin="Margin.Dense" Lines="2" Immediate="true" />
            <MudTextField T="string" Value="Bundle.Info.Creator" ValueChanged="@(v => SetInfo(v, s => Bundle.Info.Creator = s, Bundle.Info.Creator))"
                          Label="@T("제작자", "Creator")" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
        </MudStack>
    </MudTabPanel>
</MudTabs>

@code {
    [Parameter, EditorRequired] public SAINPresetBundle Bundle { get; set; } = default!;
    [Parameter] public EventCallback OnChanged { get; set; }
    [Parameter] public SAINPresetBundle? Original { get; set; }
    [Parameter] public SAINPresetBundle? Zzap { get; set; }
    [Parameter] public IReadOnlyList<(string Name, SAINPresetBundle Bundle)> Columns { get; set; } = Array.Empty<(string, SAINPresetBundle)>();
    [Parameter] public int ChangedCount { get; set; }

    // Only mark dirty when the text actually changed, the field's initial value event is ignored.
    private Task SetInfo(string value, Action<string> setter, string current)
    {
        if (string.Equals(value, current, StringComparison.Ordinal))
        {
            return Task.CompletedTask;
        }
        setter(value);
        return OnChanged.InvokeAsync();
    }
}
