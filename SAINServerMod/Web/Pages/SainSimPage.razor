            new("spawn", "판마다 보스 1명 무작위", "One random boss per raid", "보스 1명", "random boss", "추종자 포함, 첫 분대 60초 뒤 시뮬 구역에", "With followers, in the sim zone 60 s after the first squads", () => c.RandomBoss, v => c.RandomBoss = v),
            new("spawn", "모드 팩션 웨이브 남기기", "Keep modded faction waves", "모드 팩션 남김", "modded factions kept", "블랙 디비전 등 — 맵 스폰을 지울 때 남김", "Black Division etc. - kept when the map's spawns are cleared", () => c.KeepModdedFactionWaves, v => c.KeepModdedFactionWaves = v),
            new("spawn", "싸움 구역 줄", "Arena leash", "구역 줄", "arena leash", "싸우지 않는 봇이 구역 밖 15초 → 자기 편 구역으로 순간이동", "A bot not fighting outside the arena for 15 s is teleported back to its side's zone", () => c.ArenaLeash, v => c.ArenaLeash = v),

            new("check", "zzap 교차 검증", "zzap cross-check", "zzap 교차 검증", "zzap cross-check", "시뮬 판의 행동 설정(근접전·문 전술·재배치·플레이어 대응·정지 및 매복·분대)을 zzap 프리셋 값으로. 로그 스위치만 시뮬 프리셋 값 유지", "Sim raids use the zzap preset's behaviour values (close combat, doors, reposition, player style, freeze, squad); only the logging switches stay", () => c.ZzapCrossCheck, v => c.ZzapCrossCheck = v),
            new("check", "문 점검", "Door check", "문 점검", "door check", "봇 문 박치기를 조건이 맞으면 항상(100%), 모든 PMC가 기가채드처럼 문 전술 계획(시작 100%). zzap 값 위에 덮어씀. '문 전술·박치기 점검' 시뮬 프리셋이 켬", "Every bot ram whose conditions are met is used (100%) and every PMC plans door tactics like a GigaChad (start 100%), on top of the zzap values. The 'Door tactics & ram check' sim preset turns it on", () => c.DoorTestInSim, v => c.DoorTestInSim = v),

            new("orbit", "ORBIT 고스트 모드 끄기", "ORBIT ghost mode off", "ORBIT 고스트 끔", "ORBIT ghost off", "관전자에서 250m 넘게 떨어진 봇을 재우고 싸움을 주사위로 처리하는 기능", "Sleeps bots > 250 m from the spectator and rolls their fights", () => c.OrbitGhostOff, v => c.OrbitGhostOff = v),
            new("orbit", "ORBIT 탈출 끄기", "ORBIT no extract", "ORBIT 탈출 끔", "ORBIT no extract", "전리품·목표 완료·시간 탈출, 비상 탈출", "Loot / objectives done / timed / emergency", () => c.OrbitNoExtract, v => c.OrbitNoExtract = v),
            new("orbit", "ORBIT PMC 주 목표 끄기", "ORBIT PMC main objectives off", "ORBIT 목표 끔", "ORBIT objectives off", "맵 곳곳 목표를 찾아 떠나는 것", "Leaving to visit objectives across the map", () => c.OrbitNoObjectives, v => c.OrbitNoObjectives = v),
