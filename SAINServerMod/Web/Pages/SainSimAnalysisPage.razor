@page "/sain/sim/analysis"
@attribute [Authorize(Policy = "Administrator")]
@implements IDisposable
@layout BaseMudBlazorLayout
@using SAINServerMod.SimLab
@inject SimLabService Sim
@inject ISnackbar Snackbar

<PageTitle>@T("SAIN 시뮬 분석", "SAIN Sim Analysis")</PageTitle>
<HeadContent>
    <link rel="stylesheet" href="/SAIN/css/sain.css" />
</HeadContent>

<div class="spt-page">
    <MudContainer MaxWidth="MaxWidth.False" Class="sain-container pa-4">
        <SainNav Current="simAnalysis" />
        <MudPaper Elevation="0" Class="spt-panel sain-hero pa-4 mb-4">
            <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap" Spacing="3">
                <MudStack Row AlignItems="AlignItems.Center" Spacing="3">
                    <div class="sain-hero-icon">
                        <MudIcon Icon="@Icons.Material.Filled.Analytics" Color="Color.Warning" Size="Size.Large" />
                    </div>
                    <div>
                        <MudText Typo="Typo.h5" Class="spt-title">@T("시뮬 분석", "Sim Analysis")</MudText>
                        <MudText Typo="Typo.caption" Class="spt-muted">@T("맵마다 무엇이 문제였는지. 게임이 1분마다 보낸 기록이라 강제 종료된 판도 마지막 1분까지 남아 있습니다.", "What went wrong on each map. The game reports every minute, so even a killed game keeps everything up to its last minute.")</MudText>
                    </div>
                </MudStack>
                <MudStack Row Spacing="2" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center">
                    <MudSelect T="string" Value="_runId" ValueChanged="SelectRun" Label="@T("실행", "Run")" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Style="min-width:260px;">
                        @foreach (var r in _runs)
                        {
                            <MudSelectItem T="string" Value="@r.RunId">@r.RunId (@T($"맵 {r.Maps.Count}개", $"{r.Maps.Count} maps"))</MudSelectItem>
                        }
                    </MudSelect>
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh" OnClick="Reload">@T("새로고침", "Refresh")</MudButton>
                    @if (_run != null)
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Warning" StartIcon="@Icons.Material.Filled.Description" OnClick="MakeSummary">@T("Claude용 요약 만들기", "Make summary for Claude")</MudButton>
                        <MudButton Variant="Variant.Text" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete" OnClick="DeleteRun">@T("삭제", "Delete")</MudButton>
                    }
                </MudStack>
            </MudStack>
        </MudPaper>

        @if (_run == null)
        {
            <MudAlert Severity="Severity.Info">@T("아직 기록된 시뮬이 없습니다. 게임에서 시뮬 프리셋으로 레이드를 하면 여기에 쌓입니다.", "No sim recorded yet. Raids played with the sim preset show up here.")</MudAlert>
        }
        else
        {
            @if (_summary != null)
            {
                <MudPaper Elevation="0" Class="spt-panel pa-4 mb-4">
                    <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap">
                        <MudText Typo="Typo.subtitle1" Class="spt-title">@T("Claude용 요약", "Summary for Claude")</MudText>
                        <MudStack Row Spacing="2">
                            <MudButton Href="@SummaryHref" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Download"
                                       UserAttributes="@(new Dictionary<string, object> { ["download"] = $"sim_{_run.RunId}.md" })">@T("md 파일 받기", "Download .md")</MudButton>
                            <MudButton Variant="Variant.Text" OnClick="@(() => _summary = null)">@T("닫기", "Close")</MudButton>
                        </MudStack>
                    </MudStack>
                    <MudText Typo="Typo.caption" Class="spt-muted d-block mb-2">
                        @T("같은 내용이 서버 폴더에도 저장됐습니다:", "Also saved in the server folder:") <code>@_summaryPath</code>. @T("이 파일(또는 아래 글)을 그대로 주시면 전체 로그 없이도 어디를 볼지 바로 압니다.", "Hand over this file (or the text below) and the full logs only need reading where it points.")
                    </MudText>
                    <MudTextField T="string" Value="_summary" ReadOnly="true" Lines="18" Variant="Variant.Outlined" Class="sain-mono" />
                </MudPaper>
            }

            <MudPaper Elevation="0" Class="spt-panel pa-4 mb-4">
                <MudText Typo="Typo.subtitle1" Class="spt-title mb-2">@T("한눈에 보기", "Overview")</MudText>
                <MudSimpleTable Dense="true" Hover="true">
                    <thead>
                        <tr><th>#</th><th>@T("맵", "Map")</th><th>@T("시나리오", "Scenario")</th><th>@T("상태", "Status")</th><th>@T("진행(분)", "Played (min)")</th><th>@T("봇 사망", "Bot deaths")</th><th>@T("최저 fps", "Min fps")</th><th>@T("오류", "Errors")</th><th>@T("문제", "Problems")</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var m in _run.Maps)
                        {
                            var findings = SimLabAnalyzer.Findings(m);
                            <tr>
                                <td>@(m.Index + 1)</td>
                                <td>@SimLabDefaults.DisplayName(m.Map)</td>
                                <td>@ScenarioOf(m)</td>
                                <td><MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@StatusColor(m.Status)">@SimLabAnalyzer.StatusText(m.Status)</MudChip></td>
                                <td>@(SimLabAnalyzer.PlayedMinutes(m).ToString("0.0"))/@(m.PlannedMinutes.ToString("0"))</td>
                                <td>@(m.Last?.BotDeaths ?? 0)</td>
                                <td>@((m.Last?.FpsMin ?? 0f).ToString("0"))</td>
                                <td>@SimLabAnalyzer.ErrorTotal(m)</td>
                                <td>@(findings.Count(f => f.Severity == SimLabAnalyzer.HIGH)) @T("심각", "severe") / @(findings.Count(f => f.Severity == SimLabAnalyzer.WARN)) @T("주의", "warning")</td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            </MudPaper>

            @foreach (var m in _run.Maps.AsEnumerable().Reverse())
            {
                var b = m.Last;
                <MudPaper Elevation="0" Class="spt-panel pa-4 mb-4">
                    <MudStack Row AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap" Class="mb-1">
                        <MudText Typo="Typo.h6" Class="spt-title">@(m.Index + 1). @SimLabDefaults.DisplayName(m.Map) — @ScenarioOf(m)</MudText>
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@StatusColor(m.Status)">@SimLabAnalyzer.StatusText(m.Status)</MudChip>
                    </MudStack>
                    <MudText Typo="Typo.caption" Class="spt-muted d-block">
                        @m.Started.ToString("MM-dd HH:mm") @T("시작", "start") · @(SimLabAnalyzer.PlayedMinutes(m).ToString("0.0"))/@(m.PlannedMinutes.ToString("0"))@T("분", " min") · @T("목적", "Focus"): @FocusOf(m)
                    </MudText>
                    @if (m.Raid != null)
                    {
                        <MudText Typo="Typo.caption" Class="spt-muted d-block">
                            @T("스폰", "Spawns"): A @m.Raid.SideA [@m.Raid.ZonesA] vs B @m.Raid.SideB [@m.Raid.ZonesB] · @T("동시 최대", "max alive") @m.Raid.MaxAliveBots · @T("지운 웨이브", "removed waves") @(m.Raid.RemovedBossWaves)+@(m.Raid.RemovedWaves)
                        </MudText>
                    }
                    <div class="mt-2">
                        @foreach (var f in SimLabAnalyzer.Findings(m))
                        {
                            <MudAlert Severity="@Sev(f.Severity)" Dense="true" Variant="Variant.Outlined" Class="mb-1">
                                <b>@f.Title</b> — @f.Detail
                            </MudAlert>
                        }
                    </div>
                    @if (b != null)
                    {
                        <MudText Typo="Typo.body2" Class="mt-2">
                            @T("본 봇", "Bots seen") @(b.BotsSeen) · @T("봇 사망", "bot deaths") @(b.BotDeaths) (@T("봇에게", "by bots") @(b.BotKillsByBots), @T("기타", "other") @(b.OtherKills), @T("아군", "team") @(b.TeamKills)) · @T("분대 호출", "squads called") @(b.SimWavesActivated) ·
                            @T("마지막", "last") @(b.Fps.ToString("0")) fps / @T("최저", "min") @(b.FpsMin.ToString("0")) · @T("멈춤", "stalls") @(b.Stalls) · @T("관리 메모리", "managed memory") @(b.MonoUsedMB) MB
                        </MudText>
                        @if (!string.IsNullOrEmpty(b.JournalFile))
                        {
                            <MudText Typo="Typo.caption" Class="spt-muted d-block">@T("일지", "Journal"): <code>@b.JournalFile</code></MudText>
                        }
                        <MudExpansionPanels Elevation="0" Class="sain-panels mt-2" MultiExpansion="true">
                            @if (b.Errors?.Count > 0)
                            {
                                <MudExpansionPanel Text="@T($"오류 {b.Errors.Count}종", $"{b.Errors.Count} kinds of errors")" Class="sain-subpanel">
                                    <MudSimpleTable Dense="true">
                                        <thead><tr><th>@T("횟수", "Count")</th><th>@T("종류", "Kind")</th><th>@T("처음(t초)", "First (t s)")</th><th>@T("내용", "Text")</th></tr></thead>
                                        <tbody>
                                            @foreach (var e in b.Errors.OrderByDescending(e => e.Count))
                                            {
                                                <tr>
                                                    <td>@e.Count</td>
                                                    <td>@e.Level / @e.Source</td>
                                                    <td>@e.FirstRaidTime.ToString("0")</td>
                                                    <td><code style="white-space:pre-wrap;">@e.Key@(string.IsNullOrEmpty(e.Sample) ? "" : "\n" + e.Sample)</code></td>
                                                </tr>
                                            }
                                        </tbody>
                                    </MudSimpleTable>
                                </MudExpansionPanel>
                            }
                            <MudExpansionPanel Text="@T($"카운터 {b.Counters?.Count ?? 0}개 (★ = 이 맵에서 볼 것)", $"{b.Counters?.Count ?? 0} counters (★ = watch on this map)")" Class="sain-subpanel">
                                <MudStack Row Wrap="Wrap.Wrap" Spacing="1">
                                    @foreach (var kv in SimLabAnalyzer.OrderedCounters(m))
                                    {
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@(SimLabAnalyzer.IsWatched(m, kv.Key) ? Color.Warning : Color.Default)">
                                            @(SimLabAnalyzer.IsWatched(m, kv.Key) ? "★ " : "")@kv.Key = @kv.Value
                                        </MudChip>
                                    }
                                </MudStack>
                            </MudExpansionPanel>
                            <MudExpansionPanel Text="@T("성격별 · 판단 이유별 킬/사망", "Kills/deaths by personality and decision")" Class="sain-subpanel">
                                <MudStack Row Wrap="Wrap.Wrap" Spacing="4">
                                    @RowTable(T("성격", "Personality"), b.ByPersonality)
                                    @RowTable(T("죽을 때 하던 판단", "Decision when dying"), b.ByReason)
                                    @RowTable(T("전투 행동", "Combat action"), b.ByCombat)
                                </MudStack>
                            </MudExpansionPanel>
                            @if (b.SpawnedRoles?.Count > 0)
                            {
                                <MudExpansionPanel Text="@T("등장한 봇 역할", "Bot roles seen")" Class="sain-subpanel">
                                    @string.Join(", ", b.SpawnedRoles.Select(kv => $"{kv.Key} ×{kv.Value}"))
                                </MudExpansionPanel>
                            }
                            @if (m.Samples.Count > 0)
                            {
                                <MudExpansionPanel Text="@T($"시간대별 기록 {m.Samples.Count}개", $"{m.Samples.Count} timeline samples")" Class="sain-subpanel">
                                    <MudSimpleTable Dense="true">
                                        <thead><tr><th>@T("t(분)", "t (min)")</th><th>@T("생존 봇", "Alive")</th><th>@T("누적 사망", "Deaths")</th><th>fps</th><th>@T("메모리 MB", "Memory MB")</th><th>@T("누적 오류", "Errors")</th></tr></thead>
                                        <tbody>
                                            @foreach (var s in m.Samples)
                                            {
                                                <tr><td>@((s.T / 60f).ToString("0.0"))</td><td>@s.Alive</td><td>@s.Deaths</td><td>@s.Fps.ToString("0")</td><td>@s.Mono</td><td>@s.Errors</td></tr>
                                            }
                                        </tbody>
                                    </MudSimpleTable>
                                </MudExpansionPanel>
                            }
                            @if (b.Notes?.Count > 0)
                            {
                                <MudExpansionPanel Text="@T("메모", "Notes")" Class="sain-subpanel">
                                    @foreach (string n in b.Notes)
                                    {
                                        <MudText Typo="Typo.body2">• @n</MudText>
                                    }
                                </MudExpansionPanel>
                            }
                        </MudExpansionPanels>
                    }
                </MudPaper>
            }
        }
    </MudContainer>
</div>

@code {
    private List<SimRunRecord> _runs = [];
    private string? _runId;
    private SimRunRecord? _run;
    private string? _summary;
    private string? _summaryPath;
    private System.Threading.Timer? _timer;

    private string SummaryHref => "data:text/markdown;charset=utf-8;base64," + Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(_summary ?? string.Empty));

    protected override void OnInitialized()
    {
        Reload();
        // A running sim keeps reporting: refresh the shown run every 30 s.
        _timer = new System.Threading.Timer(_ => InvokeAsync(() =>
        {
            if (_run != null && _run.Maps.LastOrDefault()?.Status == "running")
            {
                _run = Sim.LoadRun(_run.RunId) ?? _run;
                StateHasChanged();
            }
        }), null, 30000, 30000);
    }

    public void Dispose()
    {
        _timer?.Dispose();
    }

    private void Reload()
    {
        _runs = Sim.ListRuns();
        if (_runId == null || !_runs.Any(r => r.RunId == _runId))
        {
            _runId = _runs.FirstOrDefault()?.RunId;
        }
        _run = _runId == null ? null : _runs.FirstOrDefault(r => r.RunId == _runId);
    }

    private void SelectRun(string runId)
    {
        _runId = runId;
        _summary = null;
        _run = _runs.FirstOrDefault(r => r.RunId == runId);
    }

    private void MakeSummary()
    {
        if (_run == null)
        {
            return;
        }
        _summary = SimLabAnalyzer.Markdown(_run);
        try
        {
            _summaryPath = Path.Combine(Sim.RunsDir, $"{JsonFileStoreUtilName(_run.RunId)}.summary.md");
            File.WriteAllText(_summaryPath, _summary);
        }
        catch (Exception ex)
        {
            _summaryPath = T("(저장 실패: ", "(save failed: ") + ex.Message + ")";
        }
    }

    private string ScenarioOf(SimMapRecord m)
    {
        if (!Korean && Sim.Config.Scenarios.TryGetValue(m.Map, out SimScenario? scenario) && scenario != null && scenario.Name == m.Scenario && !string.IsNullOrEmpty(scenario.NameEn))
        {
            return scenario.NameEn;
        }
        return m.Scenario;
    }

    /// <summary>The map's test focus in the page language (records keep the Korean text they were made with).</summary>
    private string FocusOf(SimMapRecord m)
    {
        if (!Korean && Sim.Config.Scenarios.TryGetValue(m.Map, out SimScenario? scenario) && scenario != null && scenario.Focus == m.Focus && !string.IsNullOrEmpty(scenario.FocusEn))
        {
            return scenario.FocusEn;
        }
        return m.Focus;
    }

    private static string JsonFileStoreUtilName(string name)
    {
        return SAINServerMod.Utils.JsonFileStoreUtil.SanitizeFileName(name);
    }

    private void DeleteRun()
    {
        if (_run == null)
        {
            return;
        }
        Sim.DeleteRun(_run.RunId);
        Snackbar.Add(T($"실행 {_run.RunId} 기록을 지웠습니다.", $"Deleted run {_run.RunId}."), Severity.Warning);
        _runId = null;
        _summary = null;
        Reload();
    }

    private static Color StatusColor(string status)
    {
        return status switch
        {
            "done" => Color.Success,
            "running" => Color.Info,
            "interrupted" => Color.Error,
            _ => Color.Warning,
        };
    }

    private static Severity Sev(string severity)
    {
        return severity switch
        {
            SimLabAnalyzer.HIGH => Severity.Error,
            SimLabAnalyzer.WARN => Severity.Warning,
            SimLabAnalyzer.OK => Severity.Success,
            _ => Severity.Info,
        };
    }

    private static RenderFragment RowTable(string title, Dictionary<string, SAIN.Preset.Shared.SimLab.SimRow>? rows) => __builder =>
    {
        if (rows == null || rows.Count == 0)
        {
            return;
        }
        <div>
            <MudText Typo="Typo.overline" Class="spt-muted">@title</MudText>
            <MudSimpleTable Dense="true">
                <thead><tr><th>@T("이름", "Name")</th><th>@T("킬", "Kills")</th><th>@T("사망", "Deaths")</th><th>@T("전환 직후 사망", "Died switching")</th></tr></thead>
                <tbody>
                    @foreach (var kv in rows.OrderByDescending(x => x.Value.Kills + x.Value.Deaths).Take(15))
                    {
                        <tr><td>@kv.Key</td><td>@kv.Value.Kills</td><td>@kv.Value.Deaths</td><td>@kv.Value.DiedSwitching</td></tr>
                    }
                </tbody>
            </MudSimpleTable>
        </div>
    };
}
