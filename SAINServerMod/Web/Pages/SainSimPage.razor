    public void Dispose()
    {
        _timer?.Dispose();
    }

    private string GroupNote(SimGroup g)
    {
        if (g.NoteKo == "ORBIT_FOUND")
        {
            return Sim.OrbitFound
                ? T("ORBIT 설치됨. 시뮬 레이드에만 ORBIT에 보내는 설정을 바꿉니다(ORBIT 파일은 안 바뀜).", "ORBIT found. Changes only what ORBIT receives in sim raids (ORBIT's files are untouched).")
                : T("ORBIT이 설치되어 있지 않아 이 항목들은 아무 효과가 없습니다.", "ORBIT isn't installed; these do nothing.");
        }
        return T(g.NoteKo!, g.NoteEn ?? g.NoteKo!);
    }

    private string StatusLine()
    {
        if (Sim.Running)
        {
            return T($"● 순회 진행 중 ({Sim.MapsDone}맵 끝남)", $"● Rotation running ({Sim.MapsDone} maps done)");
        }
        if (Sim.CycleCompleted)
        {
            return T($"완료 ({Sim.MapsDone}맵 한 바퀴) — 다시 누르면 새 실행", $"Complete ({Sim.MapsDone} maps) - start again for a new run");
        }
        return Sim.FreshRunOnStart
            ? T("대기 — '시뮬 시작'을 누르면 새 실행으로 처음 맵부터", "Waiting — 'Start sim' begins a new run from the first map")
            : T("대기 — '시뮬 시작'을 눌러야 시작", "Waiting — press 'Start sim'");
    }

    private static string PresetName(SimPreset p)
    {
        return !Korean && !string.IsNullOrEmpty(p.NameEn) ? p.NameEn : p.Name;
    }

    private static string PresetPurpose(SimPreset p)
    {
        return !Korean && !string.IsNullOrEmpty(p.PurposeEn) ? p.PurposeEn : p.Purpose;
    }

    private static string Short(string text, int max)
    {
        return text.Length <= max ? text : text[..max] + "…";
    }

    private void ToggleEdit(string map)
    {
        if (!_editing.Remove(map))
        {
            _editing.Add(map);
        }
    }

    private string PaceText(SimMapEntry e)
    {
        int cap = e.MaxAliveBots > 0 ? e.MaxAliveBots : Sim.Config.MaxAliveBots;
        int respawn = e.RespawnSeconds > 0 ? e.RespawnSeconds : Sim.Config.RespawnSeconds;
        int min = e.SquadSizeMin > 0 ? e.SquadSizeMin : Sim.Config.SquadSizeMin;
        int max = e.SquadSizeMax > 0 ? e.SquadSizeMax : Sim.Config.SquadSizeMax;
        return T($"최대 {cap} · {respawn}초 · 분대 {min}~{max}", $"max {cap} · {respawn}s · squad {min}-{max}");
    }

    private SimScenario ScenarioOf(string map)
    {
        if (!Sim.Config.Scenarios.TryGetValue(map, out SimScenario? scenario) || scenario == null)
        {
            scenario = Sim.ScenarioFor(map);
            Sim.Config.Scenarios[map] = scenario;
        }
        return scenario;
    }

    private List<(string Zone, int Points)> ZonesOf(string map)
    {
        if (!_zones.TryGetValue(map, out var list))
        {
            list = Sim.ZonesOf(map);
            _zones[map] = list;
        }
        return list;
    }

    private static void AddZone(SimScenario scenario, string zone, bool sideA)
    {
        string current = sideA ? scenario.ZonesA : scenario.ZonesB;
        var parts = (current ?? string.Empty).Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();
        if (!parts.Contains(zone))
        {
            parts.Add(zone);
        }
        if (sideA)
        {
            scenario.ZonesA = string.Join(",", parts);
        }
        else
        {
            scenario.ZonesB = string.Join(",", parts);
        }
    }

    private bool IsNext(string map)
    {
        return string.Equals(Sim.Plan().NextMap, map, StringComparison.OrdinalIgnoreCase);
    }

    private void MakeNext(string map)
    {
        Sim.SaveConfig();
        int index = Sim.EnabledRotation().FindIndex(x => string.Equals(x.Map, map, StringComparison.OrdinalIgnoreCase));
        if (index >= 0)
        {
            Sim.SetStep(index);
            Snackbar.Add(T($"다음 맵: {SimLabDefaults.DisplayName(map)}", $"Next map: {SimLabDefaults.DisplayName(map)}"), Severity.Info);
        }
    }

    private void Move(int index, int delta)
    {
        int target = index + delta;
        var list = Sim.Config.Rotation;
        if (target < 0 || target >= list.Count)
        {
            return;
        }
        (list[index], list[target]) = (list[target], list[index]);
    }

    private void SetExcluded(string value)
    {
        Sim.Config.ExcludedMapKeywords = (value ?? string.Empty)
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .ToList();
    }

    private void ToggleRunning()
    {
        Sim.SaveConfig();
        Sim.SetRunning(!Sim.Running);
        Snackbar.Add(Sim.Running
            ? T("시뮬을 시작합니다. 게임이 메인 메뉴에 있으면 10초 안에 카운트다운이 시작됩니다.", "Sim started. If the game is in the main menu, the countdown starts within 10 s.")
            : T("시뮬을 멈췄습니다. 지금 레이드는 끝까지 진행되고, 메뉴에서 다음 맵을 시작하지 않습니다.", "Sim stopped. The current raid plays to its end; the menu will not start the next map."), Severity.Info);
    }

    private void NewRun()
    {
        Sim.SaveConfig();
        string id = Sim.NewRun();
        Snackbar.Add(T($"새 실행 {id} — 순서 처음부터 시작합니다.", $"New run {id} — starting from the top of the list."), Severity.Success);
    }

    private string _saveName = string.Empty;
    private string _savePurpose = string.Empty;

    private string PersonalityText(string? spec)
    {
        if (string.IsNullOrWhiteSpace(spec))
        {
            return T("SAIN 기본 성격", "SAIN default personalities");
        }
        return string.Equals(spec.Trim(), "even", StringComparison.OrdinalIgnoreCase) ? T("8가지 고르게", "8 kinds evenly") : spec;
    }

    private void ApplyPreset(string name)
    {
        if (Sim.Running)
        {
            return;
        }
        if (Sim.ApplyPreset(name))
        {
            var p = Sim.FindPreset(name);
            string shown = p == null ? name : PresetName(p);
            Snackbar.Add(T($"'{shown}' 적용 — 다음 시작부터 첫 맵부터 돕니다.", $"'{shown}' applied - the next start begins at its first map."), Severity.Success);
        }
    }

    private void DeletePreset(string name)
    {
        if (Sim.DeletePreset(name))
        {
            Snackbar.Add(T($"'{name}' 삭제", $"'{name}' deleted"), Severity.Warning);
        }
    }

    private void SavePreset()
    {
        string? error = Sim.SaveAsPreset(_saveName, _savePurpose);
        if (error != null)
        {
            Snackbar.Add(error, Severity.Error);
            return;
        }
        Snackbar.Add(T($"'{_saveName.Trim()}' 저장", $"'{_saveName.Trim()}' saved"), Severity.Success);
        _saveName = string.Empty;
        _savePurpose = string.Empty;
    }

    private void Save()
    {
        Sim.SaveConfig();
        Snackbar.Add(T("시뮬 설정을 저장했습니다. 다음 레이드부터 적용됩니다.", "Sim settings saved. They apply from the next raid."), Severity.Success);
    }

    private void ResetDefaults()
    {
        Sim.ResetDefaults();
        _zones.Clear();
        Snackbar.Add(T("순서·시나리오를 기본값으로 되돌렸습니다.", "Order and scenarios reset to defaults."), Severity.Warning);
    }
}
