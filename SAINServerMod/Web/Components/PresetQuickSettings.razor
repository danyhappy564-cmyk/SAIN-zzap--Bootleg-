@namespace SAINServerMod.Web.Components

@* zzap fork (2026-10-18): the values people change most, one screen. Same list as the F6 editor (SAIN.Preset.Shared QuickSettings). *@
@{
    var view = SainPresetEditService.View(Bundle);
    var zzap = Zzap == null ? null : SainPresetEditService.View(Zzap);
    var original = Original == null ? null : SainPresetEditService.View(Original);
    var reference = ReferenceView(original, zzap);
    int lowCount = QuickSettings.LowSpecCount(view);
    int lowTotal = QuickSettings.LowSpec.Length;
}

<MudAlert Severity="Severity.Info" Dense="true" Variant="Variant.Outlined" Class="mb-3">
    @T("자주 만지는 값만 모았습니다. 슬라이더는 모두 오른쪽으로 갈수록 봇이 강해집니다. 노란 선 = 비교 기준, 그 사이 색 막대 = 기준과의 차이, 아래 글씨 = 지금 값의 뜻. 더 자세한 값은 '전역 설정 (전체)' 탭.",
       "The values changed most often. Every slider makes bots stronger to the right. Yellow line = the reference, the coloured stretch = the difference, the line below = what the value means. Everything else is on 'Global settings (all)'.")
</MudAlert>

<div class="sain-lowspec @(lowCount == lowTotal ? "sain-lowspec-on" : null)">
    <div class="sain-lowspec-head">
        <div>
            <MudText Typo="Typo.subtitle2" Class="spt-title">@T("저사양 PC — 한 번에 맞추기", "Low-spec PC — one switch")</MudText>
            <MudText Typo="Typo.caption" Class="spt-muted">@T("난이도는 그대로 두고 프레임을 잡아먹는 계산만 줄입니다. 아무 난이도에나 켤 수 있습니다.", "Keeps the difficulty, only cuts the costly calculations. Works on any difficulty.")</MudText>
        </div>
        <div class="sain-lowspec-ctl">
            <MudSwitch T="bool" Value="@(lowCount == lowTotal)" ValueChanged="SetLowSpec" Color="Color.Info" />
            <MudText Typo="Typo.caption" Class="@(lowCount > 0 ? "sain-blue" : "spt-muted")">
                @(lowCount == lowTotal ? T("켬", "On") : lowCount == 0 ? T("끔", "Off") : T("일부", "Partly")) (@T($"{lowTotal}개 중 {lowCount}개", $"{lowCount} of {lowTotal}"))
            </MudText>
        </div>
    </div>
    <div class="sain-lowspec-items">
        @foreach (var item in QuickSettings.LowSpec)
        {
            bool on = item.IsLowSpec(view);
            <span class="@(on ? "sain-lowspec-item-on" : "spt-muted")">@(on ? "✓" : "·") @item.Name(Korean)</span>
        }
    </div>
</div>

<div class="sain-refbar">
    <span class="sain-refbar-label">@T("비교 기준", "Compare with")</span>
    @foreach (var name in ReferenceNames())
    {
        var n = name;
        <button type="button" class="sain-refchip @(_reference == n ? "on" : null)" @onclick="() => _reference = n"
                title="@(n == Saved ? T("열었을(저장된) 상태와 비교 — 바꾼 것만 막대로", "Compare with the state it was opened in - only your changes show as bars") : T("이 프리셋 값과 비교", "Compare with this preset's values"))">@RefLabel(n)</button>
    }
    <span class="sain-refbar-legend">
        <span class="sw tick"></span>@T("기준 위치", "reference")
        <span class="sw up"></span>@T("기준보다 봇 강함 = 어려워짐", "bots stronger = harder")
        <span class="sw down"></span>@T("봇 약함 = 쉬워짐", "bots weaker = easier")
    </span>
</div>

<div class="sain-quick-grid">
    @foreach (string group in QuickSettings.Groups)
    {
        <div class="sain-quick-card">
            <div class="sain-quick-head">
                <MudText Typo="Typo.subtitle2" Class="spt-title">@QuickSettings.GroupName(group, Korean)</MudText>
                @if (group != "log")
                {
                    <span class="sain-quick-dir">@T("← 봇 약하게 · 강하게 →", "← weaker bots · stronger →")</span>
                }
            </div>
            @foreach (var q in QuickSettings.All.Where(x => x.Group == group))
            {
                float value = q.Get(view);
                float? orig = original == null ? null : q.Get(original);
                bool changed = orig.HasValue && Math.Abs(orig.Value - value) > 0.0001f;
                @if (q.Kind == QuickKind.Toggle)
                {
                    <div class="sain-quick-toggle">
                        <div>
                            <MudText Typo="Typo.body2">@q.Name(Korean) @if (changed) { <span class="sain-diff">● @T("바꿈", "changed")</span> }</MudText>
                            <MudText Typo="Typo.caption" Class="spt-muted">@q.Help(Korean)</MudText>
                        </div>
                        <div class="sain-qtoggle-right">
                            @if (reference != null)
                            {
                                bool refOn = q.Get(reference) >= 0.5f;
                                <span class="sain-qref">@(refOn == (value >= 0.5f) ? RefLabel(_reference) + T("과 같음", ": same") : RefLabel(_reference) + " " + (refOn ? T("켬", "on") : T("끔", "off")) + " →")</span>
                            }
                            <MudSwitch T="bool" Value="@(value >= 0.5f)" ValueChanged="@(v => Set(q, v ? 1f : 0f))" Color="Color.Primary" />
                        </div>
                    </div>
                }
                else
                {
                    float refValue = reference == null ? q.ZzapValue : q.Get(reference);
                    int direction = q.Direction(value, refValue);
                    double valuePos = Pct(q, q.ToSlider(value));
                    double refPos = Pct(q, q.ToSlider(refValue));
                    <div class="sain-qrow">
                        <div class="sain-qrow-top">
                            <MudTooltip Text="@q.Help(Korean)" Arrow="true" Placement="Placement.Top">
                                <span class="sain-qrow-name">@q.Name(Korean)</span>
                                @if (changed) { <span class="sain-diff">● @T("바꿈", "changed")</span> }
                            </MudTooltip>
                            <span class="sain-qrow-delta">
                                <span class="ref">@RefLabel(_reference) @q.Format(refValue, Korean)</span> → <b>@q.Format(value, Korean)</b>
                                <span class="dir @(direction > 0 ? "up" : direction < 0 ? "down" : "same")">@q.DeltaText(value, refValue, Korean)</span>
                            </span>
                            <MudNumericField T="double" Value="Math.Round(value, 3)" ValueChanged="@(v => Set(q, (float)v))" Min="q.Min" Max="q.Max" Step="q.Step"
                                             Variant="Variant.Outlined" Margin="Margin.Dense" Class="sain-num" HideSpinButtons="true" />
                            <div class="sain-qrow-reset">
                                @if (changed)
                                {
                                    <MudTooltip Text="@T($"원래 값 {Fmt(orig!.Value)}(으)로", $"Back to {Fmt(orig!.Value)}")">
                                        <MudIconButton Icon="@Icons.Material.Outlined.RestartAlt" Size="Size.Small" Color="Color.Warning" OnClick="@(() => Set(q, orig!.Value))" />
                                    </MudTooltip>
                                }
                            </div>
                        </div>
                        <div class="sain-quick-slider sain-diffslider">
                            <div class="sain-dl">
                                <span class="t"></span>
                                <span class="b" style="width:@(Math.Min(valuePos, refPos).ToString(System.Globalization.CultureInfo.InvariantCulture))%"></span>
                                @if (direction != 0)
                                {
                                    <span class="d @(direction > 0 ? "up" : "down")" style="left:@(Math.Min(valuePos, refPos).ToString(System.Globalization.CultureInfo.InvariantCulture))%;width:@(Math.Abs(valuePos - refPos).ToString(System.Globalization.CultureInfo.InvariantCulture))%"></span>
                                }
                                <span class="r" style="left:@(refPos.ToString(System.Globalization.CultureInfo.InvariantCulture))%" title="@(RefLabel(_reference) + " " + q.Format(refValue, Korean))"></span>
                            </div>
                            <MudSlider T="double" Min="q.Min" Max="q.Max" Step="q.Step" Value="Math.Round(q.ToSlider(value), 3)" ValueChanged="@(v => Set(q, q.Round(q.FromSlider((float)v))))" Color="Color.Default" Immediate="true" />
                        </div>
                        <div class="sain-quick-desc">@q.Text(value, Korean)</div>
                    </div>
                }
            }
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public SAINPresetBundle Bundle { get; set; } = default!;
    /// <summary>The preset as it was opened (yellow "changed" marks and the reset arrow).</summary>
    [Parameter] public SAINPresetBundle? Original { get; set; }
    /// <summary>The bundled zzap preset (yellow ticks).</summary>
    [Parameter] public SAINPresetBundle? Zzap { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }
    /// <summary>The bundled zzap presets (comparison reference choices).</summary>
    [Parameter] public IReadOnlyList<(string Name, SAINPresetBundle Bundle)> References { get; set; } = Array.Empty<(string, SAINPresetBundle)>();

    // zzap fork (2026-10-18, mockup 7 adopted for F6 and the web): compare every value with a reference - zzap, easy, normal
    // or the state the preset was opened in - as "reference -> now" text and a red (stronger) / green (weaker) stretch.
    private const string Saved = "";
    private static readonly string[] ReferenceOrder = { "zzap", "zzap 쉬움", "zzap 보통", Saved };
    private string _reference = "zzap";

    private IEnumerable<string> ReferenceNames()
    {
        foreach (var name in ReferenceOrder)
        {
            if (name == Saved ? Original != null : name == "zzap" ? Zzap != null || References.Any(r => r.Name == name) : References.Any(r => r.Name == name))
            {
                yield return name;
            }
        }
    }

    private QuickPresetView? ReferenceView(QuickPresetView? original, QuickPresetView? zzap)
    {
        if (_reference == Saved)
        {
            return original;
        }
        if (_reference == "zzap" && zzap != null)
        {
            return zzap;
        }
        var match = References.FirstOrDefault(r => r.Name == _reference);
        return match.Bundle != null ? SainPresetEditService.View(match.Bundle) : zzap;
    }

    private static string RefLabel(string name)
    {
        return name switch
        {
            Saved => T("저장된 값", "Saved"),
            "zzap 쉬움" => T("쉬움", "Easy"),
            "zzap 보통" => T("보통", "Normal"),
            _ => name,
        };
    }

    private static double Pct(QuickSetting q, float value)
    {
        return Math.Round(Math.Clamp((value - q.Min) / Math.Max(0.0001f, q.Max - q.Min), 0f, 1f) * 100f, 2);
    }

    private static string Fmt(float value)
    {
        return Math.Round(value, 2).ToString("0.##");
    }

    private Task Set(QuickSetting q, float value)
    {
        var view = SainPresetEditService.View(Bundle);
        value = Math.Clamp(value, q.Min, q.Max);
        if (Math.Abs(q.Get(view) - value) < 0.0001f)
        {
            return Task.CompletedTask;
        }
        q.Set(view, value);
        return OnChanged.InvokeAsync();
    }

    private Task SetLowSpec(bool on)
    {
        var view = SainPresetEditService.View(Bundle);
        if (on)
        {
            QuickSettings.ApplyLowSpec(view);
        }
        else
        {
            QuickSettings.RestoreLowSpec(view, Original == null ? null : SainPresetEditService.View(Original));
        }
        return OnChanged.InvokeAsync();
    }
}
